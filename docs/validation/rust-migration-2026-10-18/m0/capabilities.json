    ".psd1": "powershell"
  },
  "dependencies": [
    "tree-sitter>=0.25.2,<0.26",
    "tree-sitter-python>=0.23",
    "tree-sitter-rust>=0.23",
    "tree-sitter-javascript>=0.23",
    "tree-sitter-typescript>=0.23",
    "tree-sitter-go>=0.23",
    "tree-sitter-java>=0.23",
    "tree-sitter-language-pack>=1.8",
    "pathspec>=0.12",
    "watchfiles>=0.22",
    "fastembed>=0.5",
    "numpy>=1.26",
    "model2vec==0.9.0",
    "tokenizers==0.22.2",
    "huggingface-hub>=0.36.2,<1",
    "onnx==1.20.1",
    "ctranslate2==4.8.2",
    "sentencepiece==0.2.1",
    "snowballstemmer==3.0.1",
    "flatbuffers>=25.12.19",
    "mcp>=2.0,<3",
    "regex>=2024.11.6"
  ],
  "optional_backends": {
    "gpu": [
      "fastembed-gpu>=0.5; sys_platform != 'darwin'"
    ],
    "torch": [
      "sentence-transformers>=3.0",
      "transformers>=4.51",
      "torch>=2.9; sys_platform == 'darwin' and platform_machine == 'arm64'"
    ],
    "retrieval-mlx": [
      "mlx==0.32.3; sys_platform == 'darwin' and platform_machine == 'arm64'",
      "mlx-lm==0.28.4; sys_platform == 'darwin' and platform_machine == 'arm64'",
      "transformers==4.57.6",
      "huggingface-hub>=0.36.2,<1"
    ]
  },
  "hosts": [
    "Claude Code",
    "Codex",
    "OpenCode",
    "DeepSeek Harness"
  ],
  "hooks": [
    "session-start",
    "session-end",
    "user-prompt",
    "tool-call",
    "stop"
  ],
  "formats": [
    ".ken/meta.json",
    "SQLite schema.sql and additive migrations",
    "inline float32 vectors",
    "slotted vectors",
    "versioned structural store and syntax flatbuffers",
    "KQL1 TOML selectors",
    "KQL2 saved modules and QuerySession",
    "model profile fingerprints",
    "justified memory and source hashes"
  ],
  "platforms": {
    "minimum_ci": [
      "Linux",
      "macOS"
    ],
    "Windows": "Optional inference wheels advertised; whole-app support not certified by current CI."
  },
  "model_policy": "Preserve per-project model, dimensions, tokenizer, prompts and pins; no inference or downloads in M1.",
  "resource_policy": "source-owners includes every bundled resource; copied oracle contains their bytes; runtime/cache stores not copied."
}
