{
  "scope": "inventory only; native parity pending",
  "entrypoints": [
    "ken CLI",
    "ken mcp stdio",
    "ken tools passthrough"
  ],
  "python_api_candidates": [
    {
      "path": "src/ken/checks/store.py",
      "symbol": "Store",
      "public_methods": [
        "path",
        "read",
        "rules",
        "write",
        "lock",
        "save_rule"
      ]
    },
    {
      "path": "src/ken/structural_store/store.py",
      "symbol": "Store",
      "public_methods": [
        "close",
        "allocated_bytes",
        "transaction",
        "find_unit",
        "load_unit",
        "put_unit",
        "current",
        "publish",
        "scan",
        "scan_sql",
        "properties"
      ]
    },
    {
      "path": "src/ken/kql2/session.py",
      "symbol": "QuerySession",
      "public_methods": [
        "invalidate",
        "refresh",
        "search",
        "search_json",
        "prepare_graph",
        "resolve_query",
        "prepare_query",
        "prepare_semantics",
        "maintain",
        "close"
      ]
    }
  ],
  "python_api_evidence": [
    "docs/reference.md",
    "docs/design/kql2/README.md",
    "docs/superpowers/plans/2026-10-14-kql2-query-session.md"
  ],
  "external_python_consumers": "not exhaustively knowable; keep original APIs and files",
  "extensions": {
    ".c": "c",
    ".h": "c",
    ".cpp": "cpp",
    ".cc": "cpp",
    ".cxx": "cpp",
    ".hpp": "cpp",
    ".hh": "cpp",
    ".hxx": "cpp",
    ".ipp": "cpp",
    ".cs": "csharp",
    ".csx": "csharp",
    ".css": "css",
    ".html": "html",
    ".htm": "html",
    ".vue": "html",
    ".svelte": "html",
    ".py": "python",
    ".pyi": "python",
    ".rs": "rust",
    ".rb": "ruby",
    ".rake": "ruby",
    ".gemspec": "ruby",
    ".js": "javascript",
    ".jsx": "javascript",
    ".mjs": "javascript",
    ".cjs": "javascript",
    ".ts": "typescript",
    ".tsx": "typescript",
    ".go": "go",
    ".java": "java",
