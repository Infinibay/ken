s/test_cli_reinstall.py\nA  tests/test_codeflow_tools.py\nA  tests/test_codex_hooks_template.py\nA  tests/test_daemon_helpers.py\nA  tests/test_daemon_http_resilience.py\nA  tests/test_daemon_rank_mcp.py\nA  tests/test_daemon_state.py\nA  tests/test_db.py\nA  tests/test_doc_intent_integration.py\nA  tests/test_embedder_device.py\nA  tests/test_embedder_model.py\nA  tests/test_embedding_spaces.py\nA  tests/test_findings_graph.py\nA  tests/test_gitignore_filter.py\nA  tests/test_hook.py\nA  tests/test_hooks_template.py\nA  tests/test_index_queue.py\nA  tests/test_indexer.py\nA  tests/test_install_codex.py\nA  tests/test_install_opencode.py\nA  tests/test_mcp_schema.py\nA  tests/test_mcp_startup.py\nA  tests/test_nametokens.py\nA  tests/test_paths.py\nA  tests/test_reembed.py\nA  tests/test_search_cli.py\nA  tests/test_session_brief.py\nA  tests/test_static_head.py\nA  tests/test_status.py\nA  tests/test_stochastic_tools.py\nA  tests/test_tools_cli.py\nA  tests/test_vectors.py\nA  tests/test_vectors_daemon.py\nA  tests/test_watcher.py\nA  uv.lock\n\"\"\"Project-root discovery + canonical paths inside `.ken/`.\n\nA \"ken project\" is any directory that contains a `.ken/meta.json`. We\nfollow git's pattern: walk up from the caller's cwd until we find one,\notherwise return None.\n\nThe hook commands (`ken hook session-start`, etc.) call\n`find_project_root()` first thing so they know which DB to write to.\nThe CLI's `install` / `serve` / `status` accept an explicit path\nargument that takes precedence.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\nKEN_DIR_NAME = \".ken\"\nMETA_FILENAME = \"meta.json\"\nDB_FILENAME = \"ken.db\"\nPID_FILENAME = \"daemon.pid\"\nSOCKET_FILENAME = \"daemon.sock\"\nPORT_FILENAME = \"daemon.port\"\nLOG_FILENAME = \"daemon.log\"\n\n\ndef ken_dir(project_root: Path) -> Path:\n    return project_root / KEN_DIR_NAME\n\n\ndef meta_path(project_root: Path) -> Path:\n    return ken_dir(project_root) / META_FILENAME\n\n\ndef db_path(project_root: Path) -> Path:\n    return ken_dir(project_root) / DB_FILENAME\n\n\ndef pid_path(project_root: Path) -> Path:\n    return ken_dir(project_root) / PID_FILENAME\n\n\ndef port_path(project_root: Path) -> Path:\n    return ken_dir(project_root) / PORT_FILENAME\n\n\ndef log_path(project_root: Path) -> Path:\n    return ken_dir(project_root) / LOG_FILENAME\n\n\ndef resolve_project_path(project_root: Path, path: str | Path) -> Path:\n    \"\"\"Resolve *path* and require it to remain inside *project_root*.\n\n    Relative paths are interpreted from the project root. Absolute paths are\n    accepted when they point inside it. Resolving both sides before the\n    containment check also rejects ``..`` traversal and escapes through\n    existing symbolic links.\n    \"\"\"\n    root = project_root.expanduser().resolve()\n    supplied = Path(path).expanduser()\n    resolved = (supplied if supplied.is_absolute() else root / supplied).resolve()\n    try:\n        resolved.relative_to(root)\n    except ValueError as err:\n        raise ValueError(f\"path escapes project root: {path}\") from err\n    return resolved\n\n\ndef find_project_root(start: Path | None = None) -> Path | None:\n    \"\"\"Walk up from *start* (default cwd) looking for `.ken/meta.json`.\n\n    Returns the directory that contains `.ken/`, not the `.ken/` itself.\n    `KEN_PROJECT_ROOT` env var overrides discovery — useful for tests\n    and for hooks invoked with a wonky cwd.\n    \"\"\"\n    forced = os.environ.get(\"KEN_PROJECT_ROOT\")\n    if forced:\n        p = Path(forced).expanduser().resolve()\n        return p if meta_path(p).is_file() else None\n\n    cur = (start or Path.cwd()).resolve()\n    for parent in [cur, *cur.parents]:\n        if meta_path(parent).is_file():\n            return parent\n    return None\n\"\"\"Project root discovery + path helpers.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\nimport pytest\n\nfrom ken import _paths\n\n\ndef test_find_project_root_walks_up(tmp_path):\n    root = tmp_path / \"proj\"\n    (root / \".ken\").mkdir(parents=True)\n    (root / \".ken\" / \"meta.json\").write_text(\"{}\")\n    nested = root / \"a\" / \"b\" / \"c\"\n    nested.mkdir(parents=True)\n    found = _paths.find_project_root(start=nested)\n    assert found is not None\n    assert found.resolve() == root.resolve()\n\n\ndef test_find_project_root_returns_none_when_missing(tmp_path):\n    \"\"\"Plain temp dir with no .ken/ above it → None.\"\"\"\n    # Save & restore env to avoid bleeding into other tests.\n    saved = os.environ.pop(\"KEN_PROJECT_ROOT\", None)\n    try:\n        # Use a path that's guaranteed to not have .ken in any ancestor.\n        result = _paths.find_project_root(start=tmp_path)\n        # Walking up may eventually hit a real .ken/ on the dev machine —\n        # we only guarantee that without one it'd be None. Accept either.\n        if result is not None:\n            # If it found something, at least confirm it's a valid project root.\n            assert _paths.meta_path(result).is_file()\n    finally:\n        if saved is not None:\n            os.environ[\"KEN_PROJECT_ROOT\"] = saved\n\n\ndef test_find_project_root_respects_env_var(tmp_path, monkeypatch):\n    root = tmp_path / \"envproj\"\n    (root / \".ken\").mkdir(parents=True)\n    (root / \".ken\" / \"meta.json\").write_text(\"{}\")\n    monkeypatch.setenv(\"KEN_PROJECT_ROOT\", str(root))\n    # Even if start= points elsewhere, env var wins.\n    other = tmp_path / \"other\"\n    other.mkdir()\n    found = _paths.find_project_root(start=other)\n    assert found is not None\n    assert found.resolve() == root.resolve()\n\n\ndef test_env_var_with_invalid_path_returns_none(tmp_path, monkeypatch):\n    \"\"\"Env var pointing somewhere with no meta.json → None (not a fallback).\"\"\"\n    nowhere = tmp_path / \"nowhere\"\n    nowhere.mkdir()\n    monkeypatch.setenv(\"KEN_PROJECT_ROOT\", str(nowhere))\n    assert _paths.find_project_root() is None\n\n\ndef test_path_helpers_compose(tmp_path):\n    root = tmp_path\n    assert _paths.ken_dir(root) == root / \".ken\"\n    assert _paths.meta_path(root) == root / \".ken\" / \"meta.json\"\n    assert _paths.db_path(root) == root / \".ken\" / \"ken.db\"\n    assert _paths.port_path(root) == root / \".ken\" / \"daemon.port\"\n    assert _paths.pid_path(root) == root / \".ken\" / \"daemon.pid\"\n    assert _paths.log_path(root) == root / \".ken\" / \"daemon.log\"\n\n\n@pytest.mark.parametrize(\"absolute\", [False, True])\ndef test_resolve_project_path_accepts_internal_path(tmp_path, absolute):\n    root = tmp_path / \"project\"\n    source = root / \"src\" / \"module.py\"\n    source.parent.mkdir(parents=True)\n    source.write_text(\"\", encoding=\"utf-8\")\n\n    supplied = source if absolute else Path(\"src/module.py\")\n\n    assert _paths.resolve_project_path(root, supplied) == source.resolve()\n\n\ndef test_resolve_project_path_rejects_parent_traversal(tmp_path):\n    root = tmp_path / \"project\"\n    root.mkdir()\n\n    with pytest.raises(ValueError, match=r\"^path escapes project root: \"):\n        _paths.resolve_project_path(root, \"../outside.py\")\n\n\ndef test_resolve_project_path_rejects_absolute_external_path(tmp_path):\n    root = tmp_path / \"project\"\n    root.mkdir()\n    outside = tmp_path / \"outside.py\"\n\n    with pytest.raises(ValueError, match=r\"^path escapes project root: \"):\n        _paths.resolve_project_path(root, outside)\n\n\ndef test_resolve_project_path_rejects_symlink_escape(tmp_path):\n    root = tmp_path / \"project\"\n    root.mkdir()\n    outside = tmp_path / \"outside\"\n    outside.mkdir()\n    (root / \"linked\").symlink_to(outside, target_is_directory=True)\n\n    with pytest.raises(ValueError, match=r\"^path escapes project root: \"):\n        _paths.resolve_project_path(root, \"linked/secret.py\")\n[project]\nname = \"ken-rank\"\n# Single-sourced from src/ken/__init__.py — see [tool.hatch.version]. Keeping a\n# literal here as well is what shipped 0.5.0 and 0.7.0 with `ken --version`\n# reporting the *previous* release: two places to bump, one of them easy to miss.\ndynamic = [\"version\"]\ndescription = \"Per-project context-rank index for Claude Code, served from a local daemon.\"\nreadme = \"README.md\"\nrequires-python = \">=3.11\"\nlicense = { text = \"MIT\" }\nauthors = [{ name = \"Andres\" }]\ndependencies = [\n    \"tree-sitter>=0.25.2\",\n    \"tree-sitter-python>=0.23\",\n    \"tree-sitter-rust>=0.23\",\n    \"tree-sitter-javascript>=0.23\",\n    \"tree-sitter-typescript>=0.23\",\n    \"tree-sitter-go>=0.23\",\n    \"tree-sitter-java>=0.23\",\n    # Dart has no standalone tree-sitter wheel on PyPI; the language-pack\n    # bundles the grammar (and pins tree-sitter>=0.25.2, hence the bump above).\n    \"tree-sitter-language-pack>=1.8\",\n    \"pathspec>=0.12\",\n    \"watchfiles>=0.22\",\n    # fastembed brings ONNX Runtime + a managed all-MiniLM-L6-v2 download\n    # (~25 MB cached in ~/.cache/fastembed on first use). 384-dim, fast on\n    # CPU; same model infinidev runs in production.\n    \"fastembed>=0.5\",\n    \"numpy>=1.26\",\n    # MCP SDK — exposes ken's tools to Claude Code over stdio.\n    # Pinned to the 2.x line: 2.0 renamed ``FastMCP`` to ``MCPServer``\n    # and moved it to ``mcp.server``; 0.10.0 of ken-rank shipped with the\n    # older ``mcp>=1.0`` pin by accident, so older installs may have\n    # resolved mcp 1.x — and then the MCP server silently failed at\n    # import. ``<3`` keeps 3.x out until we verify it (the 3.x line is\n    # not yet on PyPI as of writing).\n    \"mcp>=2.0,<3\",\n]\n\n[project.optional-dependencies]\n# GPU embedding for the default (fastembed) backend. `pip install\n# ken-rank[gpu]` swaps in fastembed's GPU build (it pulls onnxruntime-gpu).\n# The embedder then auto-detects a CUDA/ROCm provider and uses it, falling\n# back to CPU when none is usable — so this extra is purely opt-in\n# acceleration and never a hard requirement. The pulled onnxruntime-gpu\n# targets a specific CUDA major; if it does not match the host's CUDA\n# runtime, ken logs a warning and stays on CPU rather than failing. Pin\n# onnxruntime-gpu yourself if you need a specific CUDA line.\n#\n# Not installable on macOS: onnxruntime-gpu publishes Linux and Windows wheels\n# only, so without the marker `pip install 'ken-rank[gpu]'` fails outright on a\n# Mac. There is nothing to offer instead — ONNX Runtime has no MPS provider, so\n# the fastembed backend stays on the CPU there (where its small models are\n# already fast). Apple Silicon GPU acceleration lives in the `torch` extra.\ngpu = [\"fastembed-gpu>=0.5; sys_platform != 'darwin'\"]\n\n# The torch backend: `pip install ken-rank[torch]` adds sentence-transformers\n# (which pulls torch) so ken can run stronger models fastembed does not ship —\n# e.g. Qwen/Qwen3-Embedding-0.6B (top of ken's retrieval benchmark) or\n# BAAI/bge-m3. Heavier install; entirely opt-in. Switch a project onto one\n# with `ken reembed --model <name>` after installing this extra. Also\n# GPU-aware: CUDA, or Apple Silicon's MPS, whichever torch sees.\n#\n# The two version floors are not cosmetic. sentence-transformers only requires\n# transformers>=4.34, but the Qwen3 architecture landed in 4.51 — below it the\n# model dies with `KeyError: 'qwen3'`, naming neither the cause nor the fix. And\n# torch below 2.9 could return silently wrong embeddings on MPS (pytorch#163597,\n# fixed in 2.9.0), so Apple Silicon gets a floor that costs Linux users nothing;\n# it is scoped to arm64 because PyPI has no torch 2.9 for Intel Macs, where MPS\n# does not exist anyway.\ntorch = [\n    \"sentence-transformers>=3.0\",\n    \"transformers>=4.51\",\n    \"torch>=2.9; sys_platform == 'darwin' and platform_machine == 'arm64'\",\n]\n\n[project.scripts]\nken = \"ken.cli:main\"\n\n[dependency-groups]\ndev = [\n    \"mypy>=1.15\",\n    \"pytest>=8.0\",\n]\n\n[build-system]\nrequires = [\"hatchling\"]\nbuild-backend = \"hatchling.build\"\n\n# The one place the version lives. hatchling reads __version__ out of this file\n# at build time, so the package metadata and what `ken --version` prints cannot\n# disagree — they are the same string.\n[tool.hatch.version]\npath = \"src/ken/__init__.py\"\n\n[tool.hatch.build.targets.wheel]\npackages = [\"src/ken\"]\n\n[tool.hatch.build.targets.sdist]\ninclude = [\"src/ken\", \"README.md\", \"LICENSE\", \"pyproject.toml\"]\n\n[tool.pytest.ini_options]\ntestpaths = [\"tests\"]\naddopts = \"-q\"\n\n[tool.mypy]\npython_version = \"3.12\"\nfiles = [\"src/ken\"]\nshow_error_codes = true\nwarn_unused_configs = true\n\n# Incremental typing gate: these existing modules have known annotation debt.\n# They remain part of mypy's import graph, while every other module — and every\n# new module — must stay clean. Remove entries as their annotations are fixed.\n[[tool.mypy.overrides]]\nmodule = [\n    \"ken.cli\",\n    \"ken.embedder.onnx_fastembed\",\n    \"ken.embedder.st_backend\",\n    \"ken.embedder.static_head\",\n    \"ken.findings_graph\",\n    \"ken.graphtools\",\n    \"ken.indexer\",\n    \"ken.mcp.server\",\n    \"ken.parsers.cpp\",\n    \"ken.parsers.dart\",\n    \"ken.parsers.php\",\n    \"ken.parsers.sql\",\n    \"ken.ranker.output\",\n    \"ken.reembed\",\n    \"ken.status\",\n    \"ken.structure\",\n    \"ken.vectors\",\n]\nignore_errors = true\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'resolve_project_path|path escapes|def do_POST|/structure|def .*structure' src tests; rg -n 'relative_to|is_relative_to' src/ken\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'resolve_project_path|path escapes|def do_POST|/structure|def .*structure' src tests; rg -n 'relative_to|is_relative_to' src/ken\"","aggregated_output":"tests/test_stochastic_tools.py:311:def test_modularity_is_near_zero_without_community_structure():\ntests/test_paths.py:73:def test_resolve_project_path_accepts_internal_path(tmp_path, absolute):\ntests/test_paths.py:81:    assert _paths.resolve_project_path(root, supplied) == source.resolve()\ntests/test_paths.py:84:def test_resolve_project_path_rejects_parent_traversal(tmp_path):\ntests/test_paths.py:88:    with pytest.raises(ValueError, match=r\"^path escapes project root: \"):\ntests/test_paths.py:89:        _paths.resolve_project_path(root, \"../outside.py\")\ntests/test_paths.py:92:def test_resolve_project_path_rejects_absolute_external_path(tmp_path):\ntests/test_paths.py:97:    with pytest.raises(ValueError, match=r\"^path escapes project root: \"):\ntests/test_paths.py:98:        _paths.resolve_project_path(root, outside)\ntests/test_paths.py:101:def test_resolve_project_path_rejects_symlink_escape(tmp_path):\ntests/test_paths.py:108:    with pytest.raises(ValueError, match=r\"^path escapes project root: \"):\ntests/test_paths.py:109:        _paths.resolve_project_path(root, \"linked/secret.py\")\nsrc/ken/_paths.py:51:def resolve_project_path(project_root: Path, path: str | Path) -> Path:\nsrc/ken/_paths.py:65:        raise ValueError(f\"path escapes project root: {path}\") from err\nsrc/ken/mcp/server.py:329:    resolved = _paths.resolve_project_path(_PROJECT_ROOT, path)\nsrc/ken/daemon/server.py:332:    def do_POST(self) -> None:  # noqa: N802 - stdlib name\ntests/test_tools_cli.py:129:    assert \"path escapes project root\" in capsys.readouterr().err\nsrc/ken/cochange.py:153:            repos.append(\"\" if d == root else d.relative_to(root).as_posix())\nsrc/ken/cochange.py:179:        d.relative_to(root)\nsrc/ken/cochange.py:184:            return \"\" if d == root else d.relative_to(root).as_posix()\nsrc/ken/install.py:152:                f\"[db] {'created' if fresh_db else 'opened'} {db_p.relative_to(root)}\"\nsrc/ken/search.py:530:                normalized = p.resolve().relative_to(project_root.resolve()).as_posix()\nsrc/ken/session_brief.py:275:        return Path(path).relative_to(project_root).as_posix()\nsrc/ken/daemon/watcher.py:106:            return p.resolve().relative_to(self.project_root).as_posix()\nsrc/ken/daemon/watcher.py:114:            rel = Path(path).resolve().relative_to(self.project_root).as_posix()\nsrc/ken/cli.py:1364:        if not source_path.is_relative_to(resolved_root):\nsrc/ken/gitignore_filter.py:77:                local_rel = rel if scoped.base == Path(\".\") else rel.relative_to(scoped.base)\nsrc/ken/gitignore_filter.py:138:                rel = entry.relative_to(root)\nsrc/ken/mcp/server.py:330:    return resolved.relative_to(_PROJECT_ROOT.resolve()).as_posix()\nsrc/ken/_paths.py:63:        resolved.relative_to(root)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/ken/mcp/server.py | sed -n '1,180p;285,460p'; rg -n '_rel_path|_resolve|path:|read_text|exists|is_file' src/ken/mcp/server.py; nl -ba tests/test_tools_cli.py | sed -n '1,155p'; rg -n 'mcp|_PROJECT_ROOT|ValueError|outline' src/ken/cli.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/ken/mcp/server.py | sed -n '1,180p;285,460p'; rg -n '_rel_path|_resolve|path:|read_text|exists|is_file' src/ken/mcp/server.py; nl -ba tests/test_tools_cli.py | sed -n '1,155p'; rg -n 'mcp|_PROJECT_ROOT|ValueError|outline' src/ken/cli.py\"","aggregated_output":"     1\t\"\"\"stdio MCP server — entrypoint for ``ken mcp``.\n     2\t\n     3\tBuilt on the official ``mcp`` Python SDK v2. The old ``FastMCP`` class\n     4\twas renamed to ``MCPServer``; the decorator API (``@mcp.tool()``) is the\n     5\tsame shape it always was, so every tool below is a plain function with\n     6\ttype annotations and a docstring — same surface ken has exposed since\n     7\t0.x. The CLI passthrough (``ken tools ...``) reads from a parallel\n     8\tregistry populated alongside the SDK registration, so it does not need\n     9\tto spin up the stdio server to list tools.\n    10\t\"\"\"\n    11\t\n    12\tfrom __future__ import annotations\n    13\t\n    14\timport inspect\n    15\timport logging\n    16\timport sqlite3\n    17\timport sys\n    18\timport types\n    19\timport typing\n    20\tfrom dataclasses import dataclass\n    21\tfrom pathlib import Path\n    22\tfrom typing import Any, Callable, Literal\n    23\t\n    24\ttry:\n    25\t    from mcp.server import MCPServer\n    26\texcept ImportError as _exc:\n    27\t    from importlib.metadata import PackageNotFoundError, version as _pkg_version\n    28\t\n    29\t    try:\n    30\t        _installed = _pkg_version(\"mcp\")\n    31\t    except PackageNotFoundError:\n    32\t        _installed = \"not installed\"\n    33\t\n    34\t    sys.stderr.write(\n    35\t        \"ken mcp: this build of ken needs the `mcp` Python SDK >= 2.0, but the\\n\"\n    36\t        f\"environment only has `{_installed}` installed (reason: {_exc}).\\n\"\n    37\t        \"The MCP server cannot start with that version — `mcp.server.MCPServer`\\n\"\n    38\t        \"only exists in mcp 2.x; mcp 1.x still ships the older `FastMCP` API.\\n\"\n    39\t        \"\\n\"\n    40\t        \"This typically happens when an older ken-rank (0.10.0 or earlier,\\n\"\n    41\t        \"with the wrong `mcp>=1.0` pin in 0.10.0) was installed before the\\n\"\n    42\t        \"fix landed. Fix it with:\\n\"\n    43\t        \"\\n\"\n    44\t        \"    uv tool install --reinstall ken-rank\\n\"\n    45\t        \"    # or, for pipx:\\n\"\n    46\t        \"    pipx reinstall ken-rank\\n\"\n    47\t        \"    # or, for plain pip:\\n\"\n    48\t        \"    pip install --upgrade --force-reinstall ken-rank\\n\"\n    49\t        \"\\n\"\n    50\t        \"Then restart the assistant that hosts the MCP server (Claude Code,\\n\"\n    51\t        \"Codex, OpenCode, …) so it respawns the `ken mcp` process.\\n\"\n    52\t    )\n    53\t    sys.stderr.flush()\n    54\t    raise SystemExit(1) from _exc\n    55\t\n    56\tfrom ken import _paths\n    57\tfrom ken.clones import clones\n    58\tfrom ken.cochange import cochange\n    59\tfrom ken.codeflow import callgraph, type_hierarchy, wiring\n    60\tfrom ken.db import connect\n    61\tfrom ken.graphtools import architecture, blast_radius\n    62\tfrom ken.grep import grep\n    63\tfrom ken.intent import intent_history\n    64\tfrom ken.memory import forget, list_findings, recall, remember\n    65\tfrom ken.profile import profile\n    66\tfrom ken.search import (\n    67\t    changed_context,\n    68\t    file_neighbors,\n    69\t    file_outline,\n    70\t    file_snippets,\n    71\t    file_symbols,\n    72\t    find_tests,\n    73\t    module_graph,\n    74\t    project_overview,\n    75\t    search_files,\n    76\t    search_symbols,\n    77\t    symbol_detail,\n    78\t)\n    79\t\n    80\tlogger = logging.getLogger(\"ken.mcp\")\n    81\t\n    82\t# Each `ken mcp` is a *single project* server — coding agents launch\n    83\t# one instance per workspace. The project root is resolved once at\n    84\t# startup; if it's not a ken project we fail fast so the user sees\n    85\t# a clear error in their MCP logs.\n    86\t_PROJECT_ROOT: Path | None = None\n    87\t\n    88\tmcp = MCPServer(\"ken\")\n    89\t\n    90\t\n    91\tdef run(start: Path) -> int:\n    92\t    \"\"\"Resolve the project root, then hand control to the MCP stdio loop.\"\"\"\n    93\t    global _PROJECT_ROOT\n    94\t    root = _paths.find_project_root(start.resolve()) or start.resolve()\n    95\t    if not _paths.meta_path(root).is_file():\n    96\t        print(f\"ken mcp: no .ken project at {root}\", file=sys.stderr)\n    97\t        return 1\n    98\t    _PROJECT_ROOT = root\n    99\t    logging.basicConfig(\n   100\t        stream=sys.stderr,\n   101\t        level=logging.INFO,\n   102\t        format=\"%(asctime)s %(levelname)s %(name)s %(message)s\",\n   103\t    )\n   104\t    logger.info(\"ken mcp ready project_root=%s\", root)\n   105\t    mcp.run(transport=\"stdio\")\n   106\t    return 0\n   107\t\n   108\t\n   109\t# ---- CLI tool registry --------------------------------------------------\n   110\t#\n   111\t# ``ken tools ...`` (the shell-side passthrough) reads tool names,\n   112\t# descriptions, and parameter schemas from this registry so it does not\n   113\t# need to spin up the MCP stdio loop just to print ``--help`` text. We\n   114\t# mirror each ``@mcp.tool()`` registration into ``_REGISTRY`` via the\n   115\t# ``_register`` helper below.\n   116\t\n   117\t\n   118\t@dataclass\n   119\tclass ToolDef:\n   120\t    \"\"\"Lightweight record of a registered MCP tool.\n   121\t\n   122\t    Mirrors the public surface of the old ``fastmcp.Tool`` object that\n   123\t    ``ken tools ...`` was reading via ``mcp._tool_manager.list_tools()``:\n   124\t    ``name``, ``description``, ``parameters`` (JSON schema), ``fn``, and\n   125\t    ``is_async``.\n   126\t    \"\"\"\n   127\t\n   128\t    name: str\n   129\t    description: str\n   130\t    fn: Callable[..., Any]\n   131\t    is_async: bool\n   132\t    parameters: dict[str, Any]\n   133\t    input_schema: dict[str, Any]\n   134\t\n   135\t\n   136\t_REGISTRY: dict[str, ToolDef] = {}\n   137\t\n   138\t\n   139\tdef _register(fn: Callable[..., Any]) -> Callable[..., Any]:\n   140\t    \"\"\"Build a ``ToolDef`` from a function and stash it in ``_REGISTRY``.\n   141\t\n   142\t    The function name becomes the tool name (callers use the\n   143\t    ``ken_foo`` convention themselves). The JSON schema is derived from\n   144\t    the function's signature — annotations become ``properties``,\n   145\t    parameters with defaults become optional, the rest required. This is\n   146\t    the same shape the SDK derives internally, so any agent that reads\n   147\t    those schemas sees the same surface either way.\n   148\t    \"\"\"\n   149\t    sig = inspect.signature(fn)\n   150\t    # Resolve string annotations (``from __future__ import annotations``\n   151\t    # makes every annotation a forward-reference string at runtime; we\n   152\t    # need the real type object to map it to a JSON schema).\n   153\t    # ``inspect.get_annotations(..., eval_str=True)`` evaluates those\n   154\t    # strings against the function's own ``__globals__``, which is what\n   155\t    # the SDK does internally to build its own tool schema.\n   156\t    try:\n   157\t        hints = inspect.get_annotations(fn, eval_str=True)\n   158\t    except Exception:\n   159\t        # Fallback for unresolvable forward refs: leave the annotation as-is.\n   160\t        hints = {}\n   161\t    properties: dict[str, Any] = {}\n   162\t    required: list[str] = []\n   163\t    for name, param in sig.parameters.items():\n   164\t        if name == \"self\":\n   165\t            continue\n   166\t        annotation = hints.get(name, param.annotation)\n   167\t        prop, has_default = _annotation_to_schema(param, annotation)\n   168\t        if prop is None:\n   169\t            continue\n   170\t        if not has_default:\n   171\t            required.append(name)\n   172\t        properties[name] = prop\n   173\t\n   174\t    schema: dict[str, Any] = {\n   175\t        \"type\": \"object\",\n   176\t        \"properties\": properties,\n   177\t    }\n   178\t    if required:\n   179\t        schema[\"required\"] = required\n   180\t\n   285\t\n   286\t\n   287\tdef _literal_schema(core: Any) -> dict[str, Any]:\n   288\t    \"\"\"``Literal[...]`` → a JSON ``enum``, typed when the values agree.\n   289\t\n   290\t    A closed set of values is the difference between a menu and free-form\n   291\t    generation. Without the ``enum``, an agent has to guess what a mode\n   292\t    argument accepts from prose that a host's description compression may\n   293\t    already have trimmed — which is strictly worse than having been handed\n   294\t    separate named tools.\n   295\t    \"\"\"\n   296\t    values = list(typing.get_args(core))\n   297\t    schema: dict[str, Any] = {\"enum\": values}\n   298\t    kinds = {type(v) for v in values}\n   299\t    if len(kinds) == 1:\n   300\t        only = kinds.pop()\n   301\t        if only in _PRIMITIVE_JSON_TYPE:\n   302\t            schema[\"type\"] = _PRIMITIVE_JSON_TYPE[only]\n   303\t    return schema\n   304\t\n   305\t\n   306\tdef _items_schema(args: tuple[Any, ...]) -> dict[str, Any]:\n   307\t    if not args:\n   308\t        return {}\n   309\t    inner, _ = _unwrap_optional(args[0])\n   310\t    if inner in _PRIMITIVE_JSON_TYPE:\n   311\t        return {\"type\": _PRIMITIVE_JSON_TYPE[inner]}\n   312\t    if typing.get_origin(inner) is typing.Literal:\n   313\t        # ``list[Literal[...]]`` — the element enum is the only place that\n   314\t        # says which values the list may hold.\n   315\t        return _literal_schema(inner)\n   316\t    return {}\n   317\t\n   318\t\n   319\tdef _conn() -> sqlite3.Connection:\n   320\t    if _PROJECT_ROOT is None:\n   321\t        raise RuntimeError(\"MCP server not initialised — call run() first\")\n   322\t    return connect(_paths.db_path(_PROJECT_ROOT))\n   323\t\n   324\t\n   325\tdef _project_relative_path(path: str) -> str:\n   326\t    \"\"\"Validate a tool path and return its canonical index representation.\"\"\"\n   327\t    if _PROJECT_ROOT is None:\n   328\t        raise RuntimeError(\"MCP server not initialised — call run() first\")\n   329\t    resolved = _paths.resolve_project_path(_PROJECT_ROOT, path)\n   330\t    return resolved.relative_to(_PROJECT_ROOT.resolve()).as_posix()\n   331\t\n   332\t\n   333\t# ---- MCP server tools ----------------------------------------------\n   334\t#\n   335\t# Same surface as before — same names, same docstrings, same parameter\n   336\t# annotations and defaults. Only the registration mechanism changed\n   337\t# (``@mcp.tool()`` now lives on ``MCPServer`` instead of ``FastMCP``);\n   338\t# the bodies are byte-for-byte identical to the pre-migration server.\n   339\t\n   340\t\n   341\tdef _impl_ken_search_files(query: str, limit: int = 8) -> list[dict]:\n   342\t    \"\"\"Search the project's indexed files for ones semantically relevant to *query*.\n   343\t\n   344\t    Cosine similarity against per-file embeddings (built from each\n   345\t    file's language + base name + top symbol names — same shape the\n   346\t    ranker's fuzzy channel uses). Returns the top *limit* hits with\n   347\t    their score and a short symbol outline.\n   348\t\n   349\t    When *query* is a bare identifier (``cochange``, ``reembed``) the semantic\n   350\t    order is fused with a literal path match, and files matching it exactly are\n   351\t    listed first with ``match: \"exact\"``. ``score`` stays the cosine either\n   352\t    way, so with a literal match present the list is not in score order.\n   353\t    \"\"\"\n   354\t    with _conn() as conn:\n   355\t        return search_files(conn, query, limit=limit, project_root=_PROJECT_ROOT)\n   356\t\n   357\t\n   358\tdef _impl_ken_search_symbols(query: str, limit: int = 10) -> list[dict]:\n   359\t    \"\"\"Search the project's indexed symbols (functions, classes, methods) for\n   360\t    ones semantically relevant to *query*.\n   361\t\n   362\t    Cosine similarity against per-symbol embeddings (built from\n   363\t    ``\"{kind} {name} — {docstring_first_line}\"``). Returns the top\n   364\t    *limit* hits with their location and one-line doc.\n   365\t\n   366\t    When *query* is a bare identifier the semantic order is fused with a\n   367\t    literal name match: symbols named exactly that come first\n   368\t    (``match: \"exact\"``), then partial matches (``\"qualified\"`` for a method of\n   369\t    a class, ``\"tokens\"`` for a shared-word name) traded off against\n   370\t    similarity. Without this a query like ``blast_radius`` returns\n   371\t    ``test_blast_radius_reverse_reachability`` above the function itself.\n   372\t    ``score`` remains the cosine, so the list is not in score order when a\n   373\t    literal match is present. Prose queries are pure similarity, unchanged.\n   374\t    \"\"\"\n   375\t    with _conn() as conn:\n   376\t        return search_symbols(conn, query, limit=limit, project_root=_PROJECT_ROOT)\n   377\t\n   378\t\n   379\tdef _impl_ken_file_symbols(path: str, include_docstrings: bool = True) -> dict:\n   380\t    \"\"\"Return the indexed symbol structure for one file.\n   381\t\n   382\t    *path* is the project-relative file path stored in Ken's index, such\n   383\t    as ``src/ken/search.py``. Returns all symbols ordered by source line\n   384\t    with kind, name, qualified name, start/end lines, and optionally the\n   385\t    first docstring/comment line captured by the parser.\n   386\t    \"\"\"\n   387\t    with _conn() as conn:\n   388\t        return file_symbols(\n   389\t            conn,\n   390\t            path,\n   391\t            include_docstrings=include_docstrings,\n   392\t            project_root=_PROJECT_ROOT,\n   393\t        )\n   394\t\n   395\t\n   396\tdef _impl_ken_file_outline(\n   397\t    path: str,\n   398\t    include_symbols: bool = True,\n   399\t    include_imports: bool = True,\n   400\t    include_docstrings: bool = True,\n   401\t) -> dict:\n   402\t    \"\"\"Return a structural outline for one indexed file.\n   403\t\n   404\t    Includes language, symbol count, optional symbols, optional imports,\n   405\t    optional reverse imports, and optional first-line docstrings.\n   406\t    \"\"\"\n   407\t    with _conn() as conn:\n   408\t        return file_outline(\n   409\t            conn,\n   410\t            path,\n   411\t            include_symbols=include_symbols,\n   412\t            include_imports=include_imports,\n   413\t            include_docstrings=include_docstrings,\n   414\t            project_root=_PROJECT_ROOT,\n   415\t        )\n   416\t\n   417\t\n   418\tdef _impl_ken_file_neighbors(path: str, limit: int = 20) -> dict:\n   419\t    \"\"\"Return files directly related to *path*.\n   420\t\n   421\t    Uses resolved internal imports, reverse imports, and test-file\n   422\t    heuristics to suggest files worth inspecting alongside the target.\n   423\t    \"\"\"\n   424\t    with _conn() as conn:\n   425\t        return file_neighbors(conn, path, limit=limit, project_root=_PROJECT_ROOT)\n   426\t\n   427\t\n   428\tdef _impl_ken_symbol_detail(path: str, qualname: str, include_snippet: bool = False) -> dict:\n   429\t    \"\"\"Return metadata for one symbol in one file, optionally with source.\"\"\"\n   430\t    with _conn() as conn:\n   431\t        return symbol_detail(\n   432\t            conn,\n   433\t            path,\n   434\t            qualname,\n   435\t            include_snippet=include_snippet,\n   436\t            project_root=_PROJECT_ROOT,\n   437\t        )\n   438\t\n   439\t\n   440\tdef _impl_ken_module_graph(path: str, depth: int = 1, limit: int = 100) -> dict:\n   441\t    \"\"\"Return a bounded local import graph around one indexed file.\n   442\t\n   443\t    ``limit`` caps *nodes*. Every returned edge has both endpoints in ``nodes``,\n   444\t    so the graph is always well-formed; when the cap cut the neighbourhood\n   445\t    short, a ``truncated`` block reports how many edges that dropped.\n   446\t    \"\"\"\n   447\t    with _conn() as conn:\n   448\t        return module_graph(\n   449\t            conn, path, depth=depth, limit=limit, project_root=_PROJECT_ROOT\n   450\t        )\n   451\t\n   452\t\n   453\tdef _impl_ken_find_tests(path: str, limit: int = 20) -> dict:\n   454\t    \"\"\"Return likely test files for an indexed source file, best evidence first.\n   455\t\n   456\t    Each candidate accumulates every channel that fired, and ``score`` ranks\n   457\t    them: being named by the ecosystem's convention (``test_x``, ``x_test``,\n   458\t    ``x.spec.ts``, ``XTest.java``) counts far more than merely importing the\n   459\t    target — for a widely-imported module like ``db.py`` almost every test does\n   460\t    that. Name matching is on whole tokens, so ``cli.py`` does not pull in\n38:        \"only exists in mcp 2.x; mcp 1.x still ships the older `FastMCP` API.\\n\"\n95:    if not _paths.meta_path(root).is_file():\n325:def _project_relative_path(path: str) -> str:\n379:def _impl_ken_file_symbols(path: str, include_docstrings: bool = True) -> dict:\n397:    path: str,\n418:def _impl_ken_file_neighbors(path: str, limit: int = 20) -> dict:\n428:def _impl_ken_symbol_detail(path: str, qualname: str, include_snippet: bool = False) -> dict:\n440:def _impl_ken_module_graph(path: str, depth: int = 1, limit: int = 100) -> dict:\n453:def _impl_ken_find_tests(path: str, limit: int = 20) -> dict:\n475:    path: str,\n568:def _impl_ken_file_findings(path: str, expand: bool = False, limit: int = 15) -> dict:\n586:    path: str,\n626:def _impl_ken_blast_radius(path: str, max_hops: int = 4) -> dict:\n660:def _impl_ken_profile(path: str, granularity: str = \"file\", top_terms: int = 12) -> dict:\n674:    path: str | None = None,\n745:    path: str | None = None,\n982:    path: str,\n1122:    is expressible as a query, which is why this tool exists.\n1159:    path: str = \"\",\n1195:    if path:\n     1\t\"\"\"`ken tools` — the CLI passthrough over the MCP tool registry.\n     2\t\n     3\tThe command builds its subcommands live from the same ``MCPServer`` object\n     4\t``ken mcp`` serves, so these tests drive it through ``main()`` (the real\n     5\targparse path) rather than the tool functions directly.\n     6\t\"\"\"\n     7\t\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport json\n    11\timport time\n    12\tfrom pathlib import Path\n    13\t\n    14\tfrom ken import _paths\n    15\tfrom ken.cli import main\n    16\tfrom ken.db import connect, init_schema\n    17\t\n    18\t\n    19\tdef _project(tmp_path: Path) -> Path:\n    20\t    \"\"\"A minimal indexed project: one file with one indexed symbol.\"\"\"\n    21\t    ken_dir = _paths.ken_dir(tmp_path)\n    22\t    ken_dir.mkdir()\n    23\t    _paths.meta_path(tmp_path).write_text(\"{}\", encoding=\"utf-8\")\n    24\t    src = tmp_path / \"src/parser.py\"\n    25\t    src.parent.mkdir(parents=True, exist_ok=True)\n    26\t    src.write_text(\"def parse_symbol():\\n    return 1\\n\", encoding=\"utf-8\")\n    27\t    with connect(_paths.db_path(tmp_path)) as conn:\n    28\t        init_schema(conn)\n    29\t        now_ms = int(time.time() * 1000)\n    30\t        file_id = conn.execute(\n    31\t            \"INSERT INTO ci_files(path, language, content_hash, mtime, indexed_at, symbol_count) \"\n    32\t            \"VALUES ('src/parser.py', 'python', ?, ?, ?, 1)\",\n    33\t            (b\"\\x00\" * 32, int(time.time() * 1e9), now_ms),\n    34\t        ).lastrowid\n    35\t        conn.execute(\n    36\t            \"INSERT INTO ci_symbols(\"\n    37\t            \"file_id, kind, name, qualname, line_start, line_end, docstring\"\n    38\t            \") VALUES (?, 'function', 'parse_symbol', 'parse_symbol', 1, 2, 'Parse symbols.')\",\n    39\t            (file_id,),\n    40\t        )\n    41\t    return tmp_path\n    42\t\n    43\t\n    44\tdef test_tools_list_prints_every_tool(capsys, tmp_path):\n    45\t    rc = main([\"tools\", \"--path\", str(tmp_path), \"--list\"])\n    46\t\n    47\t    assert rc == 0\n    48\t    out = capsys.readouterr().out\n    49\t    # The whole surface: six tools, not thirty. Projections collapsed into\n    50\t    # `ken_read`; the algorithms stayed named, as closed enums on\n    51\t    # `ken_find`, `ken_related` and `ken_rank`.\n    52\t    for name in (\"ken_find\", \"ken_read\", \"ken_related\",\n    53\t                 \"ken_rank\", \"ken_recall\", \"ken_remember\"):\n    54\t        assert name in out\n    55\t\n    56\t\n    57\tdef test_tools_no_name_lists_tools(capsys, tmp_path):\n    58\t    rc = main([\"tools\", \"--path\", str(tmp_path)])\n    59\t\n    60\t    assert rc == 0\n    61\t    assert \"ken_read\" in capsys.readouterr().out\n    62\t\n    63\t\n    64\tdef test_tools_runs_tool_and_prints_json(capsys, tmp_path):\n    65\t    root = _project(tmp_path)\n    66\t\n    67\t    rc = main([\"tools\", \"--path\", str(root), \"read\", \"src/parser.py\"])\n    68\t\n    69\t    assert rc == 0\n    70\t    payload = json.loads(capsys.readouterr().out)\n    71\t    assert payload[\"ok\"] is True\n    72\t    symbols = payload[\"outline\"][\"symbols\"]\n    73\t    assert symbols[0][\"qualname\"] == \"parse_symbol\"\n    74\t\n    75\t\n    76\tdef test_tools_accepts_ken_prefix_and_compact(capsys, tmp_path):\n    77\t    root = _project(tmp_path)\n    78\t\n    79\t    rc = main(\n    80\t        [\"tools\", \"--path\", str(root), \"--compact\", \"ken_read\", \"src/parser.py\"]\n    81\t    )\n    82\t\n    83\t    assert rc == 0\n    84\t    out = capsys.readouterr().out\n    85\t    assert out.count(\"\\n\") == 1  # single-line JSON\n    86\t    assert json.loads(out)[\"outline\"][\"symbols\"][0][\"name\"] == \"parse_symbol\"\n    87\t\n    88\t\n    89\tdef test_tools_boolean_flag_toggles_schema_default(capsys, tmp_path):\n    90\t    root = _project(tmp_path)\n    91\t\n    92\t    rc = main(\n    93\t        [\n    94\t            \"tools\", \"--path\", str(root),\n    95\t            \"find\", \"parse_symbol\", \"--scope\", \"text\", \"--literal\",\n    96\t        ]\n    97\t    )\n    98\t\n    99\t    assert rc == 0\n   100\t    payload = json.loads(capsys.readouterr().out)\n   101\t    assert payload[\"mode\"] == \"literal\"\n   102\t\n   103\t\n   104\tdef test_tools_unknown_name_reports_and_suggests(capsys, tmp_path):\n   105\t    rc = main([\"tools\", \"--path\", str(tmp_path), \"relate\"])\n   106\t\n   107\t    assert rc == 2\n   108\t    err = capsys.readouterr().err\n   109\t    assert \"unknown tool 'relate'\" in err\n   110\t    assert \"related\" in err  # difflib suggestion\n   111\t\n   112\t\n   113\tdef test_tools_reports_missing_project(capsys, tmp_path):\n   114\t    # No .ken/meta — the tool never runs.\n   115\t    rc = main([\"tools\", \"--path\", str(tmp_path), \"read\", \"src/parser.py\"])\n   116\t\n   117\t    assert rc == 1\n   118\t    assert \"no .ken project\" in capsys.readouterr().err\n   119\t\n   120\t\n   121\tdef test_tools_rejects_path_outside_project(capsys, tmp_path):\n   122\t    root = tmp_path / \"project\"\n   123\t    root.mkdir()\n   124\t    _project(root)\n   125\t\n   126\t    rc = main([\"tools\", \"--path\", str(root), \"read\", \"../outside.py\"])\n   127\t\n   128\t    assert rc == 1\n   129\t    assert \"path escapes project root\" in capsys.readouterr().err\n388:    p_mcp = sub.add_parser(\"mcp\", help=\"run as MCP stdio server\")\n389:    p_mcp.add_argument(\n603:    if args.cmd == \"mcp\":\n604:        from ken.mcp.server import run as run_mcp\n606:        return run_mcp(Path(args.path))\n1661:    from the same ``FastMCP`` object ``ken mcp`` serves, so this stays in\n1665:    from ken.mcp import server as mcp_server\n1667:    registry = {t.name: t for t in mcp_server.list_tools()}\n1699:    mcp_server._PROJECT_ROOT = root\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/ken/mcp/server.py | sed -n '975,1085p;1185,1205p'; nl -ba src/ken/cli.py | sed -n '1655,1740p'; rg -n 'def file_outline|def file_snippets|def _.*path|read_text|not.*found' src/ken/search.py; python3 -c 'import importlib.util; print({m:bool(importlib.util.find_spec(m)) for m in [\\\"pytest\\\",\\\"mcp\\\",\\\"numpy\\\",\\\"pathspec\\\"]})'; cat tests/conftest.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/ken/mcp/server.py | sed -n '975,1085p;1185,1205p'; nl -ba src/ken/cli.py | sed -n '1655,1740p'; rg -n 'def file_outline|def file_snippets|def _.*path|read_text|not.*found' src/ken/search.py; python3 -c 'import importlib.util; print({m:bool(importlib.util.find_spec(m)) for m in [\\\"pytest\\\",\\\"mcp\\\",\\\"numpy\\\",\\\"pathspec\\\"]})'; cat tests/conftest.py\"","aggregated_output":"   975\t        \"error\": f\"unknown scope {scope!r}\",\n   976\t        \"scopes\": [\"files\", \"symbols\", \"text\", \"tests\", \"wiring\", \"intent\"],\n   977\t    }\n   978\t\n   979\t\n   980\t@ken_tool\n   981\tdef ken_read(\n   982\t    path: str,\n   983\t    include: list[Literal[\"symbols\", \"imports\", \"docstrings\", \"source\", \"profile\"]] | None = None,\n   984\t    qualname: str = \"\",\n   985\t    start_line: int = 0,\n   986\t    end_line: int = 0,\n   987\t    max_chars: int = 0,\n   988\t) -> dict:\n   989\t    \"\"\"Read an indexed file's structure, and optionally its source. Pick\n   990\t    fields with *include*: symbols, imports, docstrings, source, profile.\n   991\t\n   992\t    *include* selects what comes back — any of ``symbols``, ``imports``,\n   993\t    ``docstrings``, ``source``, ``profile``. Defaults to ``[\"symbols\"]``.\n   994\t\n   995\t    ``source`` needs somewhere to read from: pass *qualname* for one symbol,\n   996\t    or *start_line*/*end_line* for a range. ``profile`` answers what the file\n   997\t    is *for* and how it differs from its siblings, which is the question you\n   998\t    have before you know which symbol you want.\n   999\t    \"\"\"\n  1000\t    path = _project_relative_path(path)\n  1001\t    include = list(include or [\"symbols\"])\n  1002\t    want = set(include)\n  1003\t    unknown = want - {\"symbols\", \"imports\", \"docstrings\", \"source\", \"profile\"}\n  1004\t    if unknown:\n  1005\t        return {\n  1006\t            \"ok\": False,\n  1007\t            \"error\": f\"unknown include values: {sorted(unknown)}\",\n  1008\t            \"include\": [\"symbols\", \"imports\", \"docstrings\", \"source\", \"profile\"],\n  1009\t        }\n  1010\t\n  1011\t    result: dict[str, Any] = {\"ok\": True, \"path\": path}\n  1012\t    docstrings = \"docstrings\" in want\n  1013\t\n  1014\t    if qualname and want & {\"symbols\", \"docstrings\"}:\n  1015\t        result[\"symbol\"] = _impl_ken_symbol_detail(\n  1016\t            path, qualname, include_snippet=\"source\" in want,\n  1017\t        )\n  1018\t    elif want & {\"symbols\", \"imports\"}:\n  1019\t        result[\"outline\"] = _impl_ken_file_outline(\n  1020\t            path,\n  1021\t            include_symbols=\"symbols\" in want,\n  1022\t            include_imports=\"imports\" in want,\n  1023\t            include_docstrings=docstrings,\n  1024\t        )\n  1025\t    elif docstrings:\n  1026\t        result[\"symbols\"] = _impl_ken_file_symbols(path, include_docstrings=True)\n  1027\t\n  1028\t    if \"source\" in want and \"symbol\" not in result:\n  1029\t        result[\"source\"] = _impl_ken_file_snippets(\n  1030\t            path,\n  1031\t            symbols=[qualname] if qualname else None,\n  1032\t            start_line=start_line,\n  1033\t            end_line=end_line,\n  1034\t            max_chars=max_chars,\n  1035\t        )\n  1036\t    if \"profile\" in want:\n  1037\t        result[\"profile\"] = _impl_ken_profile(path)\n  1038\t    return result\n  1039\t\n  1040\t\n  1041\t@ken_tool\n  1042\tdef ken_related(\n  1043\t    target: str,\n  1044\t    relation: Literal[\n  1045\t        \"neighbors\", \"imports\", \"callers\", \"callees\", \"subtypes\",\n  1046\t        \"supertypes\", \"cochange\", \"blast_radius\", \"clones\",\n  1047\t    ],\n  1048\t    limit: int = 10,\n  1049\t    depth: int = 1,\n  1050\t    min_confidence: float = 0.0,\n  1051\t) -> Any:\n  1052\t    \"\"\"What else is connected to *target*, by a named relationship:\n  1053\t    neighbors, imports, callers, callees, subtypes, supertypes, cochange,\n  1054\t    blast_radius, clones. Each is a distinct algorithm, not a filter.\n  1055\t\n  1056\t    *target* is a file path, or a symbol qualname for the call and type\n  1057\t    relations. Each *relation* is a distinct algorithm, not a filter:\n  1058\t\n  1059\t    * ``neighbors``    — files ken ranks as directly related.\n  1060\t    * ``imports``      — the local import graph around a file, *depth* hops.\n  1061\t    * ``callers`` / ``callees`` — the call graph for a symbol.\n  1062\t    * ``subtypes`` / ``supertypes`` — the type hierarchy, with overrides.\n  1063\t    * ``cochange``     — files historically committed together, scored by\n  1064\t      log-likelihood ratio. Surfaces coupling that imports do not show.\n  1065\t    * ``blast_radius`` — what a change here is likely to break. *depth* is\n  1066\t      the hop limit.\n  1067\t    * ``clones``       — near-duplicate code, by MinHash over token shingles.\n  1068\t    \"\"\"\n  1069\t    if relation == \"neighbors\":\n  1070\t        return _impl_ken_file_neighbors(_project_relative_path(target), limit=limit)\n  1071\t    if relation == \"imports\":\n  1072\t        return _impl_ken_module_graph(\n  1073\t            _project_relative_path(target), depth=depth, limit=limit\n  1074\t        )\n  1075\t    if relation in (\"callers\", \"callees\"):\n  1076\t        return _impl_ken_callgraph(\n  1077\t            target, direction=relation, min_confidence=min_confidence, limit=limit,\n  1078\t        )\n  1079\t    if relation in (\"subtypes\", \"supertypes\"):\n  1080\t        return _impl_ken_type_hierarchy(\n  1081\t            target,\n  1082\t            direction=\"down\" if relation == \"subtypes\" else \"up\",\n  1083\t            with_overrides=True,\n  1084\t        )\n  1085\t    if relation == \"cochange\":\n  1185\t        \"file\": anchor_file, \"symbol\": anchor_symbol,\n  1186\t        \"tool\": anchor_tool, \"error\": anchor_error,\n  1187\t    }\n  1188\t    if any(v.strip() for v in anchors.values()):\n  1189\t        from ken.memory import recall_by_anchor\n  1190\t\n  1191\t        with _conn() as conn:\n  1192\t            return recall_by_anchor(conn, anchors, limit=limit)\n  1193\t    if topic:\n  1194\t        return _impl_ken_related_findings(topic, limit=limit)\n  1195\t    if path:\n  1196\t        return _impl_ken_file_findings(path, limit=limit)\n  1197\t    if query:\n  1198\t        return _impl_ken_recall(query, limit=limit, min_score=min_score)\n  1199\t    return _impl_ken_findings(limit=limit, tag=tag or None)\n  1200\t\n  1201\t\n  1202\t@ken_tool\n  1203\tdef ken_remember(\n  1204\t    topic: str,\n  1205\t    content: str = \"\",\n  1655\t    list_only: bool,\n  1656\t    compact: bool,\n  1657\t) -> int:\n  1658\t    \"\"\"Dispatch `ken tools ...` — a thin CLI over the MCP tool registry.\n  1659\t\n  1660\t    The tool list, descriptions, and per-parameter schemas are read live\n  1661\t    from the same ``FastMCP`` object ``ken mcp`` serves, so this stays in\n  1662\t    sync with the MCP surface automatically — there is no second list of\n  1663\t    tools to maintain.\n  1664\t    \"\"\"\n  1665\t    from ken.mcp import server as mcp_server\n  1666\t\n  1667\t    registry = {t.name: t for t in mcp_server.list_tools()}\n  1668\t\n  1669\t    if list_only or not tool_name:\n  1670\t        _print_tools_list(registry)\n  1671\t        return 0\n  1672\t\n  1673\t    tool = registry.get(tool_name) or registry.get(f\"ken_{tool_name}\")\n  1674\t    if tool is None:\n  1675\t        import difflib\n  1676\t\n  1677\t        print(f\"error: unknown tool {tool_name!r}\", file=sys.stderr)\n  1678\t        candidates = list(registry) + [\n  1679\t            n[len(\"ken_\") :] for n in registry if n.startswith(\"ken_\")\n  1680\t        ]\n  1681\t        suggestions = difflib.get_close_matches(tool_name, candidates, n=3, cutoff=0.5)\n  1682\t        if suggestions:\n  1683\t            print(f\"did you mean: {', '.join(suggestions)}\", file=sys.stderr)\n  1684\t        else:\n  1685\t            print(\"run `ken tools` to list available tools\", file=sys.stderr)\n  1686\t        return 2\n  1687\t\n  1688\t    tool_parser = _build_tool_parser(tool)\n  1689\t    ns = tool_parser.parse_args(tool_argv)\n  1690\t    props = tool.parameters.get(\"properties\", {})\n  1691\t    kwargs = {name: getattr(ns, name) for name in props if hasattr(ns, name)}\n  1692\t\n  1693\t    from ken import _paths\n  1694\t\n  1695\t    root = _paths.find_project_root(project_path.resolve()) or project_path.resolve()\n  1696\t    if not _paths.meta_path(root).is_file():\n  1697\t        print(f\"error: no .ken project at {root}\", file=sys.stderr)\n  1698\t        return 1\n  1699\t    mcp_server._PROJECT_ROOT = root\n  1700\t\n  1701\t    try:\n  1702\t        result = tool.fn(**kwargs)\n  1703\t        if tool.is_async:\n  1704\t            import asyncio\n  1705\t\n  1706\t            result = asyncio.run(result)\n  1707\t    except Exception as exc:  # surface tool errors as a clean CLI failure\n  1708\t        print(f\"error: {tool.name} failed: {exc}\", file=sys.stderr)\n  1709\t        return 1\n  1710\t\n  1711\t    if compact:\n  1712\t        print(json.dumps(result, default=str))\n  1713\t    else:\n  1714\t        print(json.dumps(result, indent=2, default=str))\n  1715\t    return 0\n  1716\t\n  1717\t\n  1718\tdef _print_tools_list(registry: dict[str, Any]) -> None:\n  1719\t    width = max((len(n) for n in registry), default=0)\n  1720\t    for name in sorted(registry):\n  1721\t        summary = _first_doc_line(registry[name].description)\n  1722\t        print(f\"  {name:<{width}}  {summary}\")\n  1723\t    print(\"\\nRun `ken tools <name> --help` for a tool's parameters.\")\n  1724\t\n  1725\t\n  1726\tdef _first_doc_line(text: str | None) -> str:\n  1727\t    for line in (text or \"\").splitlines():\n  1728\t        stripped = line.strip()\n  1729\t        if stripped:\n  1730\t            return stripped\n  1731\t    return \"\"\n  1732\t\n  1733\t\n  1734\tdef _tool_schema_core(prop: dict[str, Any]) -> dict[str, Any]:\n  1735\t    \"\"\"Collapse an ``anyOf: [T, null]`` (Optional[T]) schema to just ``T``.\"\"\"\n  1736\t    if \"anyOf\" in prop:\n  1737\t        for variant in prop[\"anyOf\"]:\n  1738\t            if variant.get(\"type\") != \"null\":\n  1739\t                return variant\n  1740\t    return prop\n178:def file_outline(\n408:def file_snippets(\n524:def _normalize_index_path(path: str, *, project_root: Path | None = None) -> str:\n538:def _file_row(conn: sqlite3.Connection, path: str) -> sqlite3.Row | None:\n644:def _test_basename(path: str) -> str:\n742:def _looks_like_test(path: str) -> bool:\n761:def _unique_paths(paths: list[str]) -> list[str]:\n789:def _read_line_range(project_root: Path, rel_path: str, start: int, end: int) -> str:\n792:        lines = full.read_text(encoding=\"utf-8\", errors=\"replace\").splitlines()\n{'pytest': False, 'mcp': False, 'numpy': False, 'pathspec': False}\n\"\"\"Shared test fixtures.\"\"\"\n\nfrom __future__ import annotations\n\nimport pytest\n\n\n@pytest.fixture(autouse=True)\ndef _isolate_ken_user_config(tmp_path, monkeypatch):\n    \"\"\"Point the user config at a fresh temp dir for every test.\n\n    Without this, a developer's real ``~/.config/ken/config.json`` (e.g. a\n    ``ken default-model`` override pointing at a torch-only model) would leak\n    into the suite and break tests that build the real embedder.\n    \"\"\"\n    monkeypatch.setenv(\"KEN_CONFIG_DIR\", str(tmp_path / \"ken-config\"))\n    # Same reasoning one layer down: ``recommended_model()`` prefers the static\n    # table when its artifact is present, so a developer who has one cached\n    # would silently run a different suite than CI does — and the difference\n    # would show up as unrelated assertions about the recommended model\n    # failing, which is a needlessly confusing way to learn about it. Tests that\n    # want the table set KEN_STATIC_HEAD themselves.\n    monkeypatch.setenv(\"KEN_CACHE_DIR\", str(tmp_path / \"ken-cache\"))\n    monkeypatch.delenv(\"KEN_STATIC_HEAD\", raising=False)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"agent_message","text":"La lectura pública `ken_read` valida la ruta antes de consultar el índice o leer contenido. La comprobación resuelve los enlaces simbólicos y verifica que el resultado quede dentro de la raíz; no exige que el destino exista. Voy a comprobar también enlaces rotos y rutas hacia directorios hermanos con nombres parecidos.\n"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/ken/search.py | sed -n '178,213p;408,455p;485,548p;789,802p'; nl -ba src/ken/mcp/server.py | sed -n '184,213p;474,510p'; nl -ba src/ken/_paths.py | sed -n '51,86p'; nl -ba src/ken/cli.py | sed -n '394,425p;603,623p'; head -55 src/ken/search.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/ken/search.py | sed -n '178,213p;408,455p;485,548p;789,802p'; nl -ba src/ken/mcp/server.py | sed -n '184,213p;474,510p'; nl -ba src/ken/_paths.py | sed -n '51,86p'; nl -ba src/ken/cli.py | sed -n '394,425p;603,623p'; head -55 src/ken/search.py\"","aggregated_output":"   178\tdef file_outline(\n   179\t    conn: sqlite3.Connection,\n   180\t    path: str,\n   181\t    *,\n   182\t    include_symbols: bool = True,\n   183\t    include_imports: bool = True,\n   184\t    include_docstrings: bool = True,\n   185\t    project_root: Path | None = None,\n   186\t) -> dict:\n   187\t    \"\"\"Return an indexed file's structural outline.\"\"\"\n   188\t    normalized = _normalize_index_path(path, project_root=project_root)\n   189\t    row = _file_row(conn, normalized)\n   190\t    if row is None:\n   191\t        return {\"ok\": False, \"error\": \"file not indexed\", \"path\": normalized}\n   192\t    out = {\n   193\t        \"ok\": True,\n   194\t        \"path\": row[\"path\"],\n   195\t        \"language\": row[\"language\"] or \"text\",\n   196\t        \"symbol_count\": int(row[\"symbol_count\"]),\n   197\t        \"indexed_at\": int(row[\"indexed_at\"]),\n   198\t    }\n   199\t    module_doc = _module_docstring(conn, int(row[\"id\"]))\n   200\t    if include_docstrings:\n   201\t        out[\"docstring\"] = module_doc\n   202\t    if include_symbols:\n   203\t        out[\"symbols\"] = file_symbols(\n   204\t            conn,\n   205\t            row[\"path\"],\n   206\t            include_docstrings=include_docstrings,\n   207\t            project_root=project_root,\n   208\t        ).get(\"symbols\", [])\n   209\t    if include_imports:\n   210\t        out[\"imports\"] = _imports_for_file(conn, int(row[\"id\"]))\n   211\t        out[\"imported_by\"] = _importers_for_file(conn, int(row[\"id\"]))\n   212\t    return out\n   213\t\n   408\tdef file_snippets(\n   409\t    conn: sqlite3.Connection,\n   410\t    path: str,\n   411\t    *,\n   412\t    symbols: list[str] | None = None,\n   413\t    start_line: int | None = None,\n   414\t    end_line: int | None = None,\n   415\t    max_chars: int = 12000,\n   416\t    project_root: Path | None = None,\n   417\t) -> dict:\n   418\t    \"\"\"Return source snippets for selected symbols or a line range.\"\"\"\n   419\t    if project_root is None:\n   420\t        return {\"ok\": False, \"error\": \"project_root required\"}\n   421\t    normalized = _normalize_index_path(path, project_root=project_root)\n   422\t    row = _file_row(conn, normalized)\n   423\t    if row is None:\n   424\t        return {\"ok\": False, \"error\": \"file not indexed\", \"path\": normalized}\n   425\t\n   426\t    ranges: list[tuple[str, int, int]] = []\n   427\t    if symbols:\n   428\t        placeholders = \",\".join(\"?\" for _ in symbols)\n   429\t        rows = conn.execute(\n   430\t            f\"\"\"\n   431\t            SELECT name, qualname, line_start, line_end\n   432\t            FROM ci_symbols\n   433\t            WHERE file_id = ? AND (name IN ({placeholders}) OR qualname IN ({placeholders}))\n   434\t            ORDER BY line_start, line_end, name\n   435\t            \"\"\",\n   436\t            (int(row[\"id\"]), *symbols, *symbols),\n   437\t        ).fetchall()\n   438\t        ranges.extend(\n   439\t            (\n   440\t                sym[\"qualname\"] or sym[\"name\"],\n   441\t                int(sym[\"line_start\"]),\n   442\t                int(sym[\"line_end\"]),\n   443\t            )\n   444\t            for sym in rows\n   445\t        )\n   446\t    elif start_line is not None:\n   447\t        start = max(1, int(start_line))\n   448\t        end = max(start, int(end_line or start))\n   449\t        ranges.append((f\"{row['path']}:{start}-{end}\", start, end))\n   450\t    else:\n   451\t        rows = conn.execute(\n   452\t            \"\"\"\n   453\t            SELECT name, qualname, line_start, line_end\n   454\t            FROM ci_symbols\n   455\t            WHERE file_id = ?\n   485\tdef project_overview(\n   486\t    conn: sqlite3.Connection,\n   487\t    *,\n   488\t    depth: int = 2,\n   489\t    limit: int = 20,\n   490\t) -> dict:\n   491\t    \"\"\"Return a compact structural overview of the indexed project.\"\"\"\n   492\t    rows = conn.execute(\"SELECT path, language, symbol_count FROM ci_files\").fetchall()\n   493\t    languages = Counter((r[\"language\"] or \"text\") for r in rows)\n   494\t    dirs: Counter[str] = Counter()\n   495\t    max_depth = max(1, int(depth))\n   496\t    for row in rows:\n   497\t        parts = Path(row[\"path\"]).parts[:-1]\n   498\t        if parts:\n   499\t            dirs[\"/\".join(parts[:max_depth])] += 1\n   500\t    entrypoints = [\n   501\t        r[\"path\"]\n   502\t        for r in rows\n   503\t        if Path(r[\"path\"]).name\n   504\t        in {\"main.py\", \"__main__.py\", \"cli.py\", \"server.py\", \"app.py\", \"index.ts\", \"index.js\"}\n   505\t    ][: max(1, int(limit))]\n   506\t    top_symbol_files = sorted(\n   507\t        rows,\n   508\t        key=lambda r: (int(r[\"symbol_count\"]), r[\"path\"]),\n   509\t        reverse=True,\n   510\t    )[: max(1, int(limit))]\n   511\t    return {\n   512\t        \"ok\": True,\n   513\t        \"files\": len(rows),\n   514\t        \"languages\": dict(languages.most_common()),\n   515\t        \"top_dirs\": [{\"path\": path, \"files\": count} for path, count in dirs.most_common(limit)],\n   516\t        \"entrypoints\": entrypoints,\n   517\t        \"largest_symbol_files\": [\n   518\t            {\"path\": r[\"path\"], \"symbols\": int(r[\"symbol_count\"])}\n   519\t            for r in top_symbol_files\n   520\t        ],\n   521\t    }\n   522\t\n   523\t\n   524\tdef _normalize_index_path(path: str, *, project_root: Path | None = None) -> str:\n   525\t    normalized = Path(path).as_posix()\n   526\t    if project_root is not None:\n   527\t        p = Path(path)\n   528\t        if p.is_absolute():\n   529\t            try:\n   530\t                normalized = p.resolve().relative_to(project_root.resolve()).as_posix()\n   531\t            except (OSError, ValueError):\n   532\t                pass\n   533\t    if normalized.startswith(\"./\"):\n   534\t        normalized = normalized[2:]\n   535\t    return normalized\n   536\t\n   537\t\n   538\tdef _file_row(conn: sqlite3.Connection, path: str) -> sqlite3.Row | None:\n   539\t    return conn.execute(\n   540\t        \"SELECT id, path, language, symbol_count, indexed_at FROM ci_files WHERE path = ?\",\n   541\t        (path,),\n   542\t    ).fetchone()\n   543\t\n   544\t\n   545\tdef _symbol_dict(row: sqlite3.Row, *, include_docstring: bool) -> dict:\n   546\t    out = {\n   547\t        \"kind\": row[\"kind\"],\n   548\t        \"name\": row[\"name\"],\n   789\tdef _read_line_range(project_root: Path, rel_path: str, start: int, end: int) -> str:\n   790\t    full = project_root.resolve() / rel_path\n   791\t    try:\n   792\t        lines = full.read_text(encoding=\"utf-8\", errors=\"replace\").splitlines()\n   793\t    except OSError:\n   794\t        return \"\"\n   795\t    selected = lines[max(0, start - 1): max(start - 1, end)]\n   796\t    return \"\\n\".join(f\"{line_no}: {line}\" for line_no, line in enumerate(selected, start))\n   797\t\n   798\t\n   799\tdef _git_status(project_root: Path) -> list[dict]:\n   800\t    try:\n   801\t        proc = subprocess.run(\n   802\t            [\"git\", \"status\", \"--porcelain=v1\"],\n   184\t        fn=fn,\n   185\t        is_async=inspect.iscoroutinefunction(fn),\n   186\t        parameters=schema,\n   187\t        input_schema=schema,\n   188\t    )\n   189\t    return fn\n   190\t\n   191\t\n   192\tdef ken_tool(fn: Callable[..., Any]) -> Callable[..., Any]:\n   193\t    \"\"\"Register ``fn`` as both an MCP tool and a CLI-passthrough tool.\"\"\"\n   194\t    mcp.add_tool(fn)\n   195\t    _register(fn)\n   196\t    return fn\n   197\t\n   198\t\n   199\tdef list_tools() -> list[ToolDef]:\n   200\t    \"\"\"Snapshot of every registered tool, in insertion order.\"\"\"\n   201\t    return list(_REGISTRY.values())\n   202\t\n   203\t\n   204\t# ── JSON-Schema derivation ─────────────────────────────────────────────\n   205\t#\n   206\t# Mirrors what the SDK's MCPServer does internally — narrowly, only for\n   207\t# the annotation shapes ken actually uses (``str``, ``int``, ``float``,\n   208\t# ``bool``, ``list[...]``, ``dict[...]``, ``X | None`` / ``Optional[X]``).\n   209\t\n   210\t_PRIMITIVE_JSON_TYPE = {\n   211\t    str: \"string\",\n   212\t    int: \"integer\",\n   213\t    float: \"number\",\n   474\tdef _impl_ken_file_snippets(\n   475\t    path: str,\n   476\t    symbols: list[str] | None = None,\n   477\t    start_line: int | None = None,\n   478\t    end_line: int | None = None,\n   479\t    max_chars: int = 12000,\n   480\t) -> dict:\n   481\t    \"\"\"Return source snippets for selected symbols or a line range.\"\"\"\n   482\t    with _conn() as conn:\n   483\t        return file_snippets(\n   484\t            conn,\n   485\t            path,\n   486\t            symbols=symbols,\n   487\t            start_line=start_line,\n   488\t            end_line=end_line,\n   489\t            max_chars=max_chars,\n   490\t            project_root=_PROJECT_ROOT,\n   491\t        )\n   492\t\n   493\t\n   494\tdef _impl_ken_project_overview(depth: int = 2, limit: int = 20) -> dict:\n   495\t    \"\"\"Return a compact structural overview of the indexed project.\"\"\"\n   496\t    with _conn() as conn:\n   497\t        return project_overview(conn, depth=depth, limit=limit)\n   498\t\n   499\t\n   500\tdef _impl_ken_remember(\n   501\t    topic: str,\n   502\t    content: str,\n   503\t    tags: list[str] | None = None,\n   504\t    kind: str | None = None,\n   505\t    anchors: dict[str, str] | None = None,\n   506\t) -> dict:\n   507\t    \"\"\"Write a finding for future sessions to recall.\n   508\t\n   509\t    *topic* is a short lookup key (unique — re-using a topic updates\n   510\t    the existing row). *content* is the body — usually a few sentences\n    51\tdef resolve_project_path(project_root: Path, path: str | Path) -> Path:\n    52\t    \"\"\"Resolve *path* and require it to remain inside *project_root*.\n    53\t\n    54\t    Relative paths are interpreted from the project root. Absolute paths are\n    55\t    accepted when they point inside it. Resolving both sides before the\n    56\t    containment check also rejects ``..`` traversal and escapes through\n    57\t    existing symbolic links.\n    58\t    \"\"\"\n    59\t    root = project_root.expanduser().resolve()\n    60\t    supplied = Path(path).expanduser()\n    61\t    resolved = (supplied if supplied.is_absolute() else root / supplied).resolve()\n    62\t    try:\n    63\t        resolved.relative_to(root)\n    64\t    except ValueError as err:\n    65\t        raise ValueError(f\"path escapes project root: {path}\") from err\n    66\t    return resolved\n    67\t\n    68\t\n    69\tdef find_project_root(start: Path | None = None) -> Path | None:\n    70\t    \"\"\"Walk up from *start* (default cwd) looking for `.ken/meta.json`.\n    71\t\n    72\t    Returns the directory that contains `.ken/`, not the `.ken/` itself.\n    73\t    `KEN_PROJECT_ROOT` env var overrides discovery — useful for tests\n    74\t    and for hooks invoked with a wonky cwd.\n    75\t    \"\"\"\n    76\t    forced = os.environ.get(\"KEN_PROJECT_ROOT\")\n    77\t    if forced:\n    78\t        p = Path(forced).expanduser().resolve()\n    79\t        return p if meta_path(p).is_file() else None\n    80\t\n    81\t    cur = (start or Path.cwd()).resolve()\n    82\t    for parent in [cur, *cur.parents]:\n    83\t        if meta_path(parent).is_file():\n    84\t            return parent\n    85\t    return None\n   394\t        \"tools\",\n   395\t        help=\"invoke a ken MCP tool directly from the CLI\",\n   396\t        description=(\n   397\t            \"Run any tool the ken MCP server exposes, without an agent.\\n\\n\"\n   398\t            \"  ken tools                     list available tools\\n\"\n   399\t            \"  ken tools <name> --help       show a tool's parameters\\n\"\n   400\t            \"  ken tools <name> [ARGS...]    run the tool and print JSON\\n\\n\"\n   401\t            \"The <name> may be given with or without the 'ken_' prefix \"\n   402\t            \"(e.g. 'find' or 'ken_find'). Required parameters are positional; \"\n   403\t            \"optional ones are --flags mirroring the tool's schema.\"\n   404\t        ),\n   405\t        formatter_class=argparse.RawDescriptionHelpFormatter,\n   406\t    )\n   407\t    p_tools.add_argument(\"--path\", default=\".\", help=\"project path (default: cwd)\")\n   408\t    p_tools.add_argument(\n   409\t        \"--list\", action=\"store_true\", help=\"list available tools and exit\"\n   410\t    )\n   411\t    p_tools.add_argument(\n   412\t        \"--compact\", action=\"store_true\", help=\"print result as single-line JSON\"\n   413\t    )\n   414\t    p_tools.add_argument(\n   415\t        \"tool\", nargs=\"?\", help=\"tool name (with or without the ken_ prefix)\"\n   416\t    )\n   417\t    p_tools.add_argument(\n   418\t        \"tool_args\",\n   419\t        nargs=argparse.REMAINDER,\n   420\t        help=\"arguments for the tool; run `ken tools <name> --help` to see them\",\n   421\t    )\n   422\t\n   423\t    p_uninstall = sub.add_parser(\"uninstall\", help=\"remove ken hooks from a project\")\n   424\t    p_uninstall.add_argument(\n   425\t        \"path\", nargs=\"?\", default=\".\", help=\"project path (default: cwd)\"\n   603\t    if args.cmd == \"mcp\":\n   604\t        from ken.mcp.server import run as run_mcp\n   605\t\n   606\t        return run_mcp(Path(args.path))\n   607\t\n   608\t    if args.cmd == \"tools\":\n   609\t        return _tools_cli(\n   610\t            Path(args.path),\n   611\t            args.tool,\n   612\t            args.tool_args,\n   613\t            list_only=args.list,\n   614\t            compact=args.compact,\n   615\t        )\n   616\t\n   617\t    if args.cmd == \"uninstall\":\n   618\t        from ken.install_uninstall import uninstall\n   619\t\n   620\t        return uninstall(Path(args.path), keep_db=args.keep_db)\n   621\t\n   622\t    parser.error(f\"unknown command: {args.cmd}\")\n   623\t    return 2\n\"\"\"Direct semantic search over ken's code index.\"\"\"\n\nfrom __future__ import annotations\n\nimport re\nimport sqlite3\nimport subprocess\nfrom collections import Counter, defaultdict, deque\nfrom pathlib import Path\n\nimport numpy as np\n\nfrom ken.embedder import cosine_against, get_embedder, stack_embeddings\n\n\ndef search_files(\n    conn: sqlite3.Connection,\n    query: str,\n    limit: int = 8,\n    *,\n    project_root: Path | None = None,\n) -> list[dict]:\n    \"\"\"Return indexed files matching *query*.\n\n    Ordered by embedding cosine similarity, fused with a literal path/stem\n    match when the query is a bare identifier. ``score`` is always the cosine.\n    \"\"\"\n    q = _query_vec(query)\n    scored = _scored_from_store(\n        conn, \"ci_files\", q,\n        \"SELECT vec_slot, id, path, language FROM ci_files \"\n        \"WHERE vec_slot IN ({placeholders})\",\n        \"path\", project_root,\n    )\n    if scored is None:\n        rows = conn.execute(\n            \"SELECT id, path, language, embedding FROM ci_files WHERE embedding IS NOT NULL\"\n        ).fetchall()\n        rows = _filter_live_rows(rows, \"path\", project_root)\n        scored = _score_rows(q, rows)\n    ranked = _fuse_literal(\n        scored,\n        _identifier_query(query),\n        lambda r: (Path(r[\"path\"]).stem, Path(r[\"path\"]).name, r[\"path\"]),\n        limit,\n    )\n\n    file_ids = [int(row[\"id\"]) for _, row, _ in ranked]\n    outlines: dict[int, list[sqlite3.Row]] = defaultdict(list)\n    if file_ids:\n        select_outline = (\n            \"SELECT file_id, kind, name, line_start FROM (\"\n            \"SELECT file_id, kind, name, line_start FROM ci_symbols \"\n            \"WHERE file_id = ? ORDER BY line_start LIMIT 8)\"\n        )\n","exit_code":0,"status":"completed"}}
