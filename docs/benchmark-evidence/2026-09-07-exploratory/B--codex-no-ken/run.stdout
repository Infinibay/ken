", file=sys.stderr)\nsrc/ken/cli.py:1591:            except json.JSONDecodeError as exc:\nsrc/ken/cli.py:1677:        print(f\"error: unknown tool {tool_name!r}\", file=sys.stderr)\nsrc/ken/cli.py:1683:            print(f\"did you mean: {', '.join(suggestions)}\", file=sys.stderr)\nsrc/ken/cli.py:1685:            print(\"run `ken tools` to list available tools\", file=sys.stderr)\nsrc/ken/cli.py:1695:    root = _paths.find_project_root(project_path.resolve()) or project_path.resolve()\nsrc/ken/cli.py:1697:        print(f\"error: no .ken project at {root}\", file=sys.stderr)\nsrc/ken/cli.py:1707:    except Exception as exc:  # surface tool errors as a clean CLI failure\nsrc/ken/cli.py:1708:        print(f\"error: {tool.name} failed: {exc}\", file=sys.stderr)\nsrc/ken/cli.py:1810:def _resolve_project_db(project_path: Path) -> tuple[Path, Path | None]:\nsrc/ken/cli.py:1813:    root = _paths.find_project_root(project_path.resolve()) or project_path.resolve()\nsrc/ken/hook.py:8:  * If we can't find a project, we print to stderr and exit 0 — the\nsrc/ken/hook.py:34:    root = _paths.find_project_root()\nsrc/ken/hook.py:36:        print(\"ken: no .ken project at or above cwd, skipping hook\", file=sys.stderr)\nsrc/ken/hook.py:42:        print(\"ken: hook payload missing session_id; skipping\", file=sys.stderr)\nsrc/ken/hook.py:87:            print(f\"ken: unknown hook subcommand: {args.hook_cmd}\", file=sys.stderr)\nsrc/ken/hook.py:89:    except Exception as exc:  # pragma: no cover - belt + suspenders\nsrc/ken/hook.py:90:        print(f\"ken: hook error ({args.hook_cmd}): {exc}\", file=sys.stderr)\nsrc/ken/hook.py:143:    except OSError:\nsrc/ken/hook.py:152:        except json.JSONDecodeError:\n\"\"\"Project root discovery + path helpers.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\nimport pytest\n\nfrom ken import _paths\n\n\ndef test_find_project_root_walks_up(tmp_path):\n    root = tmp_path / \"proj\"\n    (root / \".ken\").mkdir(parents=True)\n    (root / \".ken\" / \"meta.json\").write_text(\"{}\")\n    nested = root / \"a\" / \"b\" / \"c\"\n    nested.mkdir(parents=True)\n    found = _paths.find_project_root(start=nested)\n    assert found is not None\n    assert found.resolve() == root.resolve()\n\n\ndef test_find_project_root_returns_none_when_missing(tmp_path):\n    \"\"\"Plain temp dir with no .ken/ above it → None.\"\"\"\n    # Save & restore env to avoid bleeding into other tests.\n    saved = os.environ.pop(\"KEN_PROJECT_ROOT\", None)\n    try:\n        # Use a path that's guaranteed to not have .ken in any ancestor.\n        result = _paths.find_project_root(start=tmp_path)\n        # Walking up may eventually hit a real .ken/ on the dev machine —\n        # we only guarantee that without one it'd be None. Accept either.\n        if result is not None:\n            # If it found something, at least confirm it's a valid project root.\n            assert _paths.meta_path(result).is_file()\n    finally:\n        if saved is not None:\n            os.environ[\"KEN_PROJECT_ROOT\"] = saved\n\n\ndef test_find_project_root_respects_env_var(tmp_path, monkeypatch):\n    root = tmp_path / \"envproj\"\n    (root / \".ken\").mkdir(parents=True)\n    (root / \".ken\" / \"meta.json\").write_text(\"{}\")\n    monkeypatch.setenv(\"KEN_PROJECT_ROOT\", str(root))\n    # Even if start= points elsewhere, env var wins.\n    other = tmp_path / \"other\"\n    other.mkdir()\n    found = _paths.find_project_root(start=other)\n    assert found is not None\n    assert found.resolve() == root.resolve()\n\n\ndef test_env_var_with_invalid_path_returns_none(tmp_path, monkeypatch):\n    \"\"\"Env var pointing somewhere with no meta.json → None (not a fallback).\"\"\"\n    nowhere = tmp_path / \"nowhere\"\n    nowhere.mkdir()\n    monkeypatch.setenv(\"KEN_PROJECT_ROOT\", str(nowhere))\n    assert _paths.find_project_root() is None\n\n\ndef test_path_helpers_compose(tmp_path):\n    root = tmp_path\n    assert _paths.ken_dir(root) == root / \".ken\"\n    assert _paths.meta_path(root) == root / \".ken\" / \"meta.json\"\n    assert _paths.db_path(root) == root / \".ken\" / \"ken.db\"\n    assert _paths.port_path(root) == root / \".ken\" / \"daemon.port\"\n    assert _paths.pid_path(root) == root / \".ken\" / \"daemon.pid\"\n    assert _paths.log_path(root) == root / \".ken\" / \"daemon.log\"\n\n\n@pytest.mark.parametrize(\"absolute\", [False, True])\ndef test_resolve_project_path_accepts_internal_path(tmp_path, absolute):\n    root = tmp_path / \"project\"\n    source = root / \"src\" / \"module.py\"\n    source.parent.mkdir(parents=True)\n    source.write_text(\"\", encoding=\"utf-8\")\n\n    supplied = source if absolute else Path(\"src/module.py\")\n\n    assert _paths.resolve_project_path(root, supplied) == source.resolve()\n\n\ndef test_resolve_project_path_rejects_parent_traversal(tmp_path):\n    root = tmp_path / \"project\"\n    root.mkdir()\n\n    with pytest.raises(ValueError, match=r\"^path escapes project root: \"):\n        _paths.resolve_project_path(root, \"../outside.py\")\n\n\ndef test_resolve_project_path_rejects_absolute_external_path(tmp_path):\n    root = tmp_path / \"project\"\n    root.mkdir()\n    outside = tmp_path / \"outside.py\"\n\n    with pytest.raises(ValueError, match=r\"^path escapes project root: \"):\n        _paths.resolve_project_path(root, outside)\n\n\ndef test_resolve_project_path_rejects_symlink_escape(tmp_path):\n    root = tmp_path / \"project\"\n    root.mkdir()\n    outside = tmp_path / \"outside\"\n    outside.mkdir()\n    (root / \"linked\").symlink_to(outside, target_is_directory=True)\n\n    with pytest.raises(ValueError, match=r\"^path escapes project root: \"):\n        _paths.resolve_project_path(root, \"linked/secret.py\")\n\"\"\"Daemon helpers that don't need the HTTP layer: cited-paths extraction.\"\"\"\n\nfrom __future__ import annotations\n\nimport sqlite3\nfrom pathlib import Path\n\nimport pytest\n\nfrom ken.daemon.server import _classify_tool, _extract_cited_paths\nfrom ken.db import init_schema\n\n\n@pytest.fixture\ndef conn():\n    c = sqlite3.connect(\":memory:\")\n    c.row_factory = sqlite3.Row\n    init_schema(c)\n    return c\n\n\ndef _index_file(conn, path: str) -> None:\n    conn.execute(\n        \"INSERT INTO ci_files(path, content_hash, mtime, indexed_at) VALUES (?, ?, ?, ?)\",\n        (path, b\"\\x00\" * 32, 0, 0),\n    )\n\n\ndef test_extract_full_path_match(conn):\n    _index_file(conn, \"src/auth.py\")\n    text = \"I edited src/auth.py to fix the bug.\"\n    assert _extract_cited_paths(conn, text) == [\"src/auth.py\"]\n\n\ndef test_extract_dedupes_repeated_mentions(conn):\n    _index_file(conn, \"src/auth.py\")\n    text = \"src/auth.py and src/auth.py and again src/auth.py.\"\n    assert _extract_cited_paths(conn, text) == [\"src/auth.py\"]\n\n\ndef test_extract_bare_filename_resolves_when_unique(conn):\n    _index_file(conn, \"src/deep/nested/module.py\")\n    text = \"Look at module.py for details.\"\n    assert _extract_cited_paths(conn, text) == [\"src/deep/nested/module.py\"]\n\n\ndef test_extract_bare_filename_skipped_when_ambiguous(conn):\n    \"\"\"If multiple ci_files end with the bare name, we skip — too risky.\"\"\"\n    _index_file(conn, \"src/a/util.py\")\n    _index_file(conn, \"src/b/util.py\")\n    text = \"Check util.py somewhere.\"\n    assert _extract_cited_paths(conn, text) == []\n\n\ndef test_extract_filters_unknown_extension(conn):\n    _index_file(conn, \"src/auth.py\")\n    text = \"binary blob.exe and config.bin should not match\"\n    assert _extract_cited_paths(conn, text) == []\n\n\ndef test_extract_filters_unindexed_files(conn):\n    \"\"\"Path-shaped tokens that don't exist in ci_files don't make it through.\"\"\"\n    _index_file(conn, \"src/auth.py\")\n    text = \"ghost/file.py is mentioned but not indexed.\"\n    assert _extract_cited_paths(conn, text) == []\n\n\ndef test_extract_handles_path_with_line_number(conn):\n    _index_file(conn, \"src/auth.py\")\n    text = \"the bug is at src/auth.py:42 in login()\"\n    assert _extract_cited_paths(conn, text) == [\"src/auth.py\"]\n\n\ndef test_extract_empty_input(conn):\n    assert _extract_cited_paths(conn, \"\") == []\n    assert _extract_cited_paths(conn, \"no paths here\") == []\n\n\ndef test_classify_codex_function_tools():\n    assert _classify_tool(\"functions.apply_patch\", {\"file_path\": \"src/a.py\"}) == (\n        \"edit\",\n        \"src/a.py\",\n    )\n    assert _classify_tool(\n        \"functions.exec_command\",\n        {\"cmd\": \"sed -n '1,80p' src/ken/status.py\", \"workdir\": \".\"},\n    ) == (\"read\", \"src/ken/status.py\")\n    assert _classify_tool(\"functions.apply_patch\", \"raw patch text\") == (\"edit\", None)\n\n\ndef test_classify_extracts_patch_paths_from_text():\n    patch = \"*** Begin Patch\\n*** Update File: src/ken/status.py\\n@@\\n\"\n    assert _classify_tool(\"functions.apply_patch\", patch) == (\"edit\", \"src/ken/status.py\")\n\n\ndef test_classify_exec_command_falls_back_to_workdir():\n    assert _classify_tool(\"functions.exec_command\", {\"cmd\": \"uv run pytest\", \"workdir\": \".\"}) == (\n        \"read\",\n        \".\",\n    )\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/ken/serve.py; nl -ba src/ken/hook.py | head -100; nl -ba src/ken/mcp/server.py | sed -n '90,165p'; nl -ba src/ken/daemon/server.py | sed -n '1050,1205p'; nl -ba src/ken/status.py | head -100; rg -n 'client|spawn|timeout|missing|unreachable' tests/test_hook.py tests/test_mcp_startup.py tests/test_cli_rank.py; nl -ba src/ken/cli.py | sed -n '710,770p;1800,1825p'; rg -n 'meta|auth_token|def install' src/ken/install.py; ls -d .venv\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/ken/serve.py; nl -ba src/ken/hook.py | head -100; nl -ba src/ken/mcp/server.py | sed -n '90,165p'; nl -ba src/ken/daemon/server.py | sed -n '1050,1205p'; nl -ba src/ken/status.py | head -100; rg -n 'client|spawn|timeout|missing|unreachable' tests/test_hook.py tests/test_mcp_startup.py tests/test_cli_rank.py; nl -ba src/ken/cli.py | sed -n '710,770p;1800,1825p'; rg -n 'meta|auth_token|def install' src/ken/install.py; ls -d .venv\"","aggregated_output":"     1\t\"\"\"`ken serve` entrypoint.\"\"\"\n     2\t\n     3\tfrom __future__ import annotations\n     4\t\n     5\timport logging\n     6\timport sys\n     7\tfrom pathlib import Path\n     8\t\n     9\tfrom ken import _paths\n    10\tfrom ken.daemon.server import run as run_server\n    11\t\n    12\t\n    13\tdef serve(start: Path, *, background: bool = False) -> int:\n    14\t    root = _paths.find_project_root(start.resolve()) or start.resolve()\n    15\t    if not _paths.meta_path(root).is_file():\n    16\t        print(f\"no ken project at {root} — run `ken install .` first\", file=sys.stderr)\n    17\t        return 1\n    18\t\n    19\t    if background:\n    20\t        # When spawned by a hook we want a friendly file log; otherwise\n    21\t        # foreground mode logs to stderr so `ken serve` in a terminal is\n    22\t        # interactive-debuggable.\n    23\t        logging.basicConfig(\n    24\t            filename=str(_paths.log_path(root)),\n    25\t            level=logging.INFO,\n    26\t            format=\"%(asctime)s %(levelname)s %(name)s %(message)s\",\n    27\t        )\n    28\t    else:\n    29\t        logging.basicConfig(\n    30\t            level=logging.INFO,\n    31\t            format=\"%(asctime)s %(levelname)s %(name)s %(message)s\",\n    32\t        )\n    33\t\n    34\t    return run_server(root)\n     1\t\"\"\"Short-lived hook shims invoked by supported coding agents.\n     2\t\n     3\tEach `ken hook ...` subcommand reads the agent's JSON event payload from\n     4\tstdin, finds the installed project via walk-up, and POSTs an event to\n     5\tthe per-project daemon, spawning it if needed.\n     6\t\n     7\tHooks **never** raise to the caller:\n     8\t  * If we can't find a project, we print to stderr and exit 0 — the\n     9\t    user just isn't in a ken-installed project.\n    10\t  * If the daemon can't be reached after a spawn attempt, we log\n    11\t    silently and exit 0 — keeping ken from blocking the agent is more\n    12\t    important than capturing every event.\n    13\t\n    14\tStdout is reserved for hook-driven context injection. On\n    15\t`UserPromptSubmit`, the daemon may return a `<context-rank>` block and\n    16\tthe hook prints only that block so the host CLI can prepend it to the\n    17\tmodel-visible prompt.\n    18\t\"\"\"\n    19\t\n    20\tfrom __future__ import annotations\n    21\t\n    22\timport argparse\n    23\timport json\n    24\timport sys\n    25\tfrom pathlib import Path\n    26\tfrom typing import Any\n    27\t\n    28\tfrom ken import _paths\n    29\tfrom ken.cli import _read_hook_payload\n    30\tfrom ken.daemon import client\n    31\t\n    32\t\n    33\tdef dispatch_hook(args: argparse.Namespace) -> int:\n    34\t    root = _paths.find_project_root()\n    35\t    if root is None:\n    36\t        print(\"ken: no .ken project at or above cwd, skipping hook\", file=sys.stderr)\n    37\t        return 0\n    38\t\n    39\t    payload = _read_hook_payload()\n    40\t    session_id = _session_id(payload)\n    41\t    if not session_id:\n    42\t        print(\"ken: hook payload missing session_id; skipping\", file=sys.stderr)\n    43\t        return 0\n    44\t\n    45\t    try:\n    46\t        if args.hook_cmd == \"session-start\":\n    47\t            resp = client.post(\n    48\t                root, \"/sessions/start\", {\"session_id\": session_id, \"cwd\": payload.get(\"cwd\")}\n    49\t            )\n    50\t            # The daemon returns a resume brief (\"where you left off\").\n    51\t            # Print it to stdout so the host CLI injects it as the new\n    52\t            # session's context — no recall call from the model required.\n    53\t            block = (resp or {}).get(\"context_block\") or \"\"\n    54\t            if block.strip():\n    55\t                sys.stdout.write(block)\n    56\t        elif args.hook_cmd == \"session-end\":\n    57\t            client.post(root, \"/sessions/end\", {\"session_id\": session_id})\n    58\t        elif args.hook_cmd == \"user-prompt\":\n    59\t            resp = client.post(\n    60\t                root,\n    61\t                \"/prompts\",\n    62\t                {\"session_id\": session_id, \"prompt\": payload.get(\"prompt\", \"\")},\n    63\t            )\n    64\t            # The daemon may want to inject context — print it to stdout so\n    65\t            # the host CLI prepends it to the model's view of the prompt.\n    66\t            block = (resp or {}).get(\"context_block\") or \"\"\n    67\t            if block.strip():\n    68\t                sys.stdout.write(block)\n    69\t        elif args.hook_cmd == \"tool-call\":\n    70\t            phase_path = \"/tools/pre\" if args.phase == \"pre\" else \"/tools/post\"\n    71\t            client.post(root, phase_path, _tool_call_body(session_id, args.phase, payload))\n    72\t        elif args.hook_cmd == \"stop\":\n    73\t            # Codex passes ``last_assistant_message`` directly in the\n    74\t            # payload; Claude Code passes a ``transcript_path`` we tail-\n    75\t            # read. Prefer the direct field when present.\n    76\t            direct = payload.get(\"last_assistant_message\")\n    77\t            if isinstance(direct, str) and direct:\n    78\t                assistant_text = direct\n    79\t            else:\n    80\t                assistant_text = _extract_last_assistant_text(payload.get(\"transcript_path\"))\n    81\t            client.post(\n    82\t                root,\n    83\t                \"/turn-end\",\n    84\t                {\"session_id\": session_id, \"assistant_text\": assistant_text},\n    85\t            )\n    86\t        else:\n    87\t            print(f\"ken: unknown hook subcommand: {args.hook_cmd}\", file=sys.stderr)\n    88\t            return 0\n    89\t    except Exception as exc:  # pragma: no cover - belt + suspenders\n    90\t        print(f\"ken: hook error ({args.hook_cmd}): {exc}\", file=sys.stderr)\n    91\t    return 0\n    92\t\n    93\t\n    94\tdef _session_id(payload: dict[str, Any]) -> str | None:\n    95\t    sid = payload.get(\"session_id\")\n    96\t    if isinstance(sid, str) and sid:\n    97\t        return sid\n    98\t    return None\n    99\t\n   100\t\n    90\t\n    91\tdef run(start: Path) -> int:\n    92\t    \"\"\"Resolve the project root, then hand control to the MCP stdio loop.\"\"\"\n    93\t    global _PROJECT_ROOT\n    94\t    root = _paths.find_project_root(start.resolve()) or start.resolve()\n    95\t    if not _paths.meta_path(root).is_file():\n    96\t        print(f\"ken mcp: no .ken project at {root}\", file=sys.stderr)\n    97\t        return 1\n    98\t    _PROJECT_ROOT = root\n    99\t    logging.basicConfig(\n   100\t        stream=sys.stderr,\n   101\t        level=logging.INFO,\n   102\t        format=\"%(asctime)s %(levelname)s %(name)s %(message)s\",\n   103\t    )\n   104\t    logger.info(\"ken mcp ready project_root=%s\", root)\n   105\t    mcp.run(transport=\"stdio\")\n   106\t    return 0\n   107\t\n   108\t\n   109\t# ---- CLI tool registry --------------------------------------------------\n   110\t#\n   111\t# ``ken tools ...`` (the shell-side passthrough) reads tool names,\n   112\t# descriptions, and parameter schemas from this registry so it does not\n   113\t# need to spin up the MCP stdio loop just to print ``--help`` text. We\n   114\t# mirror each ``@mcp.tool()`` registration into ``_REGISTRY`` via the\n   115\t# ``_register`` helper below.\n   116\t\n   117\t\n   118\t@dataclass\n   119\tclass ToolDef:\n   120\t    \"\"\"Lightweight record of a registered MCP tool.\n   121\t\n   122\t    Mirrors the public surface of the old ``fastmcp.Tool`` object that\n   123\t    ``ken tools ...`` was reading via ``mcp._tool_manager.list_tools()``:\n   124\t    ``name``, ``description``, ``parameters`` (JSON schema), ``fn``, and\n   125\t    ``is_async``.\n   126\t    \"\"\"\n   127\t\n   128\t    name: str\n   129\t    description: str\n   130\t    fn: Callable[..., Any]\n   131\t    is_async: bool\n   132\t    parameters: dict[str, Any]\n   133\t    input_schema: dict[str, Any]\n   134\t\n   135\t\n   136\t_REGISTRY: dict[str, ToolDef] = {}\n   137\t\n   138\t\n   139\tdef _register(fn: Callable[..., Any]) -> Callable[..., Any]:\n   140\t    \"\"\"Build a ``ToolDef`` from a function and stash it in ``_REGISTRY``.\n   141\t\n   142\t    The function name becomes the tool name (callers use the\n   143\t    ``ken_foo`` convention themselves). The JSON schema is derived from\n   144\t    the function's signature — annotations become ``properties``,\n   145\t    parameters with defaults become optional, the rest required. This is\n   146\t    the same shape the SDK derives internally, so any agent that reads\n   147\t    those schemas sees the same surface either way.\n   148\t    \"\"\"\n   149\t    sig = inspect.signature(fn)\n   150\t    # Resolve string annotations (``from __future__ import annotations``\n   151\t    # makes every annotation a forward-reference string at runtime; we\n   152\t    # need the real type object to map it to a JSON schema).\n   153\t    # ``inspect.get_annotations(..., eval_str=True)`` evaluates those\n   154\t    # strings against the function's own ``__globals__``, which is what\n   155\t    # the SDK does internally to build its own tool schema.\n   156\t    try:\n   157\t        hints = inspect.get_annotations(fn, eval_str=True)\n   158\t    except Exception:\n   159\t        # Fallback for unresolvable forward refs: leave the annotation as-is.\n   160\t        hints = {}\n   161\t    properties: dict[str, Any] = {}\n   162\t    required: list[str] = []\n   163\t    for name, param in sig.parameters.items():\n   164\t        if name == \"self\":\n   165\t            continue\n  1050\t        super().__init__(addr, _Handler)\n  1051\t        self.state = state\n  1052\t\n  1053\t\n  1054\tdef run(project_root: Path) -> int:\n  1055\t    \"\"\"Daemon entrypoint. Binds a free localhost port, advertises it via\n  1056\t    ``.ken/daemon.port``, serves until idle / empty / explicit shutdown.\n  1057\t    \"\"\"\n  1058\t    project_root = project_root.resolve()\n  1059\t    meta_p = _paths.meta_path(project_root)\n  1060\t    if not meta_p.is_file():\n  1061\t        print(f\"ken: no .ken/meta.json at {project_root}\", flush=True)\n  1062\t        return 2\n  1063\t    meta = json.loads(meta_p.read_text(encoding=\"utf-8\"))\n  1064\t    state = DaemonState(project_root, meta[\"auth_token\"])\n  1065\t    set_meta(state.conn, \"ken_version\", _ken_version())\n  1066\t\n  1067\t    server = _ThreadingServer((\"127.0.0.1\", 0), state)\n  1068\t    bound_port = server.server_address[1]\n  1069\t    _write_runtime_files(project_root, port=bound_port, pid=os.getpid())\n  1070\t\n  1071\t    logger.info(\n  1072\t        \"ken daemon ready project_root=%s pid=%s port=%s\",\n  1073\t        project_root,\n  1074\t        os.getpid(),\n  1075\t        bound_port,\n  1076\t    )\n  1077\t\n  1078\t    # Start accepting HTTP before background maintenance. On very large\n  1079\t    # repositories the warm pass can take longer than the hook client's\n  1080\t    # spawn wait; serving first keeps /health responsive and prevents a\n  1081\t    # false \"daemon unreachable\" on first prompt.\n  1082\t    sd_watcher = threading.Thread(target=_shutdown_watcher, args=(state,), daemon=True)\n  1083\t    sd_watcher.start()\n  1084\t    serve_thread = threading.Thread(target=server.serve_forever, daemon=True)\n  1085\t    serve_thread.start()\n  1086\t\n  1087\t    maintenance: dict[str, Any] = {}\n  1088\t    maintenance_thread = threading.Thread(\n  1089\t        target=_maintenance_loop,\n  1090\t        args=(state, maintenance),\n  1091\t        name=\"ken-maintenance-startup\",\n  1092\t        daemon=True,\n  1093\t    )\n  1094\t    maintenance_thread.start()\n  1095\t\n  1096\t    state.shutdown_event.wait()\n  1097\t    logger.info(\"ken daemon shutting down\")\n  1098\t    _finalize_active_sessions(state)\n  1099\t    server.shutdown()\n  1100\t    server.server_close()\n  1101\t    file_watcher = maintenance.get(\"file_watcher\")\n  1102\t    if file_watcher is not None:\n  1103\t        file_watcher.stop()\n  1104\t    index_queue = maintenance.get(\"index_queue\")\n  1105\t    if index_queue is not None:\n  1106\t        index_queue.stop()\n  1107\t    maintenance_thread.join(timeout=5.0)\n  1108\t    state.conn.close()\n  1109\t    _clear_runtime_files(project_root)\n  1110\t    return 0\n  1111\t\n  1112\t\n  1113\tdef _maintenance_loop(state: DaemonState, holder: dict[str, Any]) -> None:\n  1114\t    if state.shutdown_event.wait(MAINTENANCE_START_DELAY_S):\n  1115\t        return\n  1116\t\n  1117\t    project_root = state.project_root\n  1118\t    # Index queue + file watcher run in their own threads with their own\n  1119\t    # SQLite connections. We start the queue first so the watcher's first\n  1120\t    # events have a worker to hand off to.\n  1121\t    #\n  1122\t    # The embedder is the *singleton* — `get_embedder()` returns the same\n  1123\t    # instance the request handlers use for cr_contexts embeddings, so we\n  1124\t    # only pay one model-load cost per process.\n  1125\t    index_queue = IndexQueue(project_root, embedder=get_embedder())\n  1126\t    if state.shutdown_event.is_set():\n  1127\t        return\n  1128\t    index_queue.start()\n  1129\t    holder[\"index_queue\"] = index_queue\n  1130\t\n  1131\t    file_watcher = FileWatcher(project_root, index_queue)\n  1132\t    file_watcher.start()\n  1133\t    holder[\"file_watcher\"] = file_watcher\n  1134\t\n  1135\t    # Warm pass: enqueue every gitignore-respecting file. The indexer\n  1136\t    # short-circuits on content_hash so this is cheap on a clean DB —\n  1137\t    # but it catches anything that changed while the daemon was dead\n  1138\t    # (between sessions, after a `git pull`, …).\n  1139\t    warm_count = 0\n  1140\t    for rel in iter_files(project_root):\n  1141\t        if state.shutdown_event.is_set():\n  1142\t            break\n  1143\t        index_queue.reindex(rel.as_posix())\n  1144\t        warm_count += 1\n  1145\t    logger.info(\"warm pass: queued %s files for hash-skip / reindex\", warm_count)\n  1146\t\n  1147\t\n  1148\tdef _shutdown_watcher(state: DaemonState) -> None:\n  1149\t    while not state.shutdown_event.is_set():\n  1150\t        if state.shutdown_event.wait(SHUTDOWN_TICK_S):\n  1151\t            return\n  1152\t        reason = state.should_shutdown()\n  1153\t        if reason is not None:\n  1154\t            logger.info(\"shutdown trigger: %s\", reason)\n  1155\t            state.shutdown_event.set()\n  1156\t            return\n  1157\t\n  1158\t\n  1159\tdef _finalize_active_sessions(state: DaemonState) -> None:\n  1160\t    \"\"\"Snapshot and close any sessions still active when the daemon exits.\"\"\"\n  1161\t    with state.lock:\n  1162\t        agent_ids = list(state.sessions)\n  1163\t    for agent_id in agent_ids:\n  1164\t        _handle_session_end(state, agent_id)\n  1165\t\n  1166\t\n  1167\tdef _write_runtime_files(project_root: Path, *, port: int, pid: int) -> None:\n  1168\t    _paths.port_path(project_root).write_text(str(port), encoding=\"utf-8\")\n  1169\t    _paths.pid_path(project_root).write_text(str(pid), encoding=\"utf-8\")\n  1170\t\n  1171\t\n  1172\tdef _clear_runtime_files(project_root: Path) -> None:\n  1173\t    for p in (_paths.port_path(project_root), _paths.pid_path(project_root)):\n  1174\t        try:\n  1175\t            p.unlink()\n  1176\t        except OSError:\n  1177\t            pass\n  1178\t\n  1179\t\n  1180\tdef _read_project_id(project_root: Path) -> str:\n  1181\t    try:\n  1182\t        meta = json.loads(_paths.meta_path(project_root).read_text(encoding=\"utf-8\"))\n  1183\t        return str(meta.get(\"project_id\", \"?\"))\n  1184\t    except OSError:\n  1185\t        return \"?\"\n  1186\t\n  1187\t\n  1188\tdef _ken_version() -> str:\n  1189\t    from ken import __version__\n  1190\t\n  1191\t    return __version__\n     1\t\"\"\"Project health report for ken's index, memory, and daemon state.\"\"\"\n     2\t\n     3\tfrom __future__ import annotations\n     4\t\n     5\timport json\n     6\timport sys\n     7\tfrom dataclasses import dataclass\n     8\tfrom pathlib import Path\n     9\t\n    10\tfrom ken import _paths\n    11\tfrom ken.db import connect\n    12\t\n    13\t\n    14\t@dataclass(frozen=True)\n    15\tclass StatusCounts:\n    16\t    files: int\n    17\t    files_embedded: int\n    18\t    symbols: int\n    19\t    symbols_embedded: int\n    20\t    sessions: int\n    21\t    active_sessions: int\n    22\t    contexts: int\n    23\t    prompt_contexts: int\n    24\t    prompt_contexts_embedded: int\n    25\t    interactions: int\n    26\t    session_scores: int\n    27\t    findings: int\n    28\t    findings_embedded: int\n    29\t    intent_sources: int\n    30\t    intent_sources_embedded: int\n    31\t\n    32\t\n    33\tdef show_status(start: Path, *, as_json: bool = False) -> int:\n    34\t    report = status_report(start)\n    35\t    if not report[\"ok\"]:\n    36\t        if as_json:\n    37\t            print(json.dumps(report, indent=2))\n    38\t        else:\n    39\t            print(report[\"error\"], file=sys.stderr)\n    40\t            print(\"hint: `ken install .` from a project root\", file=sys.stderr)\n    41\t        return 1\n    42\t    if as_json:\n    43\t        print(json.dumps(report, indent=2))\n    44\t        return 0\n    45\t    _print_report(report)\n    46\t    return 0\n    47\t\n    48\t\n    49\tdef status_report(start: Path) -> dict:\n    50\t    \"\"\"Return a JSON-serialisable status report for humans and agents.\"\"\"\n    51\t    root = _paths.find_project_root(start.resolve())\n    52\t    if root is None:\n    53\t        return {\n    54\t            \"ok\": False,\n    55\t            \"error\": f\"no ken project found at or above {start.resolve()}\",\n    56\t        }\n    57\t\n    58\t    meta = json.loads(_paths.meta_path(root).read_text(encoding=\"utf-8\"))\n    59\t    db_p = _paths.db_path(root)\n    60\t    base = {\n    61\t        \"ok\": True,\n    62\t        \"project_root\": str(root),\n    63\t        \"project_id\": meta[\"project_id\"],\n    64\t        \"db\": {\n    65\t            \"path\": str(db_p),\n    66\t            \"size\": _human_size(db_p),\n    67\t            \"exists\": db_p.is_file(),\n    68\t        },\n    69\t    }\n    70\t\n    71\t    if not db_p.is_file():\n    72\t        return {**base, \"installed\": False}\n    73\t\n    74\t    counts = _read_counts(db_p)\n    75\t    index_health = _index_health(root, db_p)\n    76\t    return {\n    77\t        **base,\n    78\t        \"installed\": True,\n    79\t        \"counts\": counts.__dict__,\n    80\t        \"index_health\": index_health,\n    81\t        \"rank_signals\": _rank_signals(counts),\n    82\t        \"embedding_coverage\": _embedding_coverage(counts),\n    83\t        \"recommendations\": _recommendations(counts, index_health),\n    84\t        \"daemon\": _daemon_health(root),\n    85\t    }\n    86\t\n    87\t\n    88\tdef _print_report(report: dict) -> None:\n    89\t    print(f\"project_root  : {report['project_root']}\")\n    90\t    print(f\"project_id    : {report['project_id']}\")\n    91\t    print(f\"db            : {report['db']['path']}  ({report['db']['size']})\")\n    92\t    if not report.get(\"installed\"):\n    93\t        print(\"(no DB yet — run `ken install .`)\")\n    94\t        return\n    95\t    counts = report[\"counts\"]\n    96\t    print(f\"files indexed : {counts['files']} ({counts['files_embedded']} embedded)\")\n    97\t    print(f\"symbols       : {counts['symbols']} ({counts['symbols_embedded']} embedded)\")\n    98\t    print(\n    99\t        f\"sessions      : {counts['sessions']} total, {counts['active_sessions']} active, \"\n   100\t        f\"{counts['session_scores']} scored\"\ntests/test_mcp_startup.py:45:def test_mcp_server_exits_with_remediation_when_mcpserver_missing(capsys):\ntests/test_cli_rank.py:17:    monkeypatch.setattr(\"ken.daemon.client.post\", fake_post)\ntests/test_cli_rank.py:47:    monkeypatch.setattr(\"ken.daemon.client.post\", fake_post)\ntests/test_cli_rank.py:60:        \"ken.daemon.client.post\",\ntests/test_cli_rank.py:85:    monkeypatch.setattr(\"ken.daemon.client.post\", fake_post)\ntests/test_cli_rank.py:101:        \"ken.daemon.client.post\",\ntests/test_cli_rank.py:118:    monkeypatch.setattr(\"ken.daemon.client.post\", fake_post)\ntests/test_cli_rank.py:130:        \"ken.daemon.client.post\",\ntests/test_hook.py:18:def test_session_id_returns_none_for_missing_or_wrong_type():\ntests/test_hook.py:134:def test_extract_handles_missing_file():\n   710\t    raw = sys.stdin.read()\n   711\t    if not raw.strip():\n   712\t        return {}\n   713\t    try:\n   714\t        return json.loads(raw)\n   715\t    except json.JSONDecodeError:\n   716\t        return {}\n   717\t\n   718\t\n   719\tdef _rank_cli(\n   720\t    project_path: Path,\n   721\t    query: str,\n   722\t    verbose: int,\n   723\t    *,\n   724\t    max_chars: int | None,\n   725\t    as_json: bool,\n   726\t    stats: bool,\n   727\t) -> int:\n   728\t    from ken.daemon import client as daemon_client\n   729\t\n   730\t    payload: dict[str, Any] = {\"query\": query.strip(), \"verbose\": verbose}\n   731\t    if max_chars is not None:\n   732\t        payload[\"max_chars\"] = max_chars\n   733\t    resp = daemon_client.post(\n   734\t        project_path.resolve(),\n   735\t        \"/rank\",\n   736\t        payload,\n   737\t    )\n   738\t    return _print_daemon_response(resp, \"context_block\", as_json=as_json, stats=stats)\n   739\t\n   740\t\n   741\tdef _explain_cli(project_path: Path, query: str, *, as_json: bool) -> int:\n   742\t    from ken.daemon import client as daemon_client\n   743\t\n   744\t    resp = daemon_client.post(\n   745\t        project_path.resolve(), \"/explain\", {\"query\": query.strip()}\n   746\t    )\n   747\t    return _print_daemon_response(resp, None, as_json=as_json)\n   748\t\n   749\t\n   750\tdef _print_daemon_response(\n   751\t    resp: dict[str, Any] | None,\n   752\t    text_key: str | None,\n   753\t    *,\n   754\t    as_json: bool,\n   755\t    stats: bool = False,\n   756\t) -> int:\n   757\t    if resp is None:\n   758\t        print(\"error: daemon unreachable\", file=sys.stderr)\n   759\t        return 1\n   760\t    if as_json:\n   761\t        print(json.dumps(resp, indent=2))\n   762\t        return 0 if resp.get(\"ok\") else 1\n   763\t    if not resp.get(\"ok\"):\n   764\t        print(f\"error: {resp.get('error', 'request failed')}\", file=sys.stderr)\n   765\t        return 1\n   766\t    if text_key:\n   767\t        print(resp.get(text_key, \"\"))\n   768\t        if stats:\n   769\t            print(_format_rank_stats(resp), file=sys.stderr)\n   770\t    else:\n  1800\t                parser.add_argument(\n  1801\t                    flag,\n  1802\t                    dest=name,\n  1803\t                    type=py_type,\n  1804\t                    default=default,\n  1805\t                    help=f\"{json_type or 'string'} (default: {default!r})\",\n  1806\t                )\n  1807\t    return parser\n  1808\t\n  1809\t\n  1810\tdef _resolve_project_db(project_path: Path) -> tuple[Path, Path | None]:\n  1811\t    from ken import _paths\n  1812\t\n  1813\t    root = _paths.find_project_root(project_path.resolve()) or project_path.resolve()\n  1814\t    db_path = _paths.db_path(root)\n  1815\t    return root, db_path if db_path.is_file() else None\n5:  2. Generate a project_id (uuid) + auth token, persist to `.ken/meta.json`.\n42:from ken.db import connect, init_schema, set_meta\n92:def install(\n105:    ``no_wire=True`` indexes the project and provisions ``.ken/`` (meta,\n120:    # Step 1: meta.json — generate a project id + auth token if missing.\n121:    meta_p = _paths.meta_path(root)\n122:    if meta_p.is_file():\n123:        meta = json.loads(meta_p.read_text(encoding=\"utf-8\"))\n125:            print(f\"[meta] reusing existing project_id={meta['project_id']}\")\n127:        meta = {\n129:            \"auth_token\": secrets.token_urlsafe(32),\n133:        meta_p.write_text(json.dumps(meta, indent=2) + \"\\n\", encoding=\"utf-8\")\n135:            print(f\"[meta] created .ken/meta.json (project_id={meta['project_id']})\")\n143:        set_meta(conn, \"project_id\", meta[\"project_id\"])\n144:        set_meta(conn, \"ken_version\", _ken_version())\n280:        project_id=meta[\"project_id\"],\nls: .venv: No such file or directory\n","exit_code":1,"status":"failed"}}
{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"La búsqueda usa `.ken/meta.json` como marcador y sube por los directorios padre. Encontré una diferencia relevante: los hooks, `serve` y MCP buscan esa raíz, pero `rank` y `explain` pasan la ruta recibida directamente al cliente. Voy a comprobar también cuándo se relanza el servicio y cómo se informa una instalación incompleta.\n"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/ken/cli.py | sed -n '430,500p;550,625p'; rg -n 'daemon_client|client.post|unreachable|def _daemon_health' src/ken/mcp/server.py src/ken/status.py; nl -ba src/ken/daemon/server.py | sed -n '75,100p;270,325p'; nl -ba src/ken/install.py | sed -n '110,150p'; rg -n 'spawn|_post_with_spawn|_read_port|TimeoutError' tests; cat tests/conftest.py; command -v python3\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/ken/cli.py | sed -n '430,500p;550,625p'; rg -n 'daemon_client|client.post|unreachable|def _daemon_health' src/ken/mcp/server.py src/ken/status.py; nl -ba src/ken/daemon/server.py | sed -n '75,100p;270,325p'; nl -ba src/ken/install.py | sed -n '110,150p'; rg -n 'spawn|_post_with_spawn|_read_port|TimeoutError' tests; cat tests/conftest.py; command -v python3\"","aggregated_output":"   430\t\n   431\t    return parser\n   432\t\n   433\t\n   434\tdef main(argv: list[str] | None = None) -> int:\n   435\t    \"\"\"Parse command-line arguments and dispatch the selected command.\"\"\"\n   436\t    parser = _build_parser()\n   437\t    args = parser.parse_args(argv)\n   438\t    return _dispatch(args, parser)\n   439\t\n   440\t\n   441\tdef _dispatch(args: argparse.Namespace, parser: argparse.ArgumentParser) -> int:\n   442\t    \"\"\"Dispatch an already-parsed command and return its process exit code.\"\"\"\n   443\t    if (\n   444\t        args.cmd in {\"install\", \"reinstall\"}\n   445\t        and args.embed_limit is not None\n   446\t        and not args.embed\n   447\t    ):\n   448\t        parser.error(\"--embed-limit requires --embed\")\n   449\t\n   450\t    if args.cmd == \"install\":\n   451\t        from ken.install import install\n   452\t\n   453\t        install(\n   454\t            Path(args.path),\n   455\t            verbose=not args.quiet,\n   456\t            force_claude=args.claude,\n   457\t            force_codex=args.codex,\n   458\t            force_opencode=args.opencode,\n   459\t            embed=args.embed,\n   460\t            embed_limit=args.embed_limit,\n   461\t            no_wire=args.no_wire,\n   462\t        )\n   463\t        return 0\n   464\t\n   465\t    if args.cmd == \"reinstall\":\n   466\t        return _reinstall_cli(\n   467\t            Path(args.path),\n   468\t            quiet=args.quiet,\n   469\t            project=not args.no_project,\n   470\t            force_claude=args.claude,\n   471\t            force_codex=args.codex,\n   472\t            force_opencode=args.opencode,\n   473\t            embed=args.embed,\n   474\t            embed_limit=args.embed_limit,\n   475\t        )\n   476\t\n   477\t    if args.cmd == \"status\":\n   478\t        from ken.status import show_status\n   479\t\n   480\t        return show_status(Path(args.path), as_json=args.json)\n   481\t\n   482\t    if args.cmd == \"rank\":\n   483\t        return _rank_cli(\n   484\t            Path(args.path),\n   485\t            \" \".join(args.query),\n   486\t            args.verbose,\n   487\t            max_chars=args.max_chars,\n   488\t            as_json=args.json,\n   489\t            stats=args.stats,\n   490\t        )\n   491\t\n   492\t    if args.cmd == \"explain\":\n   493\t        return _explain_cli(Path(args.path), \" \".join(args.query), as_json=args.json)\n   494\t\n   495\t    if args.cmd == \"search-files\":\n   496\t        return _search_cli(\n   497\t            Path(args.path),\n   498\t            \" \".join(args.query),\n   499\t            args.limit,\n   500\t            kind=\"files\",\n   550\t        )\n   551\t\n   552\t    if args.cmd == \"forget\":\n   553\t        return _forget_cli(Path(args.path), args.topic, as_json=args.json)\n   554\t\n   555\t    if args.cmd == \"findings\":\n   556\t        return _findings_cli(\n   557\t            Path(args.path),\n   558\t            args.limit,\n   559\t            tag=args.tag,\n   560\t            as_json=args.json,\n   561\t        )\n   562\t\n   563\t    if args.cmd == \"related-findings\":\n   564\t        return _related_findings_cli(\n   565\t            Path(args.path),\n   566\t            args.topic,\n   567\t            limit=args.limit,\n   568\t            min_weight=args.min_weight,\n   569\t            as_json=args.json,\n   570\t        )\n   571\t\n   572\t    if args.cmd == \"file-findings\":\n   573\t        return _file_findings_cli(\n   574\t            Path(args.path),\n   575\t            args.file,\n   576\t            limit=args.limit,\n   577\t            expand=args.expand,\n   578\t            as_json=args.json,\n   579\t        )\n   580\t\n   581\t    if args.cmd == \"findings-graph\":\n   582\t        return _findings_graph_cli(Path(args.path), args.fgraph_cmd, as_json=args.json)\n   583\t\n   584\t    if args.cmd == \"recall\":\n   585\t        return _recall_cli(\n   586\t            Path(args.path),\n   587\t            \" \".join(args.query),\n   588\t            args.limit,\n   589\t            args.min_score,\n   590\t            as_json=args.json,\n   591\t        )\n   592\t\n   593\t    if args.cmd == \"serve\":\n   594\t        from ken.serve import serve\n   595\t\n   596\t        return serve(Path(args.path), background=args.background)\n   597\t\n   598\t    if args.cmd == \"hook\":\n   599\t        from ken.hook import dispatch_hook\n   600\t\n   601\t        return dispatch_hook(args)\n   602\t\n   603\t    if args.cmd == \"mcp\":\n   604\t        from ken.mcp.server import run as run_mcp\n   605\t\n   606\t        return run_mcp(Path(args.path))\n   607\t\n   608\t    if args.cmd == \"tools\":\n   609\t        return _tools_cli(\n   610\t            Path(args.path),\n   611\t            args.tool,\n   612\t            args.tool_args,\n   613\t            list_only=args.list,\n   614\t            compact=args.compact,\n   615\t        )\n   616\t\n   617\t    if args.cmd == \"uninstall\":\n   618\t        from ken.install_uninstall import uninstall\n   619\t\n   620\t        return uninstall(Path(args.path), keep_db=args.keep_db)\n   621\t\n   622\t    parser.error(f\"unknown command: {args.cmd}\")\n   623\t    return 2\n   624\t\n   625\t\nsrc/ken/status.py:187:def _daemon_health(root: Path) -> dict:\nsrc/ken/status.py:188:    from ken.daemon import client as daemon_client\nsrc/ken/status.py:190:    health = daemon_client.health(root)\nsrc/ken/mcp/server.py:838:    from ken.daemon import client as daemon_client\nsrc/ken/mcp/server.py:841:    resp = daemon_client.post(\nsrc/ken/mcp/server.py:847:        return {\"ok\": False, \"error\": \"daemon unreachable\"}\nsrc/ken/mcp/server.py:863:    from ken.daemon import client as daemon_client\nsrc/ken/mcp/server.py:866:    resp = daemon_client.post(_PROJECT_ROOT, \"/explain\", {\"query\": query})\nsrc/ken/mcp/server.py:868:        return {\"ok\": False, \"error\": \"daemon unreachable\"}\nsrc/ken/mcp/server.py:880:    from ken.daemon import client as daemon_client\nsrc/ken/mcp/server.py:883:    health = daemon_client.health(_PROJECT_ROOT)\nsrc/ken/mcp/server.py:892:    resp = daemon_client.post(\nsrc/ken/mcp/server.py:898:        return {\"ok\": False, \"error\": \"daemon unreachable\"}\n    75\tclass DaemonState:\n    76\t    \"\"\"Mutable state the request handlers need to read/write under lock.\"\"\"\n    77\t\n    78\t    def __init__(self, project_root: Path, auth_token: str) -> None:\n    79\t        self.project_root = project_root\n    80\t        self.auth_token = auth_token\n    81\t        self.lock = threading.Lock()\n    82\t        self.conn: sqlite3.Connection = connect(_paths.db_path(project_root))\n    83\t        init_schema(self.conn)\n    84\t        # Pin the embedder to THIS project's model before anything embeds.\n    85\t        # Guarantees a global default bump never re-encodes queries for an\n    86\t        # existing project with the wrong model; records the model for a\n    87\t        # fresh DB so it resolves deterministically thereafter.\n    88\t        from ken.embedder import configure_for_project\n    89\t\n    90\t        self.embed_model = configure_for_project(self.conn)\n    91\t        # agent_id (Claude session uuid) -> {\"pk\": int, \"iter\": int, \"started_at\": int}\n    92\t        self.sessions: dict[str, dict[str, Any]] = {}\n    93\t        self.last_activity = time.monotonic()\n    94\t        self.empty_since: float | None = None  # set when sessions hits 0\n    95\t        self.shutdown_event = threading.Event()\n    96\t        self.started_at = time.monotonic()\n    97\t\n    98\t    # ---------- session bookkeeping ------------------------------------\n    99\t\n   100\t    def session_start(self, agent_id: str) -> int:\n   270\t        always the one ``record_interaction`` just inserted in the pre.\n   271\t        \"\"\"\n   272\t        sess = self.sessions.get(agent_id)\n   273\t        if sess is None:\n   274\t            return\n   275\t        with self.lock:\n   276\t            self.conn.execute(\n   277\t                \"DELETE FROM cr_interactions WHERE id = (\"\n   278\t                \"  SELECT id FROM cr_interactions \"\n   279\t                \"  WHERE session_id = ? AND target_path = ? \"\n   280\t                \"  ORDER BY id DESC LIMIT 1\"\n   281\t                \")\",\n   282\t                (sess[\"pk\"], target_path),\n   283\t            )\n   284\t            self._touch()\n   285\t\n   286\t    # ---------- shutdown logic ----------------------------------------\n   287\t\n   288\t    def _touch(self) -> None:\n   289\t        self.last_activity = time.monotonic()\n   290\t\n   291\t    def should_shutdown(self) -> str | None:\n   292\t        \"\"\"Reason string if it's time to exit, else None.\n   293\t\n   294\t        Called from the shutdown-watcher thread every SHUTDOWN_TICK_S.\n   295\t        Two reasons we'd shut down:\n   296\t          1. Active sessions hit 0 and the grace period passed\n   297\t             (claude windows closed → fast shutdown).\n   298\t          2. No HTTP activity at all for IDLE_TIMEOUT_S\n   299\t             (claude crashed without firing SessionEnd → fallback).\n   300\t        \"\"\"\n   301\t        with self.lock:\n   302\t            now = time.monotonic()\n   303\t            if not self.sessions and self.empty_since is not None:\n   304\t                if now - self.empty_since >= EMPTY_GRACE_S:\n   305\t                    return f\"empty for {now - self.empty_since:.0f}s\"\n   306\t            if now - self.last_activity >= IDLE_TIMEOUT_S:\n   307\t                return f\"idle for {now - self.last_activity:.0f}s\"\n   308\t        return None\n   309\t\n   310\t\n   311\t# ---------- HTTP handler --------------------------------------------------\n   312\t\n   313\t\n   314\tclass _Handler(BaseHTTPRequestHandler):\n   315\t    server: \"_ThreadingServer\"\n   316\t\n   317\t    # Silence the default per-request access log — we route everything\n   318\t    # through the standard logger.\n   319\t    def log_message(self, fmt: str, *args: Any) -> None:  # noqa: A003 - stdlib name\n   320\t        logger.info(\"%s - %s\", self.address_string(), fmt % args)\n   321\t\n   322\t    # -------- routing --------\n   323\t\n   324\t    def do_GET(self) -> None:  # noqa: N802 - stdlib name\n   325\t        if not self._authorised():\n   110\t    \"\"\"\n   111\t    if embed_limit is not None and embed_limit < 0:\n   112\t        raise SystemExit(\"error: --embed-limit must be >= 0\")\n   113\t    root = project_path.resolve()\n   114\t    if not root.is_dir():\n   115\t        raise SystemExit(f\"error: not a directory: {root}\")\n   116\t\n   117\t    ken_dir = _paths.ken_dir(root)\n   118\t    ken_dir.mkdir(parents=True, exist_ok=True)\n   119\t\n   120\t    # Step 1: meta.json — generate a project id + auth token if missing.\n   121\t    meta_p = _paths.meta_path(root)\n   122\t    if meta_p.is_file():\n   123\t        meta = json.loads(meta_p.read_text(encoding=\"utf-8\"))\n   124\t        if verbose:\n   125\t            print(f\"[meta] reusing existing project_id={meta['project_id']}\")\n   126\t    else:\n   127\t        meta = {\n   128\t            \"project_id\": str(uuid.uuid4()),\n   129\t            \"auth_token\": secrets.token_urlsafe(32),\n   130\t            \"created_at_ms\": int(time.time() * 1000),\n   131\t            \"project_path\": str(root),\n   132\t        }\n   133\t        meta_p.write_text(json.dumps(meta, indent=2) + \"\\n\", encoding=\"utf-8\")\n   134\t        if verbose:\n   135\t            print(f\"[meta] created .ken/meta.json (project_id={meta['project_id']})\")\n   136\t\n   137\t    # Step 2: DB schema.\n   138\t    db_p = _paths.db_path(root)\n   139\t    fresh_db = not db_p.is_file()\n   140\t    conn = connect(db_p)\n   141\t    try:\n   142\t        init_schema(conn)\n   143\t        set_meta(conn, \"project_id\", meta[\"project_id\"])\n   144\t        set_meta(conn, \"ken_version\", _ken_version())\n   145\t        # Pin the project's embedding model (records the recommended default\n   146\t        # for a fresh DB; keeps an existing DB's model on re-install).\n   147\t        from ken.embedder import configure_for_project\n   148\t\n   149\t        active_model = configure_for_project(conn)\n   150\t        if verbose:\ntests/test_daemon_http_resilience.py:21:def test_post_timeout_does_not_respawn_daemon(monkeypatch, tmp_path):\ntests/test_daemon_http_resilience.py:22:    monkeypatch.setattr(client, \"_read_port\", lambda _root: 12345)\ntests/test_daemon_http_resilience.py:25:        raise TimeoutError\ntests/test_daemon_http_resilience.py:27:    def fail_spawn(_root):\ntests/test_daemon_http_resilience.py:28:        raise AssertionError(\"timeout should not clear port and spawn\")\ntests/test_daemon_http_resilience.py:31:    monkeypatch.setattr(client, \"_spawn_and_wait\", fail_spawn)\ntests/test_daemon_http_resilience.py:33:    assert client._post_with_spawn(tmp_path, \"/rank\", {}) is None\n\"\"\"Shared test fixtures.\"\"\"\n\nfrom __future__ import annotations\n\nimport pytest\n\n\n@pytest.fixture(autouse=True)\ndef _isolate_ken_user_config(tmp_path, monkeypatch):\n    \"\"\"Point the user config at a fresh temp dir for every test.\n\n    Without this, a developer's real ``~/.config/ken/config.json`` (e.g. a\n    ``ken default-model`` override pointing at a torch-only model) would leak\n    into the suite and break tests that build the real embedder.\n    \"\"\"\n    monkeypatch.setenv(\"KEN_CONFIG_DIR\", str(tmp_path / \"ken-config\"))\n    # Same reasoning one layer down: ``recommended_model()`` prefers the static\n    # table when its artifact is present, so a developer who has one cached\n    # would silently run a different suite than CI does — and the difference\n    # would show up as unrelated assertions about the recommended model\n    # failing, which is a needlessly confusing way to learn about it. Tests that\n    # want the table set KEN_STATIC_HEAD themselves.\n    monkeypatch.setenv(\"KEN_CACHE_DIR\", str(tmp_path / \"ken-cache\"))\n    monkeypatch.delenv(\"KEN_STATIC_HEAD\", raising=False)\n/opt/homebrew/bin/python3\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=src python3 - <<'PY'\nimport contextlib, io, os, tempfile\nfrom pathlib import Path\nfrom unittest.mock import patch\nfrom ken import _paths, cli, hook\nfrom ken.daemon import client\n\nwith tempfile.TemporaryDirectory(dir=Path.cwd(), prefix='.check-state-') as tmp:\n    root = Path(tmp).resolve()\n    nested = root / 'a' / 'b'\n    nested.mkdir(parents=True)\n    _paths.ken_dir(root).mkdir()\n    _paths.meta_path(root).write_text('{}')\n    with patch.dict(os.environ):\n        os.environ.pop('KEN_PROJECT_ROOT', None)\n        assert _paths.find_project_root(nested) == root\n        with contextlib.chdir(nested):\n            assert _paths.find_project_root() == root\n        os.environ['KEN_PROJECT_ROOT'] = str(nested)\n        assert _paths.find_project_root(root) is None\n        err = io.StringIO()\n        with contextlib.redirect_stderr(err):\n            assert cli.main(['hook', 'session-start']) == 0\n        assert 'skipping hook' in err.getvalue()\n    print('PASS: ascenso desde cwd, override inválido y hook sin proyecto -> stderr / 0')\n\n    for name, port_value, responses, expected_spawns in [\n        ('existente', '12345', [{'ok': True}], 0),\n        ('ausente', None, [{'ok': True}], 1),\n        ('inválido', 'bad', [{'ok': True}], 1),\n        ('obsoleto', '12345', [ConnectionRefusedError(), {'ok': True}], 1),\n        ('timeout', '12345', [TimeoutError()], 0),\n    ]:\n        port = _paths.port_path(root)\n        port.unlink(missing_ok=True)\n        if port_value is not None:\n            port.write_text(port_value)\n        with patch.object(client, '_request', side_effect=responses), patch.object(client, '_spawn_and_wait', return_value=23456) as spawn:\n            result = client.post(root, '/rank', {})\n            assert spawn.call_count == expected_spawns\n            assert result == (None if name == 'timeout' else {'ok': True})\n        if name == 'obsoleto':\n            assert not port.exists()\n        print(f'PASS: {name} -> spawn={expected_spawns}')\n\n    _paths.port_path(root).unlink(missing_ok=True)\n    with patch.object(client.subprocess, 'Popen') as popen, patch.object(client, '_read_port', return_value=23456), patch.object(client, '_request', return_value={'ok': True}):\n        assert client._spawn_and_wait(root) == 23456\n        assert popen.call_args.args[0][-3:] == ['serve', str(root), '--background']\n        assert popen.call_args.kwargs['cwd'] == str(root)\n        assert popen.call_args.kwargs['env']['KEN_PROJECT_ROOT'] == str(root)\n        assert popen.call_args.kwargs['start_new_session'] is True\n    with patch.object(client, '_spawn_and_wait', side_effect=client.DaemonUnreachable('simulado')):\n        assert client.post(root, '/rank', {}) is None\n    print('PASS: parámetros de arranque y error de disponibilidad -> None')\n\n    with contextlib.chdir(nested), patch.object(client, 'post', return_value={'ok': True, 'context_block': ''}) as post, contextlib.redirect_stdout(io.StringIO()):\n        assert cli.main(['rank', 'consulta']) == 0\n        assert post.call_args.args[0] == nested\n        assert cli.main(['explain', 'consulta']) == 0\n        assert post.call_args.args[0] == nested\n    print('PASS: rank/explain pasan el subdirectorio, sin localizar la raíz')\n    err = io.StringIO()\n    with contextlib.redirect_stderr(err):\n        assert cli._print_daemon_response(None, None, as_json=True) == 1\n    assert err.getvalue().strip() == 'error: daemon unreachable'\n    print('PASS: fallo CLI incluso con --json -> stderr / 1')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=src python3 - <<'PY'\nimport contextlib, io, os, tempfile\nfrom pathlib import Path\nfrom unittest.mock import patch\nfrom ken import _paths, cli, hook\nfrom ken.daemon import client\n\nwith tempfile.TemporaryDirectory(dir=Path.cwd(), prefix='.check-state-') as tmp:\n    root = Path(tmp).resolve()\n    nested = root / 'a' / 'b'\n    nested.mkdir(parents=True)\n    _paths.ken_dir(root).mkdir()\n    _paths.meta_path(root).write_text('{}')\n    with patch.dict(os.environ):\n        os.environ.pop('KEN_PROJECT_ROOT', None)\n        assert _paths.find_project_root(nested) == root\n        with contextlib.chdir(nested):\n            assert _paths.find_project_root() == root\n        os.environ['KEN_PROJECT_ROOT'] = str(nested)\n        assert _paths.find_project_root(root) is None\n        err = io.StringIO()\n        with contextlib.redirect_stderr(err):\n            assert cli.main(['hook', 'session-start']) == 0\n        assert 'skipping hook' in err.getvalue()\n    print('PASS: ascenso desde cwd, override inválido y hook sin proyecto -> stderr / 0')\n\n    for name, port_value, responses, expected_spawns in [\n        ('existente', '12345', [{'ok': True}], 0),\n        ('ausente', None, [{'ok': True}], 1),\n        ('inválido', 'bad', [{'ok': True}], 1),\n        ('obsoleto', '12345', [ConnectionRefusedError(), {'ok': True}], 1),\n        ('timeout', '12345', [TimeoutError()], 0),\n    ]:\n        port = _paths.port_path(root)\n        port.unlink(missing_ok=True)\n        if port_value is not None:\n            port.write_text(port_value)\n        with patch.object(client, '_request', side_effect=responses), patch.object(client, '_spawn_and_wait', return_value=23456) as spawn:\n            result = client.post(root, '/rank', {})\n            assert spawn.call_count == expected_spawns\n            assert result == (None if name == 'timeout' else {'ok': True})\n        if name == 'obsoleto':\n            assert not port.exists()\n        print(f'PASS: {name} -> spawn={expected_spawns}')\n\n    _paths.port_path(root).unlink(missing_ok=True)\n    with patch.object(client.subprocess, 'Popen') as popen, patch.object(client, '_read_port', return_value=23456), patch.object(client, '_request', return_value={'ok': True}):\n        assert client._spawn_and_wait(root) == 23456\n        assert popen.call_args.args[0][-3:] == ['serve', str(root), '--background']\n        assert popen.call_args.kwargs['cwd'] == str(root)\n        assert popen.call_args.kwargs['env']['KEN_PROJECT_ROOT'] == str(root)\n        assert popen.call_args.kwargs['start_new_session'] is True\n    with patch.object(client, '_spawn_and_wait', side_effect=client.DaemonUnreachable('simulado')):\n        assert client.post(root, '/rank', {}) is None\n    print('PASS: parámetros de arranque y error de disponibilidad -> None')\n\n    with contextlib.chdir(nested), patch.object(client, 'post', return_value={'ok': True, 'context_block': ''}) as post, contextlib.redirect_stdout(io.StringIO()):\n        assert cli.main(['rank', 'consulta']) == 0\n        assert post.call_args.args[0] == nested\n        assert cli.main(['explain', 'consulta']) == 0\n        assert post.call_args.args[0] == nested\n    print('PASS: rank/explain pasan el subdirectorio, sin localizar la raíz')\n    err = io.StringIO()\n    with contextlib.redirect_stderr(err):\n        assert cli._print_daemon_response(None, None, as_json=True) == 1\n    assert err.getvalue().strip() == 'error: daemon unreachable'\n    print('PASS: fallo CLI incluso con --json -> stderr / 1')\nPY\"","aggregated_output":"daemon POST /rank timed out after 60.0s\ndaemon unreachable for /rank: simulado\nPASS: ascenso desde cwd, override inválido y hook sin proyecto -> stderr / 0\nPASS: existente -> spawn=0\nPASS: ausente -> spawn=1\nPASS: inválido -> spawn=1\nPASS: obsoleto -> spawn=1\nPASS: timeout -> spawn=0\nPASS: parámetros de arranque y error de disponibilidad -> None\nPASS: rank/explain pasan el subdirectorio, sin localizar la raíz\nPASS: fallo CLI incluso con --json -> stderr / 1\n","exit_code":0,"status":"completed"}}
