paths.find_project_root(project_path.resolve()) or project_path.resolve()\nsrc/ken/daemon/watcher.py:10:want to even acknowledge writes inside `.ken/` (we'd echo our own DB\nsrc/ken/mcp/server.py:60:from ken.db import connect\nsrc/ken/mcp/server.py:94:    root = _paths.find_project_root(start.resolve()) or start.resolve()\nsrc/ken/mcp/server.py:96:        print(f\"ken mcp: no .ken project at {root}\", file=sys.stderr)\nsrc/ken/mcp/server.py:321:        raise RuntimeError(\"MCP server not initialised — call run() first\")\nsrc/ken/mcp/server.py:322:    return connect(_paths.db_path(_PROJECT_ROOT))\nsrc/ken/mcp/server.py:328:        raise RuntimeError(\"MCP server not initialised — call run() first\")\nsrc/ken/mcp/server.py:464:        return find_tests(conn, path, limit=limit, project_root=_PROJECT_ROOT)\nsrc/ken/mcp/server.py:555:    Links are deterministic and evidence-cited: two findings connect when they\nsrc/ken/mcp/server.py:1052:    \"\"\"What else is connected to *target*, by a named relationship:\nsrc/ken/daemon/index_queue.py:5:them in batches.  Owns its own SQLite connection so the HTTP server\nsrc/ken/daemon/index_queue.py:31:from ken.db import connect\nsrc/ken/daemon/index_queue.py:67:        # Indexer thread owns its own connection — keeps long-running\nsrc/ken/daemon/index_queue.py:76:        self._conn = connect(_paths.db_path(self.project_root))\nsrc/ken/daemon/client.py:6:    2. Look for `.ken/daemon.port`.\nsrc/ken/daemon/client.py:15:then polls `.ken/daemon.port` for up to 5 seconds.\nsrc/ken/daemon/client.py:110:    \"\"\"Detach a daemon process and wait for `.ken/daemon.port` to appear.\"\"\"\nsrc/ken/daemon/__init__.py:4:  * the SQLite write connection,\nsrc/ken/daemon/server.py:25:SQLite connections are not thread-safe, so we serialise DB writes through\nsrc/ken/daemon/server.py:26:a single ``threading.Lock`` around a daemon-owned connection. With our\nsrc/ken/daemon/server.py:45:from ken.db import connect, init_schema, set_meta\nsrc/ken/daemon/server.py:82:        self.conn: sqlite3.Connection = connect(_paths.db_path(project_root))\nsrc/ken/daemon/server.py:412:            logger.info(\"client disconnected before response path=%s\", self.path)\nsrc/ken/daemon/server.py:596:    connection so external hosts (e.g. the desktop app) avoid a cold\nsrc/ken/daemon/server.py:1056:    ``.ken/daemon.port``, serves until idle / empty / explicit shutdown.\nsrc/ken/daemon/server.py:1061:        print(f\"ken: no .ken/meta.json at {project_root}\", flush=True)\nsrc/ken/daemon/server.py:1119:    # SQLite connections. We start the queue first so the watcher's first\n[project]\nname = \"ken-rank\"\n# Single-sourced from src/ken/__init__.py — see [tool.hatch.version]. Keeping a\n# literal here as well is what shipped 0.5.0 and 0.7.0 with `ken --version`\n# reporting the *previous* release: two places to bump, one of them easy to miss.\ndynamic = [\"version\"]\ndescription = \"Per-project context-rank index for Claude Code, served from a local daemon.\"\nreadme = \"README.md\"\nrequires-python = \">=3.11\"\nlicense = { text = \"MIT\" }\nauthors = [{ name = \"Andres\" }]\ndependencies = [\n    \"tree-sitter>=0.25.2\",\n    \"tree-sitter-python>=0.23\",\n    \"tree-sitter-rust>=0.23\",\n    \"tree-sitter-javascript>=0.23\",\n    \"tree-sitter-typescript>=0.23\",\n    \"tree-sitter-go>=0.23\",\n    \"tree-sitter-java>=0.23\",\n    # Dart has no standalone tree-sitter wheel on PyPI; the language-pack\n    # bundles the grammar (and pins tree-sitter>=0.25.2, hence the bump above).\n    \"tree-sitter-language-pack>=1.8\",\n    \"pathspec>=0.12\",\n    \"watchfiles>=0.22\",\n    # fastembed brings ONNX Runtime + a managed all-MiniLM-L6-v2 download\n    # (~25 MB cached in ~/.cache/fastembed on first use). 384-dim, fast on\n    # CPU; same model infinidev runs in production.\n    \"fastembed>=0.5\",\n    \"numpy>=1.26\",\n    # MCP SDK — exposes ken's tools to Claude Code over stdio.\n    # Pinned to the 2.x line: 2.0 renamed ``FastMCP`` to ``MCPServer``\n    # and moved it to ``mcp.server``; 0.10.0 of ken-rank shipped with the\n    # older ``mcp>=1.0`` pin by accident, so older installs may have\n    # resolved mcp 1.x — and then the MCP server silently failed at\n    # import. ``<3`` keeps 3.x out until we verify it (the 3.x line is\n    # not yet on PyPI as of writing).\n    \"mcp>=2.0,<3\",\n]\n\n[project.optional-dependencies]\n# GPU embedding for the default (fastembed) backend. `pip install\n# ken-rank[gpu]` swaps in fastembed's GPU build (it pulls onnxruntime-gpu).\n# The embedder then auto-detects a CUDA/ROCm provider and uses it, falling\n# back to CPU when none is usable — so this extra is purely opt-in\n# acceleration and never a hard requirement. The pulled onnxruntime-gpu\n# targets a specific CUDA major; if it does not match the host's CUDA\n# runtime, ken logs a warning and stays on CPU rather than failing. Pin\n# onnxruntime-gpu yourself if you need a specific CUDA line.\n#\n# Not installable on macOS: onnxruntime-gpu publishes Linux and Windows wheels\n# only, so without the marker `pip install 'ken-rank[gpu]'` fails outright on a\n# Mac. There is nothing to offer instead — ONNX Runtime has no MPS provider, so\n# the fastembed backend stays on the CPU there (where its small models are\n# already fast). Apple Silicon GPU acceleration lives in the `torch` extra.\ngpu = [\"fastembed-gpu>=0.5; sys_platform != 'darwin'\"]\n\n# The torch backend: `pip install ken-rank[torch]` adds sentence-transformers\n# (which pulls torch) so ken can run stronger models fastembed does not ship —\n# e.g. Qwen/Qwen3-Embedding-0.6B (top of ken's retrieval benchmark) or\n# BAAI/bge-m3. Heavier install; entirely opt-in. Switch a project onto one\n# with `ken reembed --model <name>` after installing this extra. Also\n# GPU-aware: CUDA, or Apple Silicon's MPS, whichever torch sees.\n#\n# The two version floors are not cosmetic. sentence-transformers only requires\n# transformers>=4.34, but the Qwen3 architecture landed in 4.51 — below it the\n# model dies with `KeyError: 'qwen3'`, naming neither the cause nor the fix. And\n# torch below 2.9 could return silently wrong embeddings on MPS (pytorch#163597,\n# fixed in 2.9.0), so Apple Silicon gets a floor that costs Linux users nothing;\n# it is scoped to arm64 because PyPI has no torch 2.9 for Intel Macs, where MPS\n# does not exist anyway.\ntorch = [\n    \"sentence-transformers>=3.0\",\n    \"transformers>=4.51\",\n    \"torch>=2.9; sys_platform == 'darwin' and platform_machine == 'arm64'\",\n]\n\n[project.scripts]\nken = \"ken.cli:main\"\n\n[dependency-groups]\ndev = [\n    \"mypy>=1.15\",\n    \"pytest>=8.0\",\n]\n\n[build-system]\nrequires = [\"hatchling\"]\nbuild-backend = \"hatchling.build\"\n\n# The one place the version lives. hatchling reads __version__ out of this file\n# at build time, so the package metadata and what `ken --version` prints cannot\n# disagree — they are the same string.\n[tool.hatch.version]\npath = \"src/ken/__init__.py\"\n\n[tool.hatch.build.targets.wheel]\npackages = [\"src/ken\"]\n\n[tool.hatch.build.targets.sdist]\ninclude = [\"src/ken\", \"README.md\", \"LICENSE\", \"pyproject.toml\"]\n\n[tool.pytest.ini_options]\ntestpaths = [\"tests\"]\naddopts = \"-q\"\n\n[tool.mypy]\npython_version = \"3.12\"\nfiles = [\"src/ken\"]\nshow_error_codes = true\nwarn_unused_configs = true\n\n# Incremental typing gate: these existing modules have known annotation debt.\n# They remain part of mypy's import graph, while every other module — and every\n# new module — must stay clean. Remove entries as their annotations are fixed.\n[[tool.mypy.overrides]]\nmodule = [\n    \"ken.cli\",\n    \"ken.embedder.onnx_fastembed\",\n    \"ken.embedder.st_backend\",\n    \"ken.embedder.static_head\",\n    \"ken.findings_graph\",\n    \"ken.graphtools\",\n    \"ken.indexer\",\n    \"ken.mcp.server\",\n    \"ken.parsers.cpp\",\n    \"ken.parsers.dart\",\n    \"ken.parsers.php\",\n    \"ken.parsers.sql\",\n    \"ken.ranker.output\",\n    \"ken.reembed\",\n    \"ken.status\",\n    \"ken.structure\",\n    \"ken.vectors\",\n]\nignore_errors = true\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/ken/_paths.py; nl -ba src/ken/daemon/client.py; rg -n 'get_client|ensure|find_project|resolve_project|def run|def main|except|stderr' src/ken/hook.py src/ken/serve.py src/ken/mcp/server.py src/ken/cli.py; cat tests/test_paths.py; cat tests/test_daemon_helpers.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/ken/_paths.py; nl -ba src/ken/daemon/client.py; rg -n 'get_client|ensure|find_project|resolve_project|def run|def main|except|stderr' src/ken/hook.py src/ken/serve.py src/ken/mcp/server.py src/ken/cli.py; cat tests/test_paths.py; cat tests/test_daemon_helpers.py\"","aggregated_output":"     1\t\"\"\"Project-root discovery + canonical paths inside `.ken/`.\n     2\t\n     3\tA \"ken project\" is any directory that contains a `.ken/meta.json`. We\n     4\tfollow git's pattern: walk up from the caller's cwd until we find one,\n     5\totherwise return None.\n     6\t\n     7\tThe hook commands (`ken hook session-start`, etc.) call\n     8\t`find_project_root()` first thing so they know which DB to write to.\n     9\tThe CLI's `install` / `serve` / `status` accept an explicit path\n    10\targument that takes precedence.\n    11\t\"\"\"\n    12\t\n    13\tfrom __future__ import annotations\n    14\t\n    15\timport os\n    16\tfrom pathlib import Path\n    17\t\n    18\tKEN_DIR_NAME = \".ken\"\n    19\tMETA_FILENAME = \"meta.json\"\n    20\tDB_FILENAME = \"ken.db\"\n    21\tPID_FILENAME = \"daemon.pid\"\n    22\tSOCKET_FILENAME = \"daemon.sock\"\n    23\tPORT_FILENAME = \"daemon.port\"\n    24\tLOG_FILENAME = \"daemon.log\"\n    25\t\n    26\t\n    27\tdef ken_dir(project_root: Path) -> Path:\n    28\t    return project_root / KEN_DIR_NAME\n    29\t\n    30\t\n    31\tdef meta_path(project_root: Path) -> Path:\n    32\t    return ken_dir(project_root) / META_FILENAME\n    33\t\n    34\t\n    35\tdef db_path(project_root: Path) -> Path:\n    36\t    return ken_dir(project_root) / DB_FILENAME\n    37\t\n    38\t\n    39\tdef pid_path(project_root: Path) -> Path:\n    40\t    return ken_dir(project_root) / PID_FILENAME\n    41\t\n    42\t\n    43\tdef port_path(project_root: Path) -> Path:\n    44\t    return ken_dir(project_root) / PORT_FILENAME\n    45\t\n    46\t\n    47\tdef log_path(project_root: Path) -> Path:\n    48\t    return ken_dir(project_root) / LOG_FILENAME\n    49\t\n    50\t\n    51\tdef resolve_project_path(project_root: Path, path: str | Path) -> Path:\n    52\t    \"\"\"Resolve *path* and require it to remain inside *project_root*.\n    53\t\n    54\t    Relative paths are interpreted from the project root. Absolute paths are\n    55\t    accepted when they point inside it. Resolving both sides before the\n    56\t    containment check also rejects ``..`` traversal and escapes through\n    57\t    existing symbolic links.\n    58\t    \"\"\"\n    59\t    root = project_root.expanduser().resolve()\n    60\t    supplied = Path(path).expanduser()\n    61\t    resolved = (supplied if supplied.is_absolute() else root / supplied).resolve()\n    62\t    try:\n    63\t        resolved.relative_to(root)\n    64\t    except ValueError as err:\n    65\t        raise ValueError(f\"path escapes project root: {path}\") from err\n    66\t    return resolved\n    67\t\n    68\t\n    69\tdef find_project_root(start: Path | None = None) -> Path | None:\n    70\t    \"\"\"Walk up from *start* (default cwd) looking for `.ken/meta.json`.\n    71\t\n    72\t    Returns the directory that contains `.ken/`, not the `.ken/` itself.\n    73\t    `KEN_PROJECT_ROOT` env var overrides discovery — useful for tests\n    74\t    and for hooks invoked with a wonky cwd.\n    75\t    \"\"\"\n    76\t    forced = os.environ.get(\"KEN_PROJECT_ROOT\")\n    77\t    if forced:\n    78\t        p = Path(forced).expanduser().resolve()\n    79\t        return p if meta_path(p).is_file() else None\n    80\t\n    81\t    cur = (start or Path.cwd()).resolve()\n    82\t    for parent in [cur, *cur.parents]:\n    83\t        if meta_path(parent).is_file():\n    84\t            return parent\n    85\t    return None\n     1\t\"\"\"Client used by hook commands to talk to the daemon.\n     2\t\n     3\tA hook lifecycle is:\n     4\t\n     5\t    1. Find project root via walk-up.\n     6\t    2. Look for `.ken/daemon.port`.\n     7\t       - exists + responsive  → use it.\n     8\t       - exists but stale     → spawn a fresh daemon.\n     9\t       - missing              → spawn one.\n    10\t    3. POST event, return the response (or None on failure — hooks must\n    11\t       *never* fail Claude Code; logging-and-shrugging is the contract).\n    12\t\n    13\tSpawning is detached: the daemon outlives the hook process via\n    14\t``start_new_session=True`` and stdio redirected to a log file. The hook\n    15\tthen polls `.ken/daemon.port` for up to 5 seconds.\n    16\t\"\"\"\n    17\t\n    18\tfrom __future__ import annotations\n    19\t\n    20\timport json\n    21\timport logging\n    22\timport os\n    23\timport subprocess\n    24\timport sys\n    25\timport time\n    26\timport urllib.error\n    27\timport urllib.request\n    28\tfrom pathlib import Path\n    29\tfrom typing import Any\n    30\t\n    31\tfrom ken import _paths\n    32\t\n    33\t# How long a hook will wait for a freshly-spawned daemon before giving up.\n    34\tSPAWN_POLL_TIMEOUT_S = 5.0\n    35\tSPAWN_POLL_INTERVAL_S = 0.05\n    36\t\n    37\t# Hook → daemon timeouts. Reads/health small; cheap POSTs slightly bigger\n    38\t# to tolerate a brief lock-contention spike when many hooks fire at once.\n    39\t# Ranking endpoints can legitimately take longer on huge repos, especially\n    40\t# the first time the process loads the embedding model.\n    41\tHEALTH_TIMEOUT_S = 1.0\n    42\tPOST_TIMEOUT_S = 3.0\n    43\tRANK_POST_TIMEOUT_S = 60.0\n    44\tRANKING_PATHS = {\"/prompts\", \"/rank\", \"/explain\"}\n    45\t\n    46\tlogger = logging.getLogger(\"ken.client\")\n    47\t\n    48\t\n    49\tclass DaemonUnreachable(RuntimeError):\n    50\t    \"\"\"Raised when even after a spawn the daemon doesn't come up.\"\"\"\n    51\t\n    52\t\n    53\tdef post(project_root: Path, path: str, payload: dict[str, Any]) -> dict[str, Any] | None:\n    54\t    \"\"\"POST *payload* as JSON to *path* on the daemon. Spawns one if needed.\n    55\t\n    56\t    Returns the parsed JSON response, or ``None`` if every attempt failed\n    57\t    (so callers can fall back to silent degradation).\n    58\t    \"\"\"\n    59\t    try:\n    60\t        return _post_with_spawn(project_root, path, payload)\n    61\t    except DaemonUnreachable as exc:\n    62\t        logger.warning(\"daemon unreachable for %s: %s\", path, exc)\n    63\t        return None\n    64\t    except Exception:  # pragma: no cover\n    65\t        logger.exception(\"daemon POST %s failed\", path)\n    66\t        return None\n    67\t\n    68\t\n    69\tdef health(project_root: Path) -> dict[str, Any] | None:\n    70\t    \"\"\"GET /health. Returns parsed JSON or None — never raises.\"\"\"\n    71\t    port = _read_port(project_root)\n    72\t    if port is None:\n    73\t        return None\n    74\t    try:\n    75\t        return _request(\"GET\", project_root, port, \"/health\", body=None, timeout=HEALTH_TIMEOUT_S)\n    76\t    except (OSError, urllib.error.URLError, json.JSONDecodeError):\n    77\t        return None\n    78\t\n    79\t\n    80\t# ---------- internals ----------\n    81\t\n    82\t\n    83\tdef _post_with_spawn(project_root: Path, path: str, payload: dict[str, Any]) -> dict[str, Any] | None:\n    84\t    timeout = _post_timeout(path)\n    85\t    port = _read_port(project_root)\n    86\t    if port is not None:\n    87\t        try:\n    88\t            return _request(\"POST\", project_root, port, path, body=payload, timeout=timeout)\n    89\t        except TimeoutError:\n    90\t            # The daemon accepted the request but did not respond before\n    91\t            # the hook budget. Do not clear the port or spawn another\n    92\t            # daemon: the in-flight request may still complete.\n    93\t            logger.warning(\"daemon POST %s timed out after %.1fs\", path, timeout)\n    94\t            return None\n    95\t        except (urllib.error.URLError, ConnectionRefusedError, OSError):\n    96\t            # Stale port file (daemon crashed without cleanup).  Spawn a\n    97\t            # fresh one and retry once.\n    98\t            logger.info(\"port %s unresponsive; respawning daemon\", port)\n    99\t            _clear_port_file(project_root)\n   100\t\n   101\t    spawned_port = _spawn_and_wait(project_root)\n   102\t    return _request(\"POST\", project_root, spawned_port, path, body=payload, timeout=timeout)\n   103\t\n   104\t\n   105\tdef _post_timeout(path: str) -> float:\n   106\t    return RANK_POST_TIMEOUT_S if path in RANKING_PATHS else POST_TIMEOUT_S\n   107\t\n   108\t\n   109\tdef _spawn_and_wait(project_root: Path) -> int:\n   110\t    \"\"\"Detach a daemon process and wait for `.ken/daemon.port` to appear.\"\"\"\n   111\t    log_p = _paths.log_path(project_root)\n   112\t    log_p.parent.mkdir(parents=True, exist_ok=True)\n   113\t    log_handle = log_p.open(\"ab\")\n   114\t    # We use sys.executable to avoid a PATH lookup race when running\n   115\t    # under uv tool / pipx; a console script wrapper would also work but\n   116\t    # this is the most portable. ``-m ken`` invokes the package's\n   117\t    # __main__ → cli.main.\n   118\t    cmd = [sys.executable, \"-m\", \"ken\", \"serve\", str(project_root), \"--background\"]\n   119\t    subprocess.Popen(  # noqa: S603 — args are literal/local-controlled\n   120\t        cmd,\n   121\t        stdin=subprocess.DEVNULL,\n   122\t        stdout=log_handle,\n   123\t        stderr=subprocess.STDOUT,\n   124\t        start_new_session=True,\n   125\t        cwd=str(project_root),\n   126\t        env={**os.environ, \"KEN_PROJECT_ROOT\": str(project_root)},\n   127\t    )\n   128\t    # Don't keep the parent's handle open — daemon dup'd it.\n   129\t    log_handle.close()\n   130\t\n   131\t    deadline = time.monotonic() + SPAWN_POLL_TIMEOUT_S\n   132\t    while time.monotonic() < deadline:\n   133\t        port = _read_port(project_root)\n   134\t        if port is not None:\n   135\t            # Port file written; one more health check before declaring win.\n   136\t            try:\n   137\t                if _request(\"GET\", project_root, port, \"/health\", body=None, timeout=HEALTH_TIMEOUT_S):\n   138\t                    return port\n   139\t            except Exception:  # pragma: no cover\n   140\t                pass\n   141\t        time.sleep(SPAWN_POLL_INTERVAL_S)\n   142\t    raise DaemonUnreachable(f\"daemon did not come up within {SPAWN_POLL_TIMEOUT_S}s\")\n   143\t\n   144\t\n   145\tdef _read_port(project_root: Path) -> int | None:\n   146\t    p = _paths.port_path(project_root)\n   147\t    if not p.is_file():\n   148\t        return None\n   149\t    try:\n   150\t        return int(p.read_text(encoding=\"utf-8\").strip())\n   151\t    except (OSError, ValueError):\n   152\t        return None\n   153\t\n   154\t\n   155\tdef _clear_port_file(project_root: Path) -> None:\n   156\t    try:\n   157\t        _paths.port_path(project_root).unlink()\n   158\t    except OSError:\n   159\t        pass\n   160\t\n   161\t\n   162\tdef _read_token(project_root: Path) -> str:\n   163\t    meta = json.loads(_paths.meta_path(project_root).read_text(encoding=\"utf-8\"))\n   164\t    return str(meta[\"auth_token\"])\n   165\t\n   166\t\n   167\tdef _request(\n   168\t    method: str,\n   169\t    project_root: Path,\n   170\t    port: int,\n   171\t    path: str,\n   172\t    *,\n   173\t    body: dict[str, Any] | None,\n   174\t    timeout: float,\n   175\t) -> dict[str, Any]:\n   176\t    url = f\"http://127.0.0.1:{port}{path}\"\n   177\t    data = None\n   178\t    headers = {\"Authorization\": f\"Bearer {_read_token(project_root)}\"}\n   179\t    if body is not None:\n   180\t        data = json.dumps(body).encode(\"utf-8\")\n   181\t        headers[\"Content-Type\"] = \"application/json\"\n   182\t    req = urllib.request.Request(url, data=data, method=method, headers=headers)\n   183\t    with urllib.request.urlopen(req, timeout=timeout) as resp:  # noqa: S310 — localhost-only\n   184\t        raw = resp.read().decode(\"utf-8\")\n   185\t    return json.loads(raw) if raw else {}\nsrc/ken/serve.py:14:    root = _paths.find_project_root(start.resolve()) or start.resolve()\nsrc/ken/serve.py:16:        print(f\"no ken project at {root} — run `ken install .` first\", file=sys.stderr)\nsrc/ken/serve.py:21:        # foreground mode logs to stderr so `ken serve` in a terminal is\nsrc/ken/mcp/server.py:26:except ImportError as _exc:\nsrc/ken/mcp/server.py:31:    except PackageNotFoundError:\nsrc/ken/mcp/server.py:34:    sys.stderr.write(\nsrc/ken/mcp/server.py:53:    sys.stderr.flush()\nsrc/ken/mcp/server.py:91:def run(start: Path) -> int:\nsrc/ken/mcp/server.py:94:    root = _paths.find_project_root(start.resolve()) or start.resolve()\nsrc/ken/mcp/server.py:96:        print(f\"ken mcp: no .ken project at {root}\", file=sys.stderr)\nsrc/ken/mcp/server.py:100:        stream=sys.stderr,\nsrc/ken/mcp/server.py:158:    except Exception:\nsrc/ken/mcp/server.py:329:    resolved = _paths.resolve_project_path(_PROJECT_ROOT, path)\nsrc/ken/cli.py:162:        \"--stats\", action=\"store_true\", help=\"print context size stats to stderr\"\nsrc/ken/cli.py:434:def main(argv: list[str] | None = None) -> int:\nsrc/ken/cli.py:641:            file=sys.stderr,\nsrc/ken/cli.py:646:        print(\"error: uv is required for `ken reinstall`\", file=sys.stderr)\nsrc/ken/cli.py:660:    stderr = subprocess.DEVNULL if quiet else None\nsrc/ken/cli.py:662:        subprocess.run(reinstall_cmd, check=True, stdout=stdout, stderr=stderr)\nsrc/ken/cli.py:663:    except subprocess.CalledProcessError as exc:\nsrc/ken/cli.py:666:            file=sys.stderr,\nsrc/ken/cli.py:675:        print(\"error: ken was reinstalled but is not on PATH\", file=sys.stderr)\nsrc/ken/cli.py:691:        subprocess.run(install_cmd, check=True, stdout=stdout, stderr=stderr)\nsrc/ken/cli.py:692:    except subprocess.CalledProcessError as exc:\nsrc/ken/cli.py:695:            file=sys.stderr,\nsrc/ken/cli.py:715:    except json.JSONDecodeError:\nsrc/ken/cli.py:758:        print(\"error: daemon unreachable\", file=sys.stderr)\nsrc/ken/cli.py:764:        print(f\"error: {resp.get('error', 'request failed')}\", file=sys.stderr)\nsrc/ken/cli.py:769:            print(_format_rank_stats(resp), file=sys.stderr)\nsrc/ken/cli.py:802:    root = _paths.find_project_root(project_path.resolve()) or project_path.resolve()\nsrc/ken/cli.py:805:        print(f\"error: no .ken project at {root}\", file=sys.stderr)\nsrc/ken/cli.py:832:    root, db_path = _resolve_project_db(project_path)\nsrc/ken/cli.py:834:        print(f\"error: no .ken project at {root}\", file=sys.stderr)\nsrc/ken/cli.py:845:        print(f\"error: {resp.get('error', 'remember failed')}\", file=sys.stderr)\nsrc/ken/cli.py:853:    root, db_path = _resolve_project_db(project_path)\nsrc/ken/cli.py:855:        print(f\"error: no .ken project at {root}\", file=sys.stderr)\nsrc/ken/cli.py:864:        print(f\"not found: {resp['topic']}\", file=sys.stderr)\nsrc/ken/cli.py:878:    root, db_path = _resolve_project_db(project_path)\nsrc/ken/cli.py:880:        print(f\"error: no .ken project at {root}\", file=sys.stderr)\nsrc/ken/cli.py:904:    root, db_path = _resolve_project_db(project_path)\nsrc/ken/cli.py:906:        print(f\"error: no .ken project at {root}\", file=sys.stderr)\nsrc/ken/cli.py:932:    root, db_path = _resolve_project_db(project_path)\nsrc/ken/cli.py:934:        print(f\"error: no .ken project at {root}\", file=sys.stderr)\nsrc/ken/cli.py:962:    root, db_path = _resolve_project_db(project_path)\nsrc/ken/cli.py:964:        print(f\"error: no .ken project at {root}\", file=sys.stderr)\nsrc/ken/cli.py:986:    from ken.findings_graph import ensure_finding_graph, rebuild_finding_graph\nsrc/ken/cli.py:988:    root, db_path = _resolve_project_db(project_path)\nsrc/ken/cli.py:990:        