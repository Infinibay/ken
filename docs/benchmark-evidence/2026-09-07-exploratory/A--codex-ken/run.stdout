{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/ken/_paths.py; nl -ba tests/test_paths.py; rg -n '_project_relative_path|def ken_read|def .*read|_PROJECT_ROOT|read_text|read_file' src/ken/mcp/server.py; cat pyproject.toml\"","aggregated_output":"     1\t\"\"\"Project-root discovery + canonical paths inside `.ken/`.\n     2\t\n     3\tA \"ken project\" is any directory that contains a `.ken/meta.json`. We\n     4\tfollow git's pattern: walk up from the caller's cwd until we find one,\n     5\totherwise return None.\n     6\t\n     7\tThe hook commands (`ken hook session-start`, etc.) call\n     8\t`find_project_root()` first thing so they know which DB to write to.\n     9\tThe CLI's `install` / `serve` / `status` accept an explicit path\n    10\targument that takes precedence.\n    11\t\"\"\"\n    12\t\n    13\tfrom __future__ import annotations\n    14\t\n    15\timport os\n    16\tfrom pathlib import Path\n    17\t\n    18\tKEN_DIR_NAME = \".ken\"\n    19\tMETA_FILENAME = \"meta.json\"\n    20\tDB_FILENAME = \"ken.db\"\n    21\tPID_FILENAME = \"daemon.pid\"\n    22\tSOCKET_FILENAME = \"daemon.sock\"\n    23\tPORT_FILENAME = \"daemon.port\"\n    24\tLOG_FILENAME = \"daemon.log\"\n    25\t\n    26\t\n    27\tdef ken_dir(project_root: Path) -> Path:\n    28\t    return project_root / KEN_DIR_NAME\n    29\t\n    30\t\n    31\tdef meta_path(project_root: Path) -> Path:\n    32\t    return ken_dir(project_root) / META_FILENAME\n    33\t\n    34\t\n    35\tdef db_path(project_root: Path) -> Path:\n    36\t    return ken_dir(project_root) / DB_FILENAME\n    37\t\n    38\t\n    39\tdef pid_path(project_root: Path) -> Path:\n    40\t    return ken_dir(project_root) / PID_FILENAME\n    41\t\n    42\t\n    43\tdef port_path(project_root: Path) -> Path:\n    44\t    return ken_dir(project_root) / PORT_FILENAME\n    45\t\n    46\t\n    47\tdef log_path(project_root: Path) -> Path:\n    48\t    return ken_dir(project_root) / LOG_FILENAME\n    49\t\n    50\t\n    51\tdef resolve_project_path(project_root: Path, path: str | Path) -> Path:\n    52\t    \"\"\"Resolve *path* and require it to remain inside *project_root*.\n    53\t\n    54\t    Relative paths are interpreted from the project root. Absolute paths are\n    55\t    accepted when they point inside it. Resolving both sides before the\n    56\t    containment check also rejects ``..`` traversal and escapes through\n    57\t    existing symbolic links.\n    58\t    \"\"\"\n    59\t    root = project_root.expanduser().resolve()\n    60\t    supplied = Path(path).expanduser()\n    61\t    resolved = (supplied if supplied.is_absolute() else root / supplied).resolve()\n    62\t    try:\n    63\t        resolved.relative_to(root)\n    64\t    except ValueError as err:\n    65\t        raise ValueError(f\"path escapes project root: {path}\") from err\n    66\t    return resolved\n    67\t\n    68\t\n    69\tdef find_project_root(start: Path | None = None) -> Path | None:\n    70\t    \"\"\"Walk up from *start* (default cwd) looking for `.ken/meta.json`.\n    71\t\n    72\t    Returns the directory that contains `.ken/`, not the `.ken/` itself.\n    73\t    `KEN_PROJECT_ROOT` env var overrides discovery — useful for tests\n    74\t    and for hooks invoked with a wonky cwd.\n    75\t    \"\"\"\n    76\t    forced = os.environ.get(\"KEN_PROJECT_ROOT\")\n    77\t    if forced:\n    78\t        p = Path(forced).expanduser().resolve()\n    79\t        return p if meta_path(p).is_file() else None\n    80\t\n    81\t    cur = (start or Path.cwd()).resolve()\n    82\t    for parent in [cur, *cur.parents]:\n    83\t        if meta_path(parent).is_file():\n    84\t            return parent\n    85\t    return None\n     1\t\"\"\"Project root discovery + path helpers.\"\"\"\n     2\t\n     3\tfrom __future__ import annotations\n     4\t\n     5\timport os\n     6\tfrom pathlib import Path\n     7\t\n     8\timport pytest\n     9\t\n    10\tfrom ken import _paths\n    11\t\n    12\t\n    13\tdef test_find_project_root_walks_up(tmp_path):\n    14\t    root = tmp_path / \"proj\"\n    15\t    (root / \".ken\").mkdir(parents=True)\n    16\t    (root / \".ken\" / \"meta.json\").write_text(\"{}\")\n    17\t    nested = root / \"a\" / \"b\" / \"c\"\n    18\t    nested.mkdir(parents=True)\n    19\t    found = _paths.find_project_root(start=nested)\n    20\t    assert found is not None\n    21\t    assert found.resolve() == root.resolve()\n    22\t\n    23\t\n    24\tdef test_find_project_root_returns_none_when_missing(tmp_path):\n    25\t    \"\"\"Plain temp dir with no .ken/ above it → None.\"\"\"\n    26\t    # Save & restore env to avoid bleeding into other tests.\n    27\t    saved = os.environ.pop(\"KEN_PROJECT_ROOT\", None)\n    28\t    try:\n    29\t        # Use a path that's guaranteed to not have .ken in any ancestor.\n    30\t        result = _paths.find_project_root(start=tmp_path)\n    31\t        # Walking up may eventually hit a real .ken/ on the dev machine —\n    32\t        # we only guarantee that without one it'd be None. Accept either.\n    33\t        if result is not None:\n    34\t            # If it found something, at least confirm it's a valid project root.\n    35\t            assert _paths.meta_path(result).is_file()\n    36\t    finally:\n    37\t        if saved is not None:\n    38\t            os.environ[\"KEN_PROJECT_ROOT\"] = saved\n    39\t\n    40\t\n    41\tdef test_find_project_root_respects_env_var(tmp_path, monkeypatch):\n    42\t    root = tmp_path / \"envproj\"\n    43\t    (root / \".ken\").mkdir(parents=True)\n    44\t    (root / \".ken\" / \"meta.json\").write_text(\"{}\")\n    45\t    monkeypatch.setenv(\"KEN_PROJECT_ROOT\", str(root))\n    46\t    # Even if start= points elsewhere, env var wins.\n    47\t    other = tmp_path / \"other\"\n    48\t    other.mkdir()\n    49\t    found = _paths.find_project_root(start=other)\n    50\t    assert found is not None\n    51\t    assert found.resolve() == root.resolve()\n    52\t\n    53\t\n    54\tdef test_env_var_with_invalid_path_returns_none(tmp_path, monkeypatch):\n    55\t    \"\"\"Env var pointing somewhere with no meta.json → None (not a fallback).\"\"\"\n    56\t    nowhere = tmp_path / \"nowhere\"\n    57\t    nowhere.mkdir()\n    58\t    monkeypatch.setenv(\"KEN_PROJECT_ROOT\", str(nowhere))\n    59\t    assert _paths.find_project_root() is None\n    60\t\n    61\t\n    62\tdef test_path_helpers_compose(tmp_path):\n    63\t    root = tmp_path\n    64\t    assert _paths.ken_dir(root) == root / \".ken\"\n    65\t    assert _paths.meta_path(root) == root / \".ken\" / \"meta.json\"\n    66\t    assert _paths.db_path(root) == root / \".ken\" / \"ken.db\"\n    67\t    assert _paths.port_path(root) == root / \".ken\" / \"daemon.port\"\n    68\t    assert _paths.pid_path(root) == root / \".ken\" / \"daemon.pid\"\n    69\t    assert _paths.log_path(root) == root / \".ken\" / \"daemon.log\"\n    70\t\n    71\t\n    72\t@pytest.mark.parametrize(\"absolute\", [False, True])\n    73\tdef test_resolve_project_path_accepts_internal_path(tmp_path, absolute):\n    74\t    root = tmp_path / \"project\"\n    75\t    source = root / \"src\" / \"module.py\"\n    76\t    source.parent.mkdir(parents=True)\n    77\t    source.write_text(\"\", encoding=\"utf-8\")\n    78\t\n    79\t    supplied = source if absolute else Path(\"src/module.py\")\n    80\t\n    81\t    assert _paths.resolve_project_path(root, supplied) == source.resolve()\n    82\t\n    83\t\n    84\tdef test_resolve_project_path_rejects_parent_traversal(tmp_path):\n    85\t    root = tmp_path / \"project\"\n    86\t    root.mkdir()\n    87\t\n    88\t    with pytest.raises(ValueError, match=r\"^path escapes project root: \"):\n    89\t        _paths.resolve_project_path(root, \"../outside.py\")\n    90\t\n    91\t\n    92\tdef test_resolve_project_path_rejects_absolute_external_path(tmp_path):\n    93\t    root = tmp_path / \"project\"\n    94\t    root.mkdir()\n    95\t    outside = tmp_path / \"outside.py\"\n    96\t\n    97\t    with pytest.raises(ValueError, match=r\"^path escapes project root: \"):\n    98\t        _paths.resolve_project_path(root, outside)\n    99\t\n   100\t\n   101\tdef test_resolve_project_path_rejects_symlink_escape(tmp_path):\n   102\t    root = tmp_path / \"project\"\n   103\t    root.mkdir()\n   104\t    outside = tmp_path / \"outside\"\n   105\t    outside.mkdir()\n   106\t    (root / \"linked\").symlink_to(outside, target_is_directory=True)\n   107\t\n   108\t    with pytest.raises(ValueError, match=r\"^path escapes project root: \"):\n   109\t        _paths.resolve_project_path(root, \"linked/secret.py\")\n86:_PROJECT_ROOT: Path | None = None\n93:    global _PROJECT_ROOT\n98:    _PROJECT_ROOT = root\n320:    if _PROJECT_ROOT is None:\n322:    return connect(_paths.db_path(_PROJECT_ROOT))\n325:def _project_relative_path(path: str) -> str:\n327:    if _PROJECT_ROOT is None:\n329:    resolved = _paths.resolve_project_path(_PROJECT_ROOT, path)\n330:    return resolved.relative_to(_PROJECT_ROOT.resolve()).as_posix()\n355:        return search_files(conn, query, limit=limit, project_root=_PROJECT_ROOT)\n376:        return search_symbols(conn, query, limit=limit, project_root=_PROJECT_ROOT)\n392:            project_root=_PROJECT_ROOT,\n414:            project_root=_PROJECT_ROOT,\n425:        return file_neighbors(conn, path, limit=limit, project_root=_PROJECT_ROOT)\n436:            project_root=_PROJECT_ROOT,\n449:            conn, path, depth=depth, limit=limit, project_root=_PROJECT_ROOT\n464:        return find_tests(conn, path, limit=limit, project_root=_PROJECT_ROOT)\n469:    assert _PROJECT_ROOT is not None\n471:        return changed_context(conn, _PROJECT_ROOT)\n490:            project_root=_PROJECT_ROOT,\n581:            conn, path, expand=expand, limit=limit, project_root=_PROJECT_ROOT\n613:    assert _PROJECT_ROOT is not None\n622:            project_root=_PROJECT_ROOT,\n635:    assert _PROJECT_ROOT is not None\n637:        return blast_radius(conn, path, max_hops=max_hops, project_root=_PROJECT_ROOT)\n693:    assert _PROJECT_ROOT is not None\n701:            project_root=_PROJECT_ROOT,\n716:            conn, query, k_prompts=k_prompts, limit=limit, project_root=_PROJECT_ROOT\n731:    assert _PROJECT_ROOT is not None\n739:            project_root=_PROJECT_ROOT,\n759:    assert _PROJECT_ROOT is not None\n768:            project_root=_PROJECT_ROOT,\n783:    assert _PROJECT_ROOT is not None\n790:            project_root=_PROJECT_ROOT,\n806:    assert _PROJECT_ROOT is not None\n813:            project_root=_PROJECT_ROOT,\n840:    assert _PROJECT_ROOT is not None\n842:        _PROJECT_ROOT,\n865:    assert _PROJECT_ROOT is not None\n866:    resp = daemon_client.post(_PROJECT_ROOT, \"/explain\", {\"query\": query})\n882:    assert _PROJECT_ROOT is not None\n883:    health = daemon_client.health(_PROJECT_ROOT)\n893:        _PROJECT_ROOT,\n968:        return _impl_ken_find_tests(_project_relative_path(query), limit=limit)\n981:def ken_read(\n1000:    path = _project_relative_path(path)\n1070:        return _impl_ken_file_neighbors(_project_relative_path(target), limit=limit)\n1073:            _project_relative_path(target), depth=depth, limit=limit\n1087:            _project_relative_path(target),\n1093:            _project_relative_path(target), max_hops=max(1, depth)\n1096:        return _impl_ken_clones(path=_project_relative_path(target), limit=limit)\n[project]\nname = \"ken-rank\"\n# Single-sourced from src/ken/__init__.py — see [tool.hatch.version]. Keeping a\n# literal here as well is what shipped 0.5.0 and 0.7.0 with `ken --version`\n# reporting the *previous* release: two places to bump, one of them easy to miss.\ndynamic = [\"version\"]\ndescription = \"Per-project context-rank index for Claude Code, served from a local daemon.\"\nreadme = \"README.md\"\nrequires-python = \">=3.11\"\nlicense = { text = \"MIT\" }\nauthors = [{ name = \"Andres\" }]\ndependencies = [\n    \"tree-sitter>=0.25.2\",\n    \"tree-sitter-python>=0.23\",\n    \"tree-sitter-rust>=0.23\",\n    \"tree-sitter-javascript>=0.23\",\n    \"tree-sitter-typescript>=0.23\",\n    \"tree-sitter-go>=0.23\",\n    \"tree-sitter-java>=0.23\",\n    # Dart has no standalone tree-sitter wheel on PyPI; the language-pack\n    # bundles the grammar (and pins tree-sitter>=0.25.2, hence the bump above).\n    \"tree-sitter-language-pack>=1.8\",\n    \"pathspec>=0.12\",\n    \"watchfiles>=0.22\",\n    # fastembed brings ONNX Runtime + a managed all-MiniLM-L6-v2 download\n    # (~25 MB cached in ~/.cache/fastembed on first use). 384-dim, fast on\n    # CPU; same model infinidev runs in production.\n    \"fastembed>=0.5\",\n    \"numpy>=1.26\",\n    # MCP SDK — exposes ken's tools to Claude Code over stdio.\n    # Pinned to the 2.x line: 2.0 renamed ``FastMCP`` to ``MCPServer``\n    # and moved it to ``mcp.server``; 0.10.0 of ken-rank shipped with the\n    # older ``mcp>=1.0`` pin by accident, so older installs may have\n    # resolved mcp 1.x — and then the MCP server silently failed at\n    # import. ``<3`` keeps 3.x out until we verify it (the 3.x line is\n    # not yet on PyPI as of writing).\n    \"mcp>=2.0,<3\",\n]\n\n[project.optional-dependencies]\n# GPU embedding for the default (fastembed) backend. `pip install\n# ken-rank[gpu]` swaps in fastembed's GPU build (it pulls onnxruntime-gpu).\n# The embedder then auto-detects a CUDA/ROCm provider and uses it, falling\n# back to CPU when none is usable — so this extra is purely opt-in\n# acceleration and never a hard requirement. The pulled onnxruntime-gpu\n# targets a specific CUDA major; if it does not match the host's CUDA\n# runtime, ken logs a warning and stays on CPU rather than failing. Pin\n# onnxruntime-gpu yourself if you need a specific CUDA line.\n#\n# Not installable on macOS: onnxruntime-gpu publishes Linux and Windows wheels\n# only, so without the marker `pip install 'ken-rank[gpu]'` fails outright on a\n# Mac. There is nothing to offer instead — ONNX Runtime has no MPS provider, so\n# the fastembed backend stays on the CPU there (where its small models are\n# already fast). Apple Silicon GPU acceleration lives in the `torch` extra.\ngpu = [\"fastembed-gpu>=0.5; sys_platform != 'darwin'\"]\n\n# The torch backend: `pip install ken-rank[torch]` adds sentence-transformers\n# (which pulls torch) so ken can run stronger models fastembed does not ship —\n# e.g. Qwen/Qwen3-Embedding-0.6B (top of ken's retrieval benchmark) or\n# BAAI/bge-m3. Heavier install; entirely opt-in. Switch a project onto one\n# with `ken reembed --model <name>` after installing this extra. Also\n# GPU-aware: CUDA, or Apple Silicon's MPS, whichever torch sees.\n#\n# The two version floors are not cosmetic. sentence-transformers only requires\n# transformers>=4.34, but the Qwen3 architecture landed in 4.51 — below it the\n# model dies with `KeyError: 'qwen3'`, naming neither the cause nor the fix. And\n# torch below 2.9 could return silently wrong embeddings on MPS (pytorch#163597,\n# fixed in 2.9.0), so Apple Silicon gets a floor that costs Linux users nothing;\n# it is scoped to arm64 because PyPI has no torch 2.9 for Intel Macs, where MPS\n# does not exist anyway.\ntorch = [\n    \"sentence-transformers>=3.0\",\n    \"transformers>=4.51\",\n    \"torch>=2.9; sys_platform == 'darwin' and platform_machine == 'arm64'\",\n]\n\n[project.scripts]\nken = \"ken.cli:main\"\n\n[dependency-groups]\ndev = [\n    \"mypy>=1.15\",\n    \"pytest>=8.0\",\n]\n\n[build-system]\nrequires = [\"hatchling\"]\nbuild-backend = \"hatchling.build\"\n\n# The one place the version lives. hatchling reads __version__ out of this file\n# at build time, so the package metadata and what `ken --version` prints cannot\n# disagree — they are the same string.\n[tool.hatch.version]\npath = \"src/ken/__init__.py\"\n\n[tool.hatch.build.targets.wheel]\npackages = [\"src/ken\"]\n\n[tool.hatch.build.targets.sdist]\ninclude = [\"src/ken\", \"README.md\", \"LICENSE\", \"pyproject.toml\"]\n\n[tool.pytest.ini_options]\ntestpaths = [\"tests\"]\naddopts = \"-q\"\n\n[tool.mypy]\npython_version = \"3.12\"\nfiles = [\"src/ken\"]\nshow_error_codes = true\nwarn_unused_configs = true\n\n# Incremental typing gate: these existing modules have known annotation debt.\n# They remain part of mypy's import graph, while every other module — and every\n# new module — must stay clean. Remove entries as their annotations are fixed.\n[[tool.mypy.overrides]]\nmodule = [\n    \"ken.cli\",\n    \"ken.embedder.onnx_fastembed\",\n    \"ken.embedder.st_backend\",\n    \"ken.embedder.static_head\",\n    \"ken.findings_graph\",\n    \"ken.graphtools\",\n    \"ken.indexer\",\n    \"ken.mcp.server\",\n    \"ken.parsers.cpp\",\n    \"ken.parsers.dart\",\n    \"ken.parsers.php\",\n    \"ken.parsers.sql\",\n    \"ken.ranker.output\",\n    \"ken.reembed\",\n    \"ken.status\",\n    \"ken.structure\",\n    \"ken.vectors\",\n]\nignore_errors = true\n","exit_code":0,"status":"completed"}}
