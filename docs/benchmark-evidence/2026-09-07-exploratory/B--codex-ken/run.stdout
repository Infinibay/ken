{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'def main|args.command|serve\\\\(|mcp|_require|no .ken|no ken|client.post|daemon unavailable' src/ken/cli.py src/ken/mcp/server.py; nl -ba src/ken/daemon/server.py | sed -n '1050,1160p'; nl -ba src/ken/cli.py | sed -n '780,825p;1680,1715p;1785,1845p'; rg -n 'meta|auth_token|def install' src/ken/install.py; rg -n 'spawn|timeout|port|missing|root' tests/test_daemon_http_resilience.py tests/test_daemon_helpers.py tests/test_mcp_startup.py tests/test_paths.py; ls -d .venv\"","aggregated_output":"src/ken/mcp/server.py:1:\"\"\"stdio MCP server — entrypoint for ``ken mcp``.\nsrc/ken/mcp/server.py:3:Built on the official ``mcp`` Python SDK v2. The old ``FastMCP`` class\nsrc/ken/mcp/server.py:4:was renamed to ``MCPServer``; the decorator API (``@mcp.tool()``) is the\nsrc/ken/mcp/server.py:25:    from mcp.server import MCPServer\nsrc/ken/mcp/server.py:30:        _installed = _pkg_version(\"mcp\")\nsrc/ken/mcp/server.py:35:        \"ken mcp: this build of ken needs the `mcp` Python SDK >= 2.0, but the\\n\"\nsrc/ken/mcp/server.py:37:        \"The MCP server cannot start with that version — `mcp.server.MCPServer`\\n\"\nsrc/ken/mcp/server.py:38:        \"only exists in mcp 2.x; mcp 1.x still ships the older `FastMCP` API.\\n\"\nsrc/ken/mcp/server.py:41:        \"with the wrong `mcp>=1.0` pin in 0.10.0) was installed before the\\n\"\nsrc/ken/mcp/server.py:51:        \"Codex, OpenCode, …) so it respawns the `ken mcp` process.\\n\"\nsrc/ken/mcp/server.py:80:logger = logging.getLogger(\"ken.mcp\")\nsrc/ken/mcp/server.py:82:# Each `ken mcp` is a *single project* server — coding agents launch\nsrc/ken/mcp/server.py:88:mcp = MCPServer(\"ken\")\nsrc/ken/mcp/server.py:96:        print(f\"ken mcp: no .ken project at {root}\", file=sys.stderr)\nsrc/ken/mcp/server.py:104:    logger.info(\"ken mcp ready project_root=%s\", root)\nsrc/ken/mcp/server.py:105:    mcp.run(transport=\"stdio\")\nsrc/ken/mcp/server.py:114:# mirror each ``@mcp.tool()`` registration into ``_REGISTRY`` via the\nsrc/ken/mcp/server.py:122:    Mirrors the public surface of the old ``fastmcp.Tool`` object that\nsrc/ken/mcp/server.py:123:    ``ken tools ...`` was reading via ``mcp._tool_manager.list_tools()``:\nsrc/ken/mcp/server.py:194:    mcp.add_tool(fn)\nsrc/ken/mcp/server.py:337:# (``@mcp.tool()`` now lives on ``MCPServer`` instead of ``FastMCP``);\nsrc/ken/mcp/server.py:841:    resp = daemon_client.post(\nsrc/ken/mcp/server.py:866:    resp = daemon_client.post(_PROJECT_ROOT, \"/explain\", {\"query\": query})\nsrc/ken/mcp/server.py:892:    resp = daemon_client.post(\nsrc/ken/cli.py:388:    p_mcp = sub.add_parser(\"mcp\", help=\"run as MCP stdio server\")\nsrc/ken/cli.py:389:    p_mcp.add_argument(\nsrc/ken/cli.py:434:def main(argv: list[str] | None = None) -> int:\nsrc/ken/cli.py:596:        return serve(Path(args.path), background=args.background)\nsrc/ken/cli.py:603:    if args.cmd == \"mcp\":\nsrc/ken/cli.py:604:        from ken.mcp.server import run as run_mcp\nsrc/ken/cli.py:606:        return run_mcp(Path(args.path))\nsrc/ken/cli.py:733:    resp = daemon_client.post(\nsrc/ken/cli.py:744:    resp = daemon_client.post(\nsrc/ken/cli.py:805:        print(f\"error: no .ken project at {root}\", file=sys.stderr)\nsrc/ken/cli.py:834:        print(f\"error: no .ken project at {root}\", file=sys.stderr)\nsrc/ken/cli.py:855:        print(f\"error: no .ken project at {root}\", file=sys.stderr)\nsrc/ken/cli.py:880:        print(f\"error: no .ken project at {root}\", file=sys.stderr)\nsrc/ken/cli.py:906:        print(f\"error: no .ken project at {root}\", file=sys.stderr)\nsrc/ken/cli.py:934:        print(f\"error: no .ken project at {root}\", file=sys.stderr)\nsrc/ken/cli.py:964:        print(f\"error: no .ken project at {root}\", file=sys.stderr)\nsrc/ken/cli.py:990:        print(f\"error: no .ken project at {root}\", file=sys.stderr)\nsrc/ken/cli.py:1028:        print(f\"error: no ken index at {root}\", file=sys.stderr)\nsrc/ken/cli.py:1137:        print(f\"error: no .ken project at {root}\", file=sys.stderr)\nsrc/ken/cli.py:1341:        print(f\"error: no .ken project at {root}\", file=sys.stderr)\nsrc/ken/cli.py:1661:    from the same ``FastMCP`` object ``ken mcp`` serves, so this stays in\nsrc/ken/cli.py:1665:    from ken.mcp import server as mcp_server\nsrc/ken/cli.py:1667:    registry = {t.name: t for t in mcp_server.list_tools()}\nsrc/ken/cli.py:1697:        print(f\"error: no .ken project at {root}\", file=sys.stderr)\nsrc/ken/cli.py:1699:    mcp_server._PROJECT_ROOT = root\nsrc/ken/cli.py:1767:        is_required = name in required\nsrc/ken/cli.py:1780:            if is_required:\nsrc/ken/cli.py:1795:            if is_required:\n  1050\t        super().__init__(addr, _Handler)\n  1051\t        self.state = state\n  1052\t\n  1053\t\n  1054\tdef run(project_root: Path) -> int:\n  1055\t    \"\"\"Daemon entrypoint. Binds a free localhost port, advertises it via\n  1056\t    ``.ken/daemon.port``, serves until idle / empty / explicit shutdown.\n  1057\t    \"\"\"\n  1058\t    project_root = project_root.resolve()\n  1059\t    meta_p = _paths.meta_path(project_root)\n  1060\t    if not meta_p.is_file():\n  1061\t        print(f\"ken: no .ken/meta.json at {project_root}\", flush=True)\n  1062\t        return 2\n  1063\t    meta = json.loads(meta_p.read_text(encoding=\"utf-8\"))\n  1064\t    state = DaemonState(project_root, meta[\"auth_token\"])\n  1065\t    set_meta(state.conn, \"ken_version\", _ken_version())\n  1066\t\n  1067\t    server = _ThreadingServer((\"127.0.0.1\", 0), state)\n  1068\t    bound_port = server.server_address[1]\n  1069\t    _write_runtime_files(project_root, port=bound_port, pid=os.getpid())\n  1070\t\n  1071\t    logger.info(\n  1072\t        \"ken daemon ready project_root=%s pid=%s port=%s\",\n  1073\t        project_root,\n  1074\t        os.getpid(),\n  1075\t        bound_port,\n  1076\t    )\n  1077\t\n  1078\t    # Start accepting HTTP before background maintenance. On very large\n  1079\t    # repositories the warm pass can take longer than the hook client's\n  1080\t    # spawn wait; serving first keeps /health responsive and prevents a\n  1081\t    # false \"daemon unreachable\" on first prompt.\n  1082\t    sd_watcher = threading.Thread(target=_shutdown_watcher, args=(state,), daemon=True)\n  1083\t    sd_watcher.start()\n  1084\t    serve_thread = threading.Thread(target=server.serve_forever, daemon=True)\n  1085\t    serve_thread.start()\n  1086\t\n  1087\t    maintenance: dict[str, Any] = {}\n  1088\t    maintenance_thread = threading.Thread(\n  1089\t        target=_maintenance_loop,\n  1090\t        args=(state, maintenance),\n  1091\t        name=\"ken-maintenance-startup\",\n  1092\t        daemon=True,\n  1093\t    )\n  1094\t    maintenance_thread.start()\n  1095\t\n  1096\t    state.shutdown_event.wait()\n  1097\t    logger.info(\"ken daemon shutting down\")\n  1098\t    _finalize_active_sessions(state)\n  1099\t    server.shutdown()\n  1100\t    server.server_close()\n  1101\t    file_watcher = maintenance.get(\"file_watcher\")\n  1102\t    if file_watcher is not None:\n  1103\t        file_watcher.stop()\n  1104\t    index_queue = maintenance.get(\"index_queue\")\n  1105\t    if index_queue is not None:\n  1106\t        index_queue.stop()\n  1107\t    maintenance_thread.join(timeout=5.0)\n  1108\t    state.conn.close()\n  1109\t    _clear_runtime_files(project_root)\n  1110\t    return 0\n  1111\t\n  1112\t\n  1113\tdef _maintenance_loop(state: DaemonState, holder: dict[str, Any]) -> None:\n  1114\t    if state.shutdown_event.wait(MAINTENANCE_START_DELAY_S):\n  1115\t        return\n  1116\t\n  1117\t    project_root = state.project_root\n  1118\t    # Index queue + file watcher run in their own threads with their own\n  1119\t    # SQLite connections. We start the queue first so the watcher's first\n  1120\t    # events have a worker to hand off to.\n  1121\t    #\n  1122\t    # The embedder is the *singleton* — `get_embedder()` returns the same\n  1123\t    # instance the request handlers use for cr_contexts embeddings, so we\n  1124\t    # only pay one model-load cost per process.\n  1125\t    index_queue = IndexQueue(project_root, embedder=get_embedder())\n  1126\t    if state.shutdown_event.is_set():\n  1127\t        return\n  1128\t    index_queue.start()\n  1129\t    holder[\"index_queue\"] = index_queue\n  1130\t\n  1131\t    file_watcher = FileWatcher(project_root, index_queue)\n  1132\t    file_watcher.start()\n  1133\t    holder[\"file_watcher\"] = file_watcher\n  1134\t\n  1135\t    # Warm pass: enqueue every gitignore-respecting file. The indexer\n  1136\t    # short-circuits on content_hash so this is cheap on a clean DB —\n  1137\t    # but it catches anything that changed while the daemon was dead\n  1138\t    # (between sessions, after a `git pull`, …).\n  1139\t    warm_count = 0\n  1140\t    for rel in iter_files(project_root):\n  1141\t        if state.shutdown_event.is_set():\n  1142\t            break\n  1143\t        index_queue.reindex(rel.as_posix())\n  1144\t        warm_count += 1\n  1145\t    logger.info(\"warm pass: queued %s files for hash-skip / reindex\", warm_count)\n  1146\t\n  1147\t\n  1148\tdef _shutdown_watcher(state: DaemonState) -> None:\n  1149\t    while not state.shutdown_event.is_set():\n  1150\t        if state.shutdown_event.wait(SHUTDOWN_TICK_S):\n  1151\t            return\n  1152\t        reason = state.should_shutdown()\n  1153\t        if reason is not None:\n  1154\t            logger.info(\"shutdown trigger: %s\", reason)\n  1155\t            state.shutdown_event.set()\n  1156\t            return\n  1157\t\n  1158\t\n  1159\tdef _finalize_active_sessions(state: DaemonState) -> None:\n  1160\t    \"\"\"Snapshot and close any sessions still active when the daemon exits.\"\"\"\n   780\t    )\n   781\t    return (\n   782\t        f\"context: {chars} chars, \"\n   783\t        f\"~{est_tokens} tokens; \"\n   784\t        f\"files={int(resp.get('files') or 0)}, \"\n   785\t        f\"symbols={int(resp.get('symbols') or 0)}, \"\n   786\t        f\"findings={int(resp.get('findings') or 0)}\"\n   787\t    )\n   788\t\n   789\t\n   790\tdef _search_cli(\n   791\t    project_path: Path, query: str, limit: int, *, kind: str, as_json: bool\n   792\t) -> int:\n   793\t    from ken import _paths\n   794\t    from ken.db import connect\n   795\t    from ken.search import (\n   796\t        format_file_hits,\n   797\t        format_symbol_hits,\n   798\t        search_files,\n   799\t        search_symbols,\n   800\t    )\n   801\t\n   802\t    root = _paths.find_project_root(project_path.resolve()) or project_path.resolve()\n   803\t    db_path = _paths.db_path(root)\n   804\t    if not db_path.is_file():\n   805\t        print(f\"error: no .ken project at {root}\", file=sys.stderr)\n   806\t        return 1\n   807\t    with connect(db_path) as conn:\n   808\t        if kind == \"files\":\n   809\t            hits = search_files(conn, query, limit=limit, project_root=root)\n   810\t            rendered = format_file_hits(hits)\n   811\t        else:\n   812\t            hits = search_symbols(conn, query, limit=limit, project_root=root)\n   813\t            rendered = format_symbol_hits(hits)\n   814\t    if as_json:\n   815\t        print(json.dumps(hits, indent=2))\n   816\t    elif rendered:\n   817\t        print(rendered)\n   818\t    return 0\n   819\t\n   820\t\n   821\tdef _remember_cli(\n   822\t    project_path: Path,\n   823\t    topic: str,\n   824\t    content: str,\n   825\t    *,\n  1680\t        ]\n  1681\t        suggestions = difflib.get_close_matches(tool_name, candidates, n=3, cutoff=0.5)\n  1682\t        if suggestions:\n  1683\t            print(f\"did you mean: {', '.join(suggestions)}\", file=sys.stderr)\n  1684\t        else:\n  1685\t            print(\"run `ken tools` to list available tools\", file=sys.stderr)\n  1686\t        return 2\n  1687\t\n  1688\t    tool_parser = _build_tool_parser(tool)\n  1689\t    ns = tool_parser.parse_args(tool_argv)\n  1690\t    props = tool.parameters.get(\"properties\", {})\n  1691\t    kwargs = {name: getattr(ns, name) for name in props if hasattr(ns, name)}\n  1692\t\n  1693\t    from ken import _paths\n  1694\t\n  1695\t    root = _paths.find_project_root(project_path.resolve()) or project_path.resolve()\n  1696\t    if not _paths.meta_path(root).is_file():\n  1697\t        print(f\"error: no .ken project at {root}\", file=sys.stderr)\n  1698\t        return 1\n  1699\t    mcp_server._PROJECT_ROOT = root\n  1700\t\n  1701\t    try:\n  1702\t        result = tool.fn(**kwargs)\n  1703\t        if tool.is_async:\n  1704\t            import asyncio\n  1705\t\n  1706\t            result = asyncio.run(result)\n  1707\t    except Exception as exc:  # surface tool errors as a clean CLI failure\n  1708\t        print(f\"error: {tool.name} failed: {exc}\", file=sys.stderr)\n  1709\t        return 1\n  1710\t\n  1711\t    if compact:\n  1712\t        print(json.dumps(result, default=str))\n  1713\t    else:\n  1714\t        print(json.dumps(result, indent=2, default=str))\n  1715\t    return 0\n  1785\t                parser.add_argument(\n  1786\t                    flag,\n  1787\t                    dest=name,\n  1788\t                    nargs=\"*\",\n  1789\t                    type=item_type,\n  1790\t                    default=default,\n  1791\t                    help=\"space-separated list\",\n  1792\t                )\n  1793\t        else:\n  1794\t            py_type = _tool_py_type(json_type)\n  1795\t            if is_required:\n  1796\t                parser.add_argument(\n  1797\t                    name, type=py_type, help=f\"{json_type or 'string'} (required)\"\n  1798\t                )\n  1799\t            else:\n  1800\t                parser.add_argument(\n  1801\t                    flag,\n  1802\t                    dest=name,\n  1803\t                    type=py_type,\n  1804\t                    default=default,\n  1805\t                    help=f\"{json_type or 'string'} (default: {default!r})\",\n  1806\t                )\n  1807\t    return parser\n  1808\t\n  1809\t\n  1810\tdef _resolve_project_db(project_path: Path) -> tuple[Path, Path | None]:\n  1811\t    from ken import _paths\n  1812\t\n  1813\t    root = _paths.find_project_root(project_path.resolve()) or project_path.resolve()\n  1814\t    db_path = _paths.db_path(root)\n  1815\t    return root, db_path if db_path.is_file() else None\n5:  2. Generate a project_id (uuid) + auth token, persist to `.ken/meta.json`.\n42:from ken.db import connect, init_schema, set_meta\n92:def install(\n105:    ``no_wire=True`` indexes the project and provisions ``.ken/`` (meta,\n120:    # Step 1: meta.json — generate a project id + auth token if missing.\n121:    meta_p = _paths.meta_path(root)\n122:    if meta_p.is_file():\n123:        meta = json.loads(meta_p.read_text(encoding=\"utf-8\"))\n125:            print(f\"[meta] reusing existing project_id={meta['project_id']}\")\n127:        meta = {\n129:            \"auth_token\": secrets.token_urlsafe(32),\n133:        meta_p.write_text(json.dumps(meta, indent=2) + \"\\n\", encoding=\"utf-8\")\n135:            print(f\"[meta] created .ken/meta.json (project_id={meta['project_id']})\")\n143:        set_meta(conn, \"project_id\", meta[\"project_id\"])\n144:        set_meta(conn, \"ken_version\", _ken_version())\n280:        project_id=meta[\"project_id\"],\ntests/test_mcp_startup.py:3:The MCP server imports ``mcp.server.MCPServer``, which only exists in the\ntests/test_mcp_startup.py:6:would crash at import with a raw ``ImportError`` — the assistant would\ntests/test_mcp_startup.py:10:The guard in ``ken.mcp.server`` catches that import failure and writes\ntests/test_mcp_startup.py:12:exercises that path by stubbing the ``mcp.server`` import to raise.\ntests/test_mcp_startup.py:15:from __future__ import annotations\ntests/test_mcp_startup.py:17:import builtins\ntests/test_mcp_startup.py:18:import importlib\ntests/test_mcp_startup.py:19:from pathlib import Path\ntests/test_mcp_startup.py:20:import sys\ntests/test_mcp_startup.py:21:import tomllib\ntests/test_mcp_startup.py:22:from unittest.mock import patch\ntests/test_mcp_startup.py:24:import pytest\ntests/test_mcp_startup.py:45:def test_mcp_server_exits_with_remediation_when_mcpserver_missing(capsys):\ntests/test_mcp_startup.py:49:    # Drop any cached version so the patched import actually runs.\ntests/test_mcp_startup.py:52:    real_import = builtins.__import__\ntests/test_mcp_startup.py:56:            raise ImportError(\ntests/test_mcp_startup.py:57:                \"cannot import name 'MCPServer' from 'mcp.server' (stubbed); \"\ntests/test_mcp_startup.py:60:        return real_import(name, globals, locals, fromlist, level)\ntests/test_mcp_startup.py:63:        with patch.object(builtins, \"__import__\", side_effect=_raise):\ntests/test_mcp_startup.py:65:                importlib.import_module(\"ken.mcp.server\")\ntests/test_paths.py:1:\"\"\"Project root discovery + path helpers.\"\"\"\ntests/test_paths.py:3:from __future__ import annotations\ntests/test_paths.py:5:import os\ntests/test_paths.py:6:from pathlib import Path\ntests/test_paths.py:8:import pytest\ntests/test_paths.py:10:from ken import _paths\ntests/test_paths.py:13:def test_find_project_root_walks_up(tmp_path):\ntests/test_paths.py:14:    root = tmp_path / \"proj\"\ntests/test_paths.py:15:    (root / \".ken\").mkdir(parents=True)\ntests/test_paths.py:16:    (root / \".ken\" / \"meta.json\").write_text(\"{}\")\ntests/test_paths.py:17:    nested = root / \"a\" / \"b\" / \"c\"\ntests/test_paths.py:19:    found = _paths.find_project_root(start=nested)\ntests/test_paths.py:21:    assert found.resolve() == root.resolve()\ntests/test_paths.py:24:def test_find_project_root_returns_none_when_missing(tmp_path):\ntests/test_paths.py:30:        result = _paths.find_project_root(start=tmp_path)\ntests/test_paths.py:34:            # If it found something, at least confirm it's a valid project root.\ntests/test_paths.py:41:def test_find_project_root_respects_env_var(tmp_path, monkeypatch):\ntests/test_paths.py:42:    root = tmp_path / \"envproj\"\ntests/test_paths.py:43:    (root / \".ken\").mkdir(parents=True)\ntests/test_paths.py:44:    (root / \".ken\" / \"meta.json\").write_text(\"{}\")\ntests/test_paths.py:45:    monkeypatch.setenv(\"KEN_PROJECT_ROOT\", str(root))\ntests/test_paths.py:49:    found = _paths.find_project_root(start=other)\ntests/test_paths.py:51:    assert found.resolve() == root.resolve()\ntests/test_paths.py:59:    assert _paths.find_project_root() is None\ntests/test_paths.py:63:    root = tmp_path\ntests/test_paths.py:64:    assert _paths.ken_dir(root) == root / \".ken\"\ntests/test_paths.py:65:    assert _paths.meta_path(root) == root / \".ken\" / \"meta.json\"\ntests/test_paths.py:66:    assert _paths.db_path(root) == root / \".ken\" / \"ken.db\"\ntests/test_paths.py:67:    assert _paths.port_path(root) == root / \".ken\" / \"daemon.port\"\ntests/test_paths.py:68:    assert _paths.pid_path(root) == root / \".ken\" / \"daemon.pid\"\ntests/test_paths.py:69:    assert _paths.log_path(root) == root / \".ken\" / \"daemon.log\"\ntests/test_paths.py:74:    root = tmp_path / \"project\"\ntests/test_paths.py:75:    source = root / \"src\" / \"module.py\"\ntests/test_paths.py:81:    assert _paths.resolve_project_path(root, supplied) == source.resolve()\ntests/test_paths.py:85:    root = tmp_path / \"project\"\ntests/test_paths.py:86:    root.mkdir()\ntests/test_paths.py:88:    with pytest.raises(ValueError, match=r\"^path escapes project root: \"):\ntests/test_paths.py:89:        _paths.resolve_project_path(root, \"../outside.py\")\ntests/test_paths.py:93:    root = tmp_path / \"project\"\ntests/test_paths.py:94:    root.mkdir()\ntests/test_paths.py:97:    with pytest.raises(ValueError, match=r\"^path escapes project root: \"):\ntests/test_paths.py:98:        _paths.resolve_project_path(root, outside)\ntests/test_paths.py:102:    root = tmp_path / \"project\"\ntests/test_paths.py:103:    root.mkdir()\ntests/test_paths.py:106:    (root / \"linked\").symlink_to(outside, target_is_directory=True)\ntests/test_paths.py:108:    with pytest.raises(ValueError, match=r\"^path escapes project root: \"):\ntests/test_paths.py:109:        _paths.resolve_project_path(root, \"linked/secret.py\")\ntests/test_daemon_helpers.py:3:from __future__ import annotations\ntests/test_daemon_helpers.py:5:import sqlite3\ntests/test_daemon_helpers.py:6:from pathlib import Path\ntests/test_daemon_helpers.py:8:import pytest\ntests/test_daemon_helpers.py:10:from ken.daemon.server import _classify_tool, _extract_cited_paths\ntests/test_daemon_helpers.py:11:from ken.db import init_schema\ntests/test_daemon_http_resilience.py:3:from __future__ import annotations\ntests/test_daemon_http_resilience.py:5:from ken.daemon import client\ntests/test_daemon_http_resilience.py:6:from ken.daemon.server import _Handler\ntests/test_daemon_http_resilience.py:9:def test_ranking_endpoints_get_longer_post_timeout():\ntests/test_daemon_http_resilience.py:10:    assert client._post_timeout(\"/prompts\") == client.RANK_POST_TIMEOUT_S\ntests/test_daemon_http_resilience.py:11:    assert client._post_timeout(\"/rank\") == client.RANK_POST_TIMEOUT_S\ntests/test_daemon_http_resilience.py:12:    assert client._post_timeout(\"/explain\") == client.RANK_POST_TIMEOUT_S\ntests/test_daemon_http_resilience.py:15:def test_lifecycle_endpoints_keep_short_post_timeout():\ntests/test_daemon_http_resilience.py:16:    assert client._post_timeout(\"/sessions/start\") == client.POST_TIMEOUT_S\ntests/test_daemon_http_resilience.py:17:    assert client._post_timeout(\"/tools/pre\") == client.POST_TIMEOUT_S\ntests/test_daemon_http_resilience.py:18:    assert client._post_timeout(\"/turn-end\") == client.POST_TIMEOUT_S\ntests/test_daemon_http_resilience.py:21:def test_post_timeout_does_not_respawn_daemon(monkeypatch, tmp_path):\ntests/test_daemon_http_resilience.py:22:    monkeypatch.setattr(client, \"_read_port\", lambda _root: 12345)\ntests/test_daemon_http_resilience.py:24:    def timeout_request(*_args, **_kwargs):\ntests/test_daemon_http_resilience.py:27:    def fail_spawn(_root):\ntests/test_daemon_http_resilience.py:28:        raise AssertionError(\"timeout should not clear port and spawn\")\ntests/test_daemon_http_resilience.py:30:    monkeypatch.setattr(client, \"_request\", timeout_request)\ntests/test_daemon_http_resilience.py:31:    monkeypatch.setattr(client, \"_spawn_and_wait\", fail_spawn)\ntests/test_daemon_http_resilience.py:33:    assert client._post_with_spawn(tmp_path, \"/rank\", {}) is None\nls: .venv: No such file or directory\n","exit_code":1,"status":"failed"}}
{"type":"item.completed","item":{"id":"item_11","type":"agent_message","text":"El proyecto se reconoce por `.ken/meta.json`: desde un subdirectorio busca hacia arriba, salvo que `KEN_PROJECT_ROOT` fuerce otra ubicación. También confirmé que un timeout del POST conserva el puerto y no arranca otro daemon; ahora estoy comprobando las demás ramas y cómo llegan sus errores a hooks, CLI y MCP.\n"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/ken/cli.py | sed -n '365,405p;585,620p;690,765p'; nl -ba src/ken/mcp/server.py | sed -n '280,335p;824,912p'; nl -ba src/ken/daemon/server.py | sed -n '90,142p;1170,1195p'; rg -n 'Authorization|unauthorized|def do_GET|/health|def connect' src/ken/daemon/server.py src/ken/db.py; nl -ba src/ken/install.py | sed -n '110,147p'; cat tests/conftest.py; command -v python3; python3 -c 'import pytest; print(pytest.__version__)'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/ken/cli.py | sed -n '365,405p;585,620p;690,765p'; nl -ba src/ken/mcp/server.py | sed -n '280,335p;824,912p'; nl -ba src/ken/daemon/server.py | sed -n '90,142p;1170,1195p'; rg -n 'Authorization|unauthorized|def do_GET|/health|def connect' src/ken/daemon/server.py src/ken/db.py; nl -ba src/ken/install.py | sed -n '110,147p'; cat tests/conftest.py; command -v python3; python3 -c 'import pytest; print(pytest.__version__)'\"","aggregated_output":"   365\t    p_fgraph_rebuild.add_argument(\n   366\t        \"--json\", action=\"store_true\", help=\"print raw JSON response\"\n   367\t    )\n   368\t\n   369\t    p_serve = sub.add_parser(\"serve\", help=\"run the ken daemon\")\n   370\t    p_serve.add_argument(\n   371\t        \"path\", nargs=\"?\", default=\".\", help=\"project path (default: cwd)\"\n   372\t    )\n   373\t    p_serve.add_argument(\n   374\t        \"--background\",\n   375\t        action=\"store_true\",\n   376\t        help=\"redirect logs to .ken/daemon.log (used when spawned by a hook)\",\n   377\t    )\n   378\t\n   379\t    p_hook = sub.add_parser(\"hook\", help=\"hook handlers invoked by coding agents\")\n   380\t    hook_sub = p_hook.add_subparsers(dest=\"hook_cmd\", required=True)\n   381\t    hook_sub.add_parser(\"session-start\")\n   382\t    hook_sub.add_parser(\"session-end\")\n   383\t    hook_sub.add_parser(\"user-prompt\")\n   384\t    hook_sub.add_parser(\"stop\")\n   385\t    p_tool = hook_sub.add_parser(\"tool-call\")\n   386\t    p_tool.add_argument(\"--phase\", choices=(\"pre\", \"post\"), required=True)\n   387\t\n   388\t    p_mcp = sub.add_parser(\"mcp\", help=\"run as MCP stdio server\")\n   389\t    p_mcp.add_argument(\n   390\t        \"path\", nargs=\"?\", default=\".\", help=\"project path (default: cwd)\"\n   391\t    )\n   392\t\n   393\t    p_tools = sub.add_parser(\n   394\t        \"tools\",\n   395\t        help=\"invoke a ken MCP tool directly from the CLI\",\n   396\t        description=(\n   397\t            \"Run any tool the ken MCP server exposes, without an agent.\\n\\n\"\n   398\t            \"  ken tools                     list available tools\\n\"\n   399\t            \"  ken tools <name> --help       show a tool's parameters\\n\"\n   400\t            \"  ken tools <name> [ARGS...]    run the tool and print JSON\\n\\n\"\n   401\t            \"The <name> may be given with or without the 'ken_' prefix \"\n   402\t            \"(e.g. 'find' or 'ken_find'). Required parameters are positional; \"\n   403\t            \"optional ones are --flags mirroring the tool's schema.\"\n   404\t        ),\n   405\t        formatter_class=argparse.RawDescriptionHelpFormatter,\n   585\t        return _recall_cli(\n   586\t            Path(args.path),\n   587\t            \" \".join(args.query),\n   588\t            args.limit,\n   589\t            args.min_score,\n   590\t            as_json=args.json,\n   591\t        )\n   592\t\n   593\t    if args.cmd == \"serve\":\n   594\t        from ken.serve import serve\n   595\t\n   596\t        return serve(Path(args.path), background=args.background)\n   597\t\n   598\t    if args.cmd == \"hook\":\n   599\t        from ken.hook import dispatch_hook\n   600\t\n   601\t        return dispatch_hook(args)\n   602\t\n   603\t    if args.cmd == \"mcp\":\n   604\t        from ken.mcp.server import run as run_mcp\n   605\t\n   606\t        return run_mcp(Path(args.path))\n   607\t\n   608\t    if args.cmd == \"tools\":\n   609\t        return _tools_cli(\n   610\t            Path(args.path),\n   611\t            args.tool,\n   612\t            args.tool_args,\n   613\t            list_only=args.list,\n   614\t            compact=args.compact,\n   615\t        )\n   616\t\n   617\t    if args.cmd == \"uninstall\":\n   618\t        from ken.install_uninstall import uninstall\n   619\t\n   620\t        return uninstall(Path(args.path), keep_db=args.keep_db)\n   690\t    try:\n   691\t        subprocess.run(install_cmd, check=True, stdout=stdout, stderr=stderr)\n   692\t    except subprocess.CalledProcessError as exc:\n   693\t        print(\n   694\t            f\"error: project install failed with exit code {exc.returncode}\",\n   695\t            file=sys.stderr,\n   696\t        )\n   697\t        return int(exc.returncode or 1)\n   698\t    return 0\n   699\t\n   700\t\n   701\tdef _read_hook_payload() -> dict:\n   702\t    \"\"\"Read a JSON hook payload from stdin.\n   703\t\n   704\t    Returns an empty dict if stdin is closed, empty, or invalid. Hook\n   705\t    handlers treat that as missing optional signal rather than as a hard\n   706\t    failure because context collection must never block the agent.\n   707\t    \"\"\"\n   708\t    if sys.stdin.isatty():\n   709\t        return {}\n   710\t    raw = sys.stdin.read()\n   711\t    if not raw.strip():\n   712\t        return {}\n   713\t    try:\n   714\t        return json.loads(raw)\n   715\t    except json.JSONDecodeError:\n   716\t        return {}\n   717\t\n   718\t\n   719\tdef _rank_cli(\n   720\t    project_path: Path,\n   721\t    query: str,\n   722\t    verbose: int,\n   723\t    *,\n   724\t    max_chars: int | None,\n   725\t    as_json: bool,\n   726\t    stats: bool,\n   727\t) -> int:\n   728\t    from ken.daemon import client as daemon_client\n   729\t\n   730\t    payload: dict[str, Any] = {\"query\": query.strip(), \"verbose\": verbose}\n   731\t    if max_chars is not None:\n   732\t        payload[\"max_chars\"] = max_chars\n   733\t    resp = daemon_client.post(\n   734\t        project_path.resolve(),\n   735\t        \"/rank\",\n   736\t        payload,\n   737\t    )\n   738\t    return _print_daemon_response(resp, \"context_block\", as_json=as_json, stats=stats)\n   739\t\n   740\t\n   741\tdef _explain_cli(project_path: Path, query: str, *, as_json: bool) -> int:\n   742\t    from ken.daemon import client as daemon_client\n   743\t\n   744\t    resp = daemon_client.post(\n   745\t        project_path.resolve(), \"/explain\", {\"query\": query.strip()}\n   746\t    )\n   747\t    return _print_daemon_response(resp, None, as_json=as_json)\n   748\t\n   749\t\n   750\tdef _print_daemon_response(\n   751\t    resp: dict[str, Any] | None,\n   752\t    text_key: str | None,\n   753\t    *,\n   754\t    as_json: bool,\n   755\t    stats: bool = False,\n   756\t) -> int:\n   757\t    if resp is None:\n   758\t        print(\"error: daemon unreachable\", file=sys.stderr)\n   759\t        return 1\n   760\t    if as_json:\n   761\t        print(json.dumps(resp, indent=2))\n   762\t        return 0 if resp.get(\"ok\") else 1\n   763\t    if not resp.get(\"ok\"):\n   764\t        print(f\"error: {resp.get('error', 'request failed')}\", file=sys.stderr)\n   765\t        return 1\n   280\t        args = [a for a in typing.get_args(annotation) if a is not type(None)]\n   281\t        if len(args) == 1 and len(typing.get_args(annotation)) > 1:\n   282\t            return args[0], True\n   283\t        return annotation, False\n   284\t    return annotation, False\n   285\t\n   286\t\n   287\tdef _literal_schema(core: Any) -> dict[str, Any]:\n   288\t    \"\"\"``Literal[...]`` → a JSON ``enum``, typed when the values agree.\n   289\t\n   290\t    A closed set of values is the difference between a menu and free-form\n   291\t    generation. Without the ``enum``, an agent has to guess what a mode\n   292\t    argument accepts from prose that a host's description compression may\n   293\t    already have trimmed — which is strictly worse than having been handed\n   294\t    separate named tools.\n   295\t    \"\"\"\n   296\t    values = list(typing.get_args(core))\n   297\t    schema: dict[str, Any] = {\"enum\": values}\n   298\t    kinds = {type(v) for v in values}\n   299\t    if len(kinds) == 1:\n   300\t        only = kinds.pop()\n   301\t        if only in _PRIMITIVE_JSON_TYPE:\n   302\t            schema[\"type\"] = _PRIMITIVE_JSON_TYPE[only]\n   303\t    return schema\n   304\t\n   305\t\n   306\tdef _items_schema(args: tuple[Any, ...]) -> dict[str, Any]:\n   307\t    if not args:\n   308\t        return {}\n   309\t    inner, _ = _unwrap_optional(args[0])\n   310\t    if inner in _PRIMITIVE_JSON_TYPE:\n   311\t        return {\"type\": _PRIMITIVE_JSON_TYPE[inner]}\n   312\t    if typing.get_origin(inner) is typing.Literal:\n   313\t        # ``list[Literal[...]]`` — the element enum is the only place that\n   314\t        # says which values the list may hold.\n   315\t        return _literal_schema(inner)\n   316\t    return {}\n   317\t\n   318\t\n   319\tdef _conn() -> sqlite3.Connection:\n   320\t    if _PROJECT_ROOT is None:\n   321\t        raise RuntimeError(\"MCP server not initialised — call run() first\")\n   322\t    return connect(_paths.db_path(_PROJECT_ROOT))\n   323\t\n   324\t\n   325\tdef _project_relative_path(path: str) -> str:\n   326\t    \"\"\"Validate a tool path and return its canonical index representation.\"\"\"\n   327\t    if _PROJECT_ROOT is None:\n   328\t        raise RuntimeError(\"MCP server not initialised — call run() first\")\n   329\t    resolved = _paths.resolve_project_path(_PROJECT_ROOT, path)\n   330\t    return resolved.relative_to(_PROJECT_ROOT.resolve()).as_posix()\n   331\t\n   332\t\n   333\t# ---- MCP server tools ----------------------------------------------\n   334\t#\n   335\t# Same surface as before — same names, same docstrings, same parameter\n   824\t      block.\n   825\t    * ``verbose=1`` — top 5 files with a 3-line outline of each and a\n   826\t      ranked symbols section.\n   827\t    * ``verbose=2`` — top 8 files with a 12-line outline of each plus\n   828\t      symbols. Largest payload.\n   829\t\n   830\t    Set ``max_chars`` to a positive integer to cap the rendered block\n   831\t    by dropping whole interior lines while preserving valid tags.\n   832\t\n   833\t    With *query* empty (default), this re-renders the ranker's cached\n   834\t    output for the most recent prompt — cheap, no recomputation. Pass\n   835\t    a *query* to run the ranker against that intent without reactive\n   836\t    session carry-over.\n   837\t    \"\"\"\n   838\t    from ken.daemon import client as daemon_client\n   839\t\n   840\t    assert _PROJECT_ROOT is not None\n   841\t    resp = daemon_client.post(\n   842\t        _PROJECT_ROOT,\n   843\t        \"/rank\",\n   844\t        {\"query\": query, \"verbose\": int(verbose), \"max_chars\": int(max_chars)},\n   845\t    )\n   846\t    if resp is None:\n   847\t        return {\"ok\": False, \"error\": \"daemon unreachable\"}\n   848\t    return resp\n   849\t\n   850\t\n   851\tdef _impl_ken_explain_rank(query: str = \"\") -> dict:\n   852\t    \"\"\"Per-channel breakdown of the ranker for a query (or the last prompt).\n   853\t\n   854\t    Returns each channel's raw output (traceback/explicit / reactive /\n   855\t    predictive / fuzzy / lexical / findings), the merged pre-boost scores, the per-boost\n   856\t    score deltas (symbol-file affinity, freshness, co-occurrence, test/import\n   857\t    affinity, dismissal penalty), and the final\n   858\t    ordering. Use this when \"why didn't file X show up?\" or \"where did\n   859\t    that score come from?\" matters more than the rendered block.\n   860\t\n   861\t    *query* defaults to the most recent prompt in the active session.\n   862\t    \"\"\"\n   863\t    from ken.daemon import client as daemon_client\n   864\t\n   865\t    assert _PROJECT_ROOT is not None\n   866\t    resp = daemon_client.post(_PROJECT_ROOT, \"/explain\", {\"query\": query})\n   867\t    if resp is None:\n   868\t        return {\"ok\": False, \"error\": \"daemon unreachable\"}\n   869\t    return resp\n   870\t\n   871\t\n   872\tdef _impl_ken_dismiss(target: str, reason: str = \"\") -> dict:\n   873\t    \"\"\"Explicit \"this file wasn't what I was looking for\" signal.\n   874\t\n   875\t    Records a ``dismissed`` interaction against the current active\n   876\t    session — the predictive ranker will treat this target as a negative\n   877\t    example for similar prompts in future sessions.\n   878\t    Requires a running daemon with an active hook-backed session.\n   879\t    \"\"\"\n   880\t    from ken.daemon import client as daemon_client\n   881\t\n   882\t    assert _PROJECT_ROOT is not None\n   883\t    health = daemon_client.health(_PROJECT_ROOT)\n   884\t    if not health or health.get(\"sessions_active\", 0) == 0:\n   885\t        return {\n   886\t            \"ok\": False,\n   887\t            \"error\": (\n   888\t                \"no active session — open a coding agent inside the project \"\n   889\t                \"and try again\"\n   890\t            ),\n   891\t        }\n   892\t    resp = daemon_client.post(\n   893\t        _PROJECT_ROOT,\n   894\t        \"/interactions/dismiss\",\n   895\t        {\"target\": target, \"reason\": reason},\n   896\t    )\n   897\t    if resp is None:\n   898\t        return {\"ok\": False, \"error\": \"daemon unreachable\"}\n   899\t    return resp\n   900\t\n   901\t\n   902\t# ─────────────────────────────────────────────────────────────────────────\n   903\t# The public surface: six tools over the thirty implementations above.\n   904\t#\n   905\t# Thirty tools is a menu no one can read. Anthropic's test for a toolset is\n   906\t# whether *a human engineer* could say unambiguously which one to reach for,\n   907\t# and ``ken_file_symbols`` / ``ken_file_outline`` / ``ken_symbol_detail`` /\n   908\t# ``ken_file_snippets`` fail it — four names for \"tell me about this file\",\n   909\t# separated only by which fields come back.\n   910\t#\n   911\t# The split is deliberate and it is not \"merge everything\":\n   912\t#\n    90\t        self.embed_model = configure_for_project(self.conn)\n    91\t        # agent_id (Claude session uuid) -> {\"pk\": int, \"iter\": int, \"started_at\": int}\n    92\t        self.sessions: dict[str, dict[str, Any]] = {}\n    93\t        self.last_activity = time.monotonic()\n    94\t        self.empty_since: float | None = None  # set when sessions hits 0\n    95\t        self.shutdown_event = threading.Event()\n    96\t        self.started_at = time.monotonic()\n    97\t\n    98\t    # ---------- session bookkeeping ------------------------------------\n    99\t\n   100\t    def session_start(self, agent_id: str) -> int:\n   101\t        with self.lock:\n   102\t            now_ms = int(time.time() * 1000)\n   103\t            if agent_id in self.sessions:\n   104\t                # Idempotent: re-emit returns the existing pk.\n   105\t                return self.sessions[agent_id][\"pk\"]\n   106\t            cur = self.conn.execute(\n   107\t                \"INSERT INTO cr_sessions(agent_id, started_at) VALUES (?, ?)\",\n   108\t                (agent_id, now_ms),\n   109\t            )\n   110\t            pk = int(cur.lastrowid or 0)\n   111\t            self.sessions[agent_id] = {\n   112\t                \"pk\": pk,\n   113\t                \"iter\": 0,\n   114\t                \"started_at\": now_ms,\n   115\t                # Anchor for the turn currently being recorded — the most\n   116\t                # recent user_prompt's context_id. NULL until the first\n   117\t                # prompt arrives. Tool calls between prompts inherit this\n   118\t                # so the ranker can apply per-turn decay.\n   119\t                \"last_prompt_context_id\": None,\n   120\t                # Cache of the most recent ranker output for this session\n   121\t                # so the `ken_rank` MCP tool can re-render at higher\n   122\t                # verbose without re-running the channels.\n   123\t                \"last_rank_result\": None,\n   124\t                \"last_rank_prompt\": \"\",\n   125\t            }\n   126\t            self.empty_since = None\n   127\t            self._touch()\n   128\t            return pk\n   129\t\n   130\t    def session_end(self, agent_id: str) -> None:\n   131\t        with self.lock:\n   132\t            now_ms = int(time.time() * 1000)\n   133\t            self.conn.execute(\n   134\t                \"UPDATE cr_sessions SET ended_at = ? WHERE agent_id = ? AND ended_at IS NULL\",\n   135\t                (now_ms, agent_id),\n   136\t            )\n   137\t            self.sessions.pop(agent_id, None)\n   138\t            if not self.sessions:\n   139\t                self.empty_since = time.monotonic()\n   140\t            self._touch()\n   141\t\n   142\t    def next_iteration(self, agent_id: str) -> tuple[int, int]:\n  1170\t\n  1171\t\n  1172\tdef _clear_runtime_files(project_root: Path) -> None:\n  1173\t    for p in (_paths.port_path(project_root), _paths.pid_path(project_root)):\n  1174\t        try:\n  1175\t            p.unlink()\n  1176\t        except OSError:\n  1177\t            pass\n  1178\t\n  1179\t\n  1180\tdef _read_project_id(project_root: Path) -> str:\n  1181\t    try:\n  1182\t        meta = json.loads(_paths.meta_path(project_root).read_text(encoding=\"utf-8\"))\n  1183\t        return str(meta.get(\"project_id\", \"?\"))\n  1184\t    except OSError:\n  1185\t        return \"?\"\n  1186\t\n  1187\t\n  1188\tdef _ken_version() -> str:\n  1189\t    from ken import __version__\n  1190\t\n  1191\t    return __version__\nsrc/ken/db.py:23:def connect(db_path: Path) -> sqlite3.Connection:\nsrc/ken/daemon/server.py:5:    GET  /health                            → { ok, project_id, sessions_active, idle_seconds }\nsrc/ken/daemon/server.py:19:Auth: every request must carry ``Authorization: Bearer <token>`` matching\nsrc/ken/daemon/server.py:324:    def do_GET(self) -> None:  # noqa: N802 - stdlib name\nsrc/ken/daemon/server.py:327:        if self.path == \"/health\":\nsrc/ken/daemon/server.py:393:        sent = self.headers.get(\"Authorization\", \"\")\nsrc/ken/daemon/server.py:1080:    # spawn wait; serving first keeps /health responsive and prevents a\n   110\t    \"\"\"\n   111\t    if embed_limit is not None and embed_limit < 0:\n   112\t        raise SystemExit(\"error: --embed-limit must be >= 0\")\n   113\t    root = project_path.resolve()\n   114\t    if not root.is_dir():\n   115\t        raise SystemExit(f\"error: not a directory: {root}\")\n   116\t\n   117\t    ken_dir = _paths.ken_dir(root)\n   118\t    ken_dir.mkdir(parents=True, exist_ok=True)\n   119\t\n   120\t    # Step 1: meta.json — generate a project id + auth token if missing.\n   121\t    meta_p = _paths.meta_path(root)\n   122\t    if meta_p.is_file():\n   123\t        meta = json.loads(meta_p.read_text(encoding=\"utf-8\"))\n   124\t        if verbose:\n   125\t            print(f\"[meta] reusing existing project_id={meta['project_id']}\")\n   126\t    else:\n   127\t        meta = {\n   128\t            \"project_id\": str(uuid.uuid4()),\n   129\t            \"auth_token\": secrets.token_urlsafe(32),\n   130\t            \"created_at_ms\": int(time.time() * 1000),\n   131\t            \"project_path\": str(root),\n   132\t        }\n   133\t        meta_p.write_text(json.dumps(meta, indent=2) + \"\\n\", encoding=\"utf-8\")\n   134\t        if verbose:\n   135\t            print(f\"[meta] created .ken/meta.json (project_id={meta['project_id']})\")\n   136\t\n   137\t    # Step 2: DB schema.\n   138\t    db_p = _paths.db_path(root)\n   139\t    fresh_db = not db_p.is_file()\n   140\t    conn = connect(db_p)\n   141\t    try:\n   142\t        init_schema(conn)\n   143\t        set_meta(conn, \"project_id\", meta[\"project_id\"])\n   144\t        set_meta(conn, \"ken_version\", _ken_version())\n   145\t        # Pin the project's embedding model (records the recommended default\n   146\t        # for a fresh DB; keeps an existing DB's model on re-install).\n   147\t        from ken.embedder import configure_for_project\n\"\"\"Shared test fixtures.\"\"\"\n\nfrom __future__ import annotations\n\nimport pytest\n\n\n@pytest.fixture(autouse=True)\ndef _isolate_ken_user_config(tmp_path, monkeypatch):\n    \"\"\"Point the user config at a fresh temp dir for every test.\n\n    Without this, a developer's real ``~/.config/ken/config.json`` (e.g. a\n    ``ken default-model`` override pointing at a torch-only model) would leak\n    into the suite and break tests that build the real embedder.\n    \"\"\"\n    monkeypatch.setenv(\"KEN_CONFIG_DIR\", str(tmp_path / \"ken-config\"))\n    # Same reasoning one layer down: ``recommended_model()`` prefers the static\n    # table when its artifact is present, so a developer who has one cached\n    # would silently run a different suite than CI does — and the difference\n    # would show up as unrelated assertions about the recommended model\n    # failing, which is a needlessly confusing way to learn about it. Tests that\n    # want the table set KEN_STATIC_HEAD themselves.\n    monkeypatch.setenv(\"KEN_CACHE_DIR\", str(tmp_path / \"ken-cache\"))\n    monkeypatch.delenv(\"KEN_STATIC_HEAD\", raising=False)\n/opt/homebrew/bin/python3\nTraceback (most recent call last):\n  File \"<string>\", line 1, in <module>\n    import pytest; print(pytest.__version__)\n    ^^^^^^^^^^^^^\nModuleNotFoundError: No module named 'pytest'\n","exit_code":1,"status":"failed"}}
