l.py\nA  tests/test_codeflow_tools.py\nA  tests/test_codex_hooks_template.py\nA  tests/test_daemon_helpers.py\nA  tests/test_daemon_http_resilience.py\nA  tests/test_daemon_rank_mcp.py\nA  tests/test_daemon_state.py\nA  tests/test_db.py\nA  tests/test_doc_intent_integration.py\nA  tests/test_embedder_device.py\nA  tests/test_embedder_model.py\nA  tests/test_embedding_spaces.py\nA  tests/test_findings_graph.py\nA  tests/test_gitignore_filter.py\nA  tests/test_hook.py\nA  tests/test_hooks_template.py\nA  tests/test_index_queue.py\nA  tests/test_indexer.py\nA  tests/test_install_codex.py\nA  tests/test_install_opencode.py\nA  tests/test_mcp_schema.py\nA  tests/test_mcp_startup.py\nA  tests/test_nametokens.py\nA  tests/test_paths.py\nA  tests/test_reembed.py\nA  tests/test_search_cli.py\nA  tests/test_session_brief.py\nA  tests/test_static_head.py\nA  tests/test_status.py\nA  tests/test_stochastic_tools.py\nA  tests/test_tools_cli.py\nA  tests/test_vectors.py\nA  tests/test_vectors_daemon.py\nA  tests/test_watcher.py\nA  uv.lock\nUse Ken to locate relevant code before reading, where available. Follow the installed schemas below (query, not task). Read actual source and verify conclusions; fall back to shell if necessary.\nken_find {\"properties\": {\"query\": {\"title\": \"Query\", \"type\": \"string\"}, \"scope\": {\"default\": \"files\", \"enum\": [\"files\", \"symbols\", \"text\", \"tests\", \"wiring\", \"intent\"], \"title\": \"Scope\", \"type\": \"string\"}, \"limit\": {\"default\": 10, \"title\": \"Limit\", \"type\": \"integer\"}, \"literal\": {\"default\": false, \"title\": \"Literal\", \"type\": \"boolean\"}, \"language\": {\"default\": \"\", \"title\": \"Language\", \"type\": \"string\"}}, \"required\": [\"query\"], \"type\": \"object\", \"title\": \"ken_findArguments\"}\nken_read {\"properties\": {\"path\": {\"title\": \"Path\", \"type\": \"string\"}, \"include\": {\"anyOf\": [{\"items\": {\"enum\": [\"symbols\", \"imports\", \"docstrings\", \"source\", \"profile\"], \"type\": \"string\"}, \"type\": \"array\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"Include\"}, \"qualname\": {\"default\": \"\", \"title\": \"Qualname\", \"type\": \"string\"}, \"start_line\": {\"default\": 0, \"title\": \"Start Line\", \"type\": \"integer\"}, \"end_line\": {\"default\": 0, \"title\": \"End Line\", \"type\": \"integer\"}, \"max_chars\": {\"default\": 0, \"title\": \"Max Chars\", \"type\": \"integer\"}}, \"required\": [\"path\"], \"type\": \"object\", \"title\": \"ken_readArguments\"}\nken_related {\"properties\": {\"target\": {\"title\": \"Target\", \"type\": \"string\"}, \"relation\": {\"enum\": [\"neighbors\", \"imports\", \"callers\", \"callees\", \"subtypes\", \"supertypes\", \"cochange\", \"blast_radius\", \"clones\"], \"title\": \"Relation\", \"type\": \"string\"}, \"limit\": {\"default\": 10, \"title\": \"Limit\", \"type\": \"integer\"}, \"depth\": {\"default\": 1, \"title\": \"Depth\", \"type\": \"integer\"}, \"min_confidence\": {\"default\": 0.0, \"title\": \"Min Confidence\", \"type\": \"number\"}}, \"required\": [\"target\", \"relation\"], \"type\": \"object\", \"title\": \"ken_relatedArguments\"}\nken_rank {\"properties\": {\"scope\": {\"default\": \"session\", \"enum\": [\"session\", \"changes\", \"project\", \"architecture\"], \"title\": \"Scope\", \"type\": \"string\"}, \"query\": {\"default\": \"\", \"title\": \"Query\", \"type\": \"string\"}, \"verbose\": {\"default\": 1, \"title\": \"Verbose\", \"type\": \"integer\"}, \"explain\": {\"default\": false, \"title\": \"Explain\", \"type\": \"boolean\"}, \"max_chars\": {\"default\": 0, \"title\": \"Max Chars\", \"type\": \"integer\"}}, \"type\": \"object\", \"title\": \"ken_rankArguments\"}\nken_recall {\"properties\": {\"query\": {\"default\": \"\", \"title\": \"Query\", \"type\": \"string\"}, \"path\": {\"default\": \"\", \"title\": \"Path\", \"type\": \"string\"}, \"topic\": {\"default\": \"\", \"title\": \"Topic\", \"type\": \"string\"}, \"tag\": {\"default\": \"\", \"title\": \"Tag\", \"type\": \"string\"}, \"limit\": {\"default\": 5, \"title\": \"Limit\", \"type\": \"integer\"}, \"min_score\": {\"default\": 0.0, \"title\": \"Min Score\", \"type\": \"number\"}, \"anchor_file\": {\"default\": \"\", \"title\": \"Anchor File\", \"type\": \"string\"}, \"anchor_symbol\": {\"default\": \"\", \"title\": \"Anchor Symbol\", \"type\": \"string\"}, \"anchor_tool\": {\"default\": \"\", \"title\": \"Anchor Tool\", \"type\": \"string\"}, \"anchor_error\": {\"default\": \"\", \"title\": \"Anchor Error\", \"type\": \"string\"}}, \"type\": \"object\", \"title\": \"ken_recallArguments\"}\nken_remember {\"properties\": {\"topic\": {\"title\": \"Topic\", \"type\": \"string\"}, \"content\": {\"default\": \"\", \"title\": \"Content\", \"type\": \"string\"}, \"action\": {\"default\": \"save\", \"enum\": [\"save\", \"forget\", \"dismiss\"], \"title\": \"Action\", \"type\": \"string\"}, \"tags\": {\"anyOf\": [{\"items\": {\"type\": \"string\"}, \"type\": \"array\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"Tags\"}, \"reason\": {\"default\": \"\", \"title\": \"Reason\", \"type\": \"string\"}, \"anchor_file\": {\"default\": \"\", \"title\": \"Anchor File\", \"type\": \"string\"}, \"anchor_symbol\": {\"default\": \"\", \"title\": \"Anchor Symbol\", \"type\": \"string\"}, \"anchor_tool\": {\"default\": \"\", \"title\": \"Anchor Tool\", \"type\": \"string\"}, \"anchor_error\": {\"default\": \"\", \"title\": \"Anchor Error\", \"type\": \"string\"}}, \"required\": [\"topic\"], \"type\": \"object\", \"title\": \"ken_rememberArguments\"}[project]\nname = \"ken-rank\"\n# Single-sourced from src/ken/__init__.py — see [tool.hatch.version]. Keeping a\n# literal here as well is what shipped 0.5.0 and 0.7.0 with `ken --version`\n# reporting the *previous* release: two places to bump, one of them easy to miss.\ndynamic = [\"version\"]\ndescription = \"Per-project context-rank index for Claude Code, served from a local daemon.\"\nreadme = \"README.md\"\nrequires-python = \">=3.11\"\nlicense = { text = \"MIT\" }\nauthors = [{ name = \"Andres\" }]\ndependencies = [\n    \"tree-sitter>=0.25.2\",\n    \"tree-sitter-python>=0.23\",\n    \"tree-sitter-rust>=0.23\",\n    \"tree-sitter-javascript>=0.23\",\n    \"tree-sitter-typescript>=0.23\",\n    \"tree-sitter-go>=0.23\",\n    \"tree-sitter-java>=0.23\",\n    # Dart has no standalone tree-sitter wheel on PyPI; the language-pack\n    # bundles the grammar (and pins tree-sitter>=0.25.2, hence the bump above).\n    \"tree-sitter-language-pack>=1.8\",\n    \"pathspec>=0.12\",\n    \"watchfiles>=0.22\",\n    # fastembed brings ONNX Runtime + a managed all-MiniLM-L6-v2 download\n    # (~25 MB cached in ~/.cache/fastembed on first use). 384-dim, fast on\n    # CPU; same model infinidev runs in production.\n    \"fastembed>=0.5\",\n    \"numpy>=1.26\",\n    # MCP SDK — exposes ken's tools to Claude Code over stdio.\n    # Pinned to the 2.x line: 2.0 renamed ``FastMCP`` to ``MCPServer``\n    # and moved it to ``mcp.server``; 0.10.0 of ken-rank shipped with the\n    # older ``mcp>=1.0`` pin by accident, so older installs may have\n    # resolved mcp 1.x — and then the MCP server silently failed at\n    # import. ``<3`` keeps 3.x out until we verify it (the 3.x line is\n    # not yet on PyPI as of writing).\n    \"mcp>=2.0,<3\",\n]\n\n[project.optional-dependencies]\n# GPU embedding for the default (fastembed) backend. `pip install\n# ken-rank[gpu]` swaps in fastembed's GPU build (it pulls onnxruntime-gpu).\n# The embedder then auto-detects a CUDA/ROCm provider and uses it, falling\n# back to CPU when none is usable — so this extra is purely opt-in\n# acceleration and never a hard requirement. The pulled onnxruntime-gpu\n# targets a specific CUDA major; if it does not match the host's CUDA\n# runtime, ken logs a warning and stays on CPU rather than failing. Pin\n# onnxruntime-gpu yourself if you need a specific CUDA line.\n#\n# Not installable on macOS: onnxruntime-gpu publishes Linux and Windows wheels\n# only, so without the marker `pip install 'ken-rank[gpu]'` fails outright on a\n# Mac. There is nothing to offer instead — ONNX Runtime has no MPS provider, so\n# the fastembed backend stays on the CPU there (where its small models are\n# already fast). Apple Silicon GPU acceleration lives in the `torch` extra.\ngpu = [\"fastembed-gpu>=0.5; sys_platform != 'darwin'\"]\n\n# The torch backend: `pip install ken-rank[torch]` adds sentence-transformers\n# (which pulls torch) so ken can run stronger models fastembed does not ship —\n# e.g. Qwen/Qwen3-Embedding-0.6B (top of ken's retrieval benchmark) or\n# BAAI/bge-m3. Heavier install; entirely opt-in. Switch a project onto one\n# with `ken reembed --model <name>` after installing this extra. Also\n# GPU-aware: CUDA, or Apple Silicon's MPS, whichever torch sees.\n#\n# The two version floors are not cosmetic. sentence-transformers only requires\n# transformers>=4.34, but the Qwen3 architecture landed in 4.51 — below it the\n# model dies with `KeyError: 'qwen3'`, naming neither the cause nor the fix. And\n# torch below 2.9 could return silently wrong embeddings on MPS (pytorch#163597,\n# fixed in 2.9.0), so Apple Silicon gets a floor that costs Linux users nothing;\n# it is scoped to arm64 because PyPI has no torch 2.9 for Intel Macs, where MPS\n# does not exist anyway.\ntorch = [\n    \"sentence-transformers>=3.0\",\n    \"transformers>=4.51\",\n    \"torch>=2.9; sys_platform == 'darwin' and platform_machine == 'arm64'\",\n]\n\n[project.scripts]\nken = \"ken.cli:main\"\n\n[dependency-groups]\ndev = [\n    \"mypy>=1.15\",\n    \"pytest>=8.0\",\n]\n\n[build-system]\nrequires = [\"hatchling\"]\nbuild-backend = \"hatchling.build\"\n\n# The one place the version lives. hatchling reads __version__ out of this file\n# at build time, so the package metadata and what `ken --version` prints cannot\n# disagree — they are the same string.\n[tool.hatch.version]\npath = \"src/ken/__init__.py\"\n\n[tool.hatch.build.targets.wheel]\npackages = [\"src/ken\"]\n\n[tool.hatch.build.targets.sdist]\ninclude = [\"src/ken\", \"README.md\", \"LICENSE\", \"pyproject.toml\"]\n\n[tool.pytest.ini_options]\ntestpaths = [\"tests\"]\naddopts = \"-q\"\n\n[tool.mypy]\npython_version = \"3.12\"\nfiles = [\"src/ken\"]\nshow_error_codes = true\nwarn_unused_configs = true\n\n# Incremental typing gate: these existing modules have known annotation debt.\n# They remain part of mypy's import graph, while every other module — and every\n# new module — must stay clean. Remove entries as their annotations are fixed.\n[[tool.mypy.overrides]]\nmodule = [\n    \"ken.cli\",\n    \"ken.embedder.onnx_fastembed\",\n    \"ken.embedder.st_backend\",\n    \"ken.embedder.static_head\",\n    \"ken.findings_graph\",\n    \"ken.graphtools\",\n    \"ken.indexer\",\n    \"ken.mcp.server\",\n    \"ken.parsers.cpp\",\n    \"ken.parsers.dart\",\n    \"ken.parsers.php\",\n    \"ken.parsers.sql\",\n    \"ken.ranker.output\",\n    \"ken.reembed\",\n    \"ken.status\",\n    \"ken.structure\",\n    \"ken.vectors\",\n]\nignore_errors = true\n","exit_code":0,"status":"completed"}}
