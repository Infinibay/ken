{"type":"item.completed","item":{"id":"item_7","type":"mcp_tool_call","server":"ken","tool":"ken_find","arguments":{"query":"find_project_root","scope":"text","literal":true,"limit":25},"result":{"content":[{"type":"text","text":"{\n  \"ok\": true,\n  \"mode\": \"literal\",\n  \"query\": \"find_project_root\",\n  \"results\": [\n    {\n      \"path\": \"tests/test_paths.py\",\n      \"count\": 7,\n      \"snippets\": [\n        {\n          \"line\": 13,\n          \"text\": \"def test_find_project_root_walks_up(tmp_path):\"\n        },\n        {\n          \"line\": 19,\n          \"text\": \"found = _paths.find_project_root(start=nested)\"\n        },\n        {\n          \"line\": 24,\n          \"text\": \"def test_find_project_root_returns_none_when_missing(tmp_path):\"\n        },\n        {\n          \"line\": 30,\n          \"text\": \"result = _paths.find_project_root(start=tmp_path)\"\n        },\n        {\n          \"line\": 41,\n          \"text\": \"def test_find_project_root_respects_env_var(tmp_path, monkeypatch):\"\n        }\n      ]\n    },\n    {\n      \"path\": \"src/ken/cli.py\",\n      \"count\": 3,\n      \"snippets\": [\n        {\n          \"line\": 802,\n          \"text\": \"root = _paths.find_project_root(project_path.resolve()) or project_path.resolve()\"\n        },\n        {\n          \"line\": 1695,\n          \"text\": \"root = _paths.find_project_root(project_path.resolve()) or project_path.resolve()\"\n        },\n        {\n          \"line\": 1813,\n          \"text\": \"root = _paths.find_project_root(project_path.resolve()) or project_path.resolve()\"\n        }\n      ]\n    },\n    {\n      \"path\": \"src/ken/_paths.py\",\n      \"count\": 2,\n      \"snippets\": [\n        {\n          \"line\": 8,\n          \"text\": \"`find_project_root()` first thing so they know which DB to write to.\"\n        },\n        {\n          \"line\": 69,\n          \"text\": \"def find_project_root(start: Path | None = None) -> Path | None:\"\n        }\n      ]\n    },\n    {\n      \"path\": \"src/ken/embedder/__init__.py\",\n      \"count\": 2,\n      \"snippets\": [\n        {\n          \"line\": 399,\n          \"text\": \"from ken._paths import db_path, find_project_root\"\n        },\n        {\n          \"line\": 401,\n          \"text\": \"root = find_project_root()\"\n        }\n      ]\n    },\n    {\n      \"path\": \"src/ken/hook.py\",\n      \"count\": 1,\n      \"snippets\": [\n        {\n          \"line\": 34,\n          \"text\": \"root = _paths.find_project_root()\"\n        }\n      ]\n    },\n    {\n      \"path\": \"src/ken/hooks_template.py\",\n      \"count\": 1,\n      \"snippets\": [\n        {\n          \"line\": 10,\n          \"text\": \"etc.) — `ken` resolves the project via `find_project_root()`, so the\"\n        }\n      ]\n    },\n    {\n      \"path\": \"src/ken/mcp/server.py\",\n      \"count\": 1,\n      \"snippets\": [\n        {\n          \"line\": 94,\n          \"text\": \"root = _paths.find_project_root(start.resolve()) or start.resolve()\"\n        }\n      ]\n    },\n    {\n      \"path\": \"src/ken/serve.py\",\n      \"count\": 1,\n      \"snippets\": [\n        {\n          \"line\": 14,\n          \"text\": \"root = _paths.find_project_root(start.resolve()) or start.resolve()\"\n        }\n      ]\n    },\n    {\n      \"path\": \"src/ken/status.py\",\n      \"count\": 1,\n      \"snippets\": [\n        {\n          \"line\": 51,\n          \"text\": \"root = _paths.find_project_root(start.resolve())\"\n        }\n      ]\n    }\n  ]\n}"}],"structured_content":null},"error":null,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/ken/_paths.py; nl -ba src/ken/daemon/client.py; nl -ba src/ken/serve.py; nl -ba src/ken/hook.py | head -110; nl -ba src/ken/mcp/server.py | head -190; nl -ba src/ken/status.py | head -110'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/ken/_paths.py; nl -ba src/ken/daemon/client.py; nl -ba src/ken/serve.py; nl -ba src/ken/hook.py | head -110; nl -ba src/ken/mcp/server.py | head -190; nl -ba src/ken/status.py | head -110'","aggregated_output":"     1\t\"\"\"Project-root discovery + canonical paths inside `.ken/`.\n     2\t\n     3\tA \"ken project\" is any directory that contains a `.ken/meta.json`. We\n     4\tfollow git's pattern: walk up from the caller's cwd until we find one,\n     5\totherwise return None.\n     6\t\n     7\tThe hook commands (`ken hook session-start`, etc.) call\n     8\t`find_project_root()` first thing so they know which DB to write to.\n     9\tThe CLI's `install` / `serve` / `status` accept an explicit path\n    10\targument that takes precedence.\n    11\t\"\"\"\n    12\t\n    13\tfrom __future__ import annotations\n    14\t\n    15\timport os\n    16\tfrom pathlib import Path\n    17\t\n    18\tKEN_DIR_NAME = \".ken\"\n    19\tMETA_FILENAME = \"meta.json\"\n    20\tDB_FILENAME = \"ken.db\"\n    21\tPID_FILENAME = \"daemon.pid\"\n    22\tSOCKET_FILENAME = \"daemon.sock\"\n    23\tPORT_FILENAME = \"daemon.port\"\n    24\tLOG_FILENAME = \"daemon.log\"\n    25\t\n    26\t\n    27\tdef ken_dir(project_root: Path) -> Path:\n    28\t    return project_root / KEN_DIR_NAME\n    29\t\n    30\t\n    31\tdef meta_path(project_root: Path) -> Path:\n    32\t    return ken_dir(project_root) / META_FILENAME\n    33\t\n    34\t\n    35\tdef db_path(project_root: Path) -> Path:\n    36\t    return ken_dir(project_root) / DB_FILENAME\n    37\t\n    38\t\n    39\tdef pid_path(project_root: Path) -> Path:\n    40\t    return ken_dir(project_root) / PID_FILENAME\n    41\t\n    42\t\n    43\tdef port_path(project_root: Path) -> Path:\n    44\t    return ken_dir(project_root) / PORT_FILENAME\n    45\t\n    46\t\n    47\tdef log_path(project_root: Path) -> Path:\n    48\t    return ken_dir(project_root) / LOG_FILENAME\n    49\t\n    50\t\n    51\tdef resolve_project_path(project_root: Path, path: str | Path) -> Path:\n    52\t    \"\"\"Resolve *path* and require it to remain inside *project_root*.\n    53\t\n    54\t    Relative paths are interpreted from the project root. Absolute paths are\n    55\t    accepted when they point inside it. Resolving both sides before the\n    56\t    containment check also rejects ``..`` traversal and escapes through\n    57\t    existing symbolic links.\n    58\t    \"\"\"\n    59\t    root = project_root.expanduser().resolve()\n    60\t    supplied = Path(path).expanduser()\n    61\t    resolved = (supplied if supplied.is_absolute() else root / supplied).resolve()\n    62\t    try:\n    63\t        resolved.relative_to(root)\n    64\t    except ValueError as err:\n    65\t        raise ValueError(f\"path escapes project root: {path}\") from err\n    66\t    return resolved\n    67\t\n    68\t\n    69\tdef find_project_root(start: Path | None = None) -> Path | None:\n    70\t    \"\"\"Walk up from *start* (default cwd) looking for `.ken/meta.json`.\n    71\t\n    72\t    Returns the directory that contains `.ken/`, not the `.ken/` itself.\n    73\t    `KEN_PROJECT_ROOT` env var overrides discovery — useful for tests\n    74\t    and for hooks invoked with a wonky cwd.\n    75\t    \"\"\"\n    76\t    forced = os.environ.get(\"KEN_PROJECT_ROOT\")\n    77\t    if forced:\n    78\t        p = Path(forced).expanduser().resolve()\n    79\t        return p if meta_path(p).is_file() else None\n    80\t\n    81\t    cur = (start or Path.cwd()).resolve()\n    82\t    for parent in [cur, *cur.parents]:\n    83\t        if meta_path(parent).is_file():\n    84\t            return parent\n    85\t    return None\n     1\t\"\"\"Client used by hook commands to talk to the daemon.\n     2\t\n     3\tA hook lifecycle is:\n     4\t\n     5\t    1. Find project root via walk-up.\n     6\t    2. Look for `.ken/daemon.port`.\n     7\t       - exists + responsive  → use it.\n     8\t       - exists but stale     → spawn a fresh daemon.\n     9\t       - missing              → spawn one.\n    10\t    3. POST event, return the response (or None on failure — hooks must\n    11\t       *never* fail Claude Code; logging-and-shrugging is the contract).\n    12\t\n    13\tSpawning is detached: the daemon outlives the hook process via\n    14\t``start_new_session=True`` and stdio redirected to a log file. The hook\n    15\tthen polls `.ken/daemon.port` for up to 5 seconds.\n    16\t\"\"\"\n    17\t\n    18\tfrom __future__ import annotations\n    19\t\n    20\timport json\n    21\timport logging\n    22\timport os\n    23\timport subprocess\n    24\timport sys\n    25\timport time\n    26\timport urllib.error\n    27\timport urllib.request\n    28\tfrom pathlib import Path\n    29\tfrom typing import Any\n    30\t\n    31\tfrom ken import _paths\n    32\t\n    33\t# How long a hook will wait for a freshly-spawned daemon before giving up.\n    34\tSPAWN_POLL_TIMEOUT_S = 5.0\n    35\tSPAWN_POLL_INTERVAL_S = 0.05\n    36\t\n    37\t# Hook → daemon timeouts. Reads/health small; cheap POSTs slightly bigger\n    38\t# to tolerate a brief lock-contention spike when many hooks fire at once.\n    39\t# Ranking endpoints can legitimately take longer on huge repos, especially\n    40\t# the first time the process loads the embedding model.\n    41\tHEALTH_TIMEOUT_S = 1.0\n    42\tPOST_TIMEOUT_S = 3.0\n    43\tRANK_POST_TIMEOUT_S = 60.0\n    44\tRANKING_PATHS = {\"/prompts\", \"/rank\", \"/explain\"}\n    45\t\n    46\tlogger = logging.getLogger(\"ken.client\")\n    47\t\n    48\t\n    49\tclass DaemonUnreachable(RuntimeError):\n    50\t    \"\"\"Raised when even after a spawn the daemon doesn't come up.\"\"\"\n    51\t\n    52\t\n    53\tdef post(project_root: Path, path: str, payload: dict[str, Any]) -> dict[str, Any] | None:\n    54\t    \"\"\"POST *payload* as JSON to *path* on the daemon. Spawns one if needed.\n    55\t\n    56\t    Returns the parsed JSON response, or ``None`` if every attempt failed\n    57\t    (so callers can fall back to silent degradation).\n    58\t    \"\"\"\n    59\t    try:\n    60\t        return _post_with_spawn(project_root, path, payload)\n    61\t    except DaemonUnreachable as exc:\n    62\t        logger.warning(\"daemon unreachable for %s: %s\", path, exc)\n    63\t        return None\n    64\t    except Exception:  # pragma: no cover\n    65\t        logger.exception(\"daemon POST %s failed\", path)\n    66\t        return None\n    67\t\n    68\t\n    69\tdef health(project_root: Path) -> dict[str, Any] | None:\n    70\t    \"\"\"GET /health. Returns parsed JSON or None — never raises.\"\"\"\n    71\t    port = _read_port(project_root)\n    72\t    if port is None:\n    73\t        return None\n    74\t    try:\n    75\t        return _request(\"GET\", project_root, port, \"/health\", body=None, timeout=HEALTH_TIMEOUT_S)\n    76\t    except (OSError, urllib.error.URLError, json.JSONDecodeError):\n    77\t        return None\n    78\t\n    79\t\n    80\t# ---------- internals ----------\n    81\t\n    82\t\n    83\tdef _post_with_spawn(project_root: Path, path: str, payload: dict[str, Any]) -> dict[str, Any] | None:\n    84\t    timeout = _post_timeout(path)\n    85\t    port = _read_port(project_root)\n    86\t    if port is not None:\n    87\t        try:\n    88\t            return _request(\"POST\", project_root, port, path, body=payload, timeout=timeout)\n    89\t        except TimeoutError:\n    90\t            # The daemon accepted the request but did not respond before\n    91\t            # the hook budget. Do not clear the port or spawn another\n    92\t            # daemon: the in-flight request may still complete.\n    93\t            logger.warning(\"daemon POST %s timed out after %.1fs\", path, timeout)\n    94\t            return None\n    95\t        except (urllib.error.URLError, ConnectionRefusedError, OSError):\n    96\t            # Stale port file (daemon crashed without cleanup).  Spawn a\n    97\t            # fresh one and retry once.\n    98\t            logger.info(\"port %s unresponsive; respawning daemon\", port)\n    99\t            _clear_port_file(project_root)\n   100\t\n   101\t    spawned_port = _spawn_and_wait(project_root)\n   102\t    return _request(\"POST\", project_root, spawned_port, path, body=payload, timeout=timeout)\n   103\t\n   104\t\n   105\tdef _post_timeout(path: str) -> float:\n   106\t    return RANK_POST_TIMEOUT_S if path in RANKING_PATHS else POST_TIMEOUT_S\n   107\t\n   108\t\n   109\tdef _spawn_and_wait(project_root: Path) -> int:\n   110\t    \"\"\"Detach a daemon process and wait for `.ken/daemon.port` to appear.\"\"\"\n   111\t    log_p = _paths.log_path(project_root)\n   112\t    log_p.parent.mkdir(parents=True, exist_ok=True)\n   113\t    log_handle = log_p.open(\"ab\")\n   114\t    # We use sys.executable to avoid a PATH lookup race when running\n   115\t    # under uv tool / pipx; a console script wrapper would also work but\n   116\t    # this is the most portable. ``-m ken`` invokes the package's\n   117\t    # __main__ → cli.main.\n   118\t    cmd = [sys.executable, \"-m\", \"ken\", \"serve\", str(project_root), \"--background\"]\n   119\t    subprocess.Popen(  # noqa: S603 — args are literal/local-controlled\n   120\t        cmd,\n   121\t        stdin=subprocess.DEVNULL,\n   122\t        stdout=log_handle,\n   123\t        stderr=subprocess.STDOUT,\n   124\t        start_new_session=True,\n   125\t        cwd=str(project_root),\n   126\t        env={**os.environ, \"KEN_PROJECT_ROOT\": str(project_root)},\n   127\t    )\n   128\t    # Don't keep the parent's handle open — daemon dup'd it.\n   129\t    log_handle.close()\n   130\t\n   131\t    deadline = time.monotonic() + SPAWN_POLL_TIMEOUT_S\n   132\t    while time.monotonic() < deadline:\n   133\t        port = _read_port(project_root)\n   134\t        if port is not None:\n   135\t            # Port file written; one more health check before declaring win.\n   136\t            try:\n   137\t                if _request(\"GET\", project_root, port, \"/health\", body=None, timeout=HEALTH_TIMEOUT_S):\n   138\t                    return port\n   139\t            except Exception:  # pragma: no cover\n   140\t                pass\n   141\t        time.sleep(SPAWN_POLL_INTERVAL_S)\n   142\t    raise DaemonUnreachable(f\"daemon did not come up within {SPAWN_POLL_TIMEOUT_S}s\")\n   143\t\n   144\t\n   145\tdef _read_port(project_root: Path) -> int | None:\n   146\t    p = _paths.port_path(project_root)\n   147\t    if not p.is_file():\n   148\t        return None\n   149\t    try:\n   150\t        return int(p.read_text(encoding=\"utf-8\").strip())\n   151\t    except (OSError, ValueError):\n   152\t        return None\n   153\t\n   154\t\n   155\tdef _clear_port_file(project_root: Path) -> None:\n   156\t    try:\n   157\t        _paths.port_path(project_root).unlink()\n   158\t    except OSError:\n   159\t        pass\n   160\t\n   161\t\n   162\tdef _read_token(project_root: Path) -> str:\n   163\t    meta = json.loads(_paths.meta_path(project_root).read_text(encoding=\"utf-8\"))\n   164\t    return str(meta[\"auth_token\"])\n   165\t\n   166\t\n   167\tdef _request(\n   168\t    method: str,\n   169\t    project_root: Path,\n   170\t    port: int,\n   171\t    path: str,\n   172\t    *,\n   173\t    body: dict[str, Any] | None,\n   174\t    timeout: float,\n   175\t) -> dict[str, Any]:\n   176\t    url = f\"http://127.0.0.1:{port}{path}\"\n   177\t    data = None\n   178\t    headers = {\"Authorization\": f\"Bearer {_read_token(project_root)}\"}\n   179\t    if body is not None:\n   180\t        data = json.dumps(body).encode(\"utf-8\")\n   181\t        headers[\"Content-Type\"] = \"application/json\"\n   182\t    req = urllib.request.Request(url, data=data, method=method, headers=headers)\n   183\t    with urllib.request.urlopen(req, timeout=timeout) as resp:  # noqa: S310 — localhost-only\n   184\t        raw = resp.read().decode(\"utf-8\")\n   185\t    return json.loads(raw) if raw else {}\n     1\t\"\"\"`ken serve` entrypoint.\"\"\"\n     2\t\n     3\tfrom __future__ import annotations\n     4\t\n     5\timport logging\n     6\timport sys\n     7\tfrom pathlib import Path\n     8\t\n     9\tfrom ken import _paths\n    10\tfrom ken.daemon.server import run as run_server\n    11\t\n    12\t\n    13\tdef serve(start: Path, *, background: bool = False) -> int:\n    14\t    root = _paths.find_project_root(start.resolve()) or start.resolve()\n    15\t    if not _paths.meta_path(root).is_file():\n    16\t        print(f\"no ken project at {root} — run `ken install .` first\", file=sys.stderr)\n    17\t        return 1\n    18\t\n    19\t    if background:\n    20\t        # When spawned by a hook we want a friendly file log; otherwise\n    21\t        # foreground mode logs to stderr so `ken serve` in a terminal is\n    22\t        # interactive-debuggable.\n    23\t        logging.basicConfig(\n    24\t            filename=str(_paths.log_path(root)),\n    25\t            level=logging.INFO,\n    26\t            format=\"%(asctime)s %(levelname)s %(name)s %(message)s\",\n    27\t        )\n    28\t    else:\n    29\t        logging.basicConfig(\n    30\t            level=logging.INFO,\n    31\t            format=\"%(asctime)s %(levelname)s %(name)s %(message)s\",\n    32\t        )\n    33\t\n    34\t    return run_server(root)\n     1\t\"\"\"Short-lived hook shims invoked by supported coding agents.\n     2\t\n     3\tEach `ken hook ...` subcommand reads the agent's JSON event payload from\n     4\tstdin, finds the installed project via walk-up, and POSTs an event to\n     5\tthe per-project daemon, spawning it if needed.\n     6\t\n     7\tHooks **never** raise to the caller:\n     8\t  * If we can't find a project, we print to stderr and exit 0 — the\n     9\t    user just isn't in a ken-installed project.\n    10\t  * If the daemon can't be reached after a spawn attempt, we log\n    11\t    silently and exit 0 — keeping ken from blocking the agent is more\n    12\t    important than capturing every event.\n    13\t\n    14\tStdout is reserved for hook-driven context injection. On\n    15\t`UserPromptSubmit`, the daemon may return a `<context-rank>` block and\n    16\tthe hook prints only that block so the host CLI can prepend it to the\n    17\tmodel-visible prompt.\n    18\t\"\"\"\n    19\t\n    20\tfrom __future__ import annotations\n    21\t\n    22\timport argparse\n    23\timport json\n    24\timport sys\n    25\tfrom pathlib import Path\n    26\tfrom typing import Any\n    27\t\n    28\tfrom ken import _paths\n    29\tfrom ken.cli import _read_hook_payload\n    30\tfrom ken.daemon import client\n    31\t\n    32\t\n    33\tdef dispatch_hook(args: argparse.Namespace) -> int:\n    34\t    root = _paths.find_project_root()\n    35\t    if root is None:\n    36\t        print(\"ken: no .ken project at or above cwd, skipping hook\", file=sys.stderr)\n    37\t        return 0\n    38\t\n    39\t    payload = _read_hook_payload()\n    40\t    session_id = _session_id(payload)\n    41\t    if not session_id:\n    42\t        print(\"ken: hook payload missing session_id; skipping\", file=sys.stderr)\n    43\t        return 0\n    44\t\n    45\t    try:\n    46\t        if args.hook_cmd == \"session-start\":\n    47\t            resp = client.post(\n    48\t                root, \"/sessions/start\", {\"session_id\": session_id, \"cwd\": payload.get(\"cwd\")}\n    49\t            )\n    50\t            # The daemon returns a resume brief (\"where you left off\").\n    51\t            # Print it to stdout so the host CLI injects it as the new\n    52\t            # session's context — no recall call from the model required.\n    53\t            block = (resp or {}).get(\"context_block\") or \"\"\n    54\t            if block.strip():\n    55\t                sys.stdout.write(block)\n    56\t        elif args.hook_cmd == \"session-end\":\n    57\t            client.post(root, \"/sessions/end\", {\"session_id\": session_id})\n    58\t        elif args.hook_cmd == \"user-prompt\":\n    59\t            resp = client.post(\n    60\t                root,\n    61\t                \"/prompts\",\n    62\t                {\"session_id\": session_id, \"prompt\": payload.get(\"prompt\", \"\")},\n    63\t            )\n    64\t            # The daemon may want to inject context — print it to stdout so\n    65\t            # the host CLI prepends it to the model's view of the prompt.\n    66\t            block = (resp or {}).get(\"context_block\") or \"\"\n    67\t            if block.strip():\n    68\t                sys.stdout.write(block)\n    69\t        elif args.hook_cmd == \"tool-call\":\n    70\t            phase_path = \"/tools/pre\" if args.phase == \"pre\" else \"/tools/post\"\n    71\t            client.post(root, phase_path, _tool_call_body(session_id, args.phase, payload))\n    72\t        elif args.hook_cmd == \"stop\":\n    73\t            # Codex passes ``last_assistant_message`` directly in the\n    74\t            # payload; Claude Code passes a ``transcript_path`` we tail-\n    75\t            # read. Prefer the direct field when present.\n    76\t            direct = payload.get(\"last_assistant_message\")\n    77\t            if isinstance(direct, str) and direct:\n    78\t                assistant_text = direct\n    79\t            else:\n    80\t                assistant_text = _extract_last_assistant_text(payload.get(\"transcript_path\"))\n    81\t            client.post(\n    82\t                root,\n    83\t                \"/turn-end\",\n    84\t                {\"session_id\": session_id, \"assistant_text\": assistant_text},\n    85\t            )\n    86\t        else:\n    87\t            print(f\"ken: unknown hook subcommand: {args.hook_cmd}\", file=sys.stderr)\n    88\t            return 0\n    89\t    except Exception as exc:  # pragma: no cover - belt + suspenders\n    90\t        print(f\"ken: hook error ({args.hook_cmd}): {exc}\", file=sys.stderr)\n    91\t    return 0\n    92\t\n    93\t\n    94\tdef _session_id(payload: dict[str, Any]) -> str | None:\n    95\t    sid = payload.get(\"session_id\")\n    96\t    if isinstance(sid, str) and sid:\n    97\t        return sid\n    98\t    return None\n    99\t\n   100\t\n   101\tdef _tool_call_body(session_id: str, phase: str, payload: dict[str, Any]) -> dict[str, Any]:\n   102\t    \"\"\"Project a hook tool payload into the daemon's tool-call API.\n   103\t\n   104\t    Claude Code and Codex use slightly different field names, so this\n   105\t    helper accepts both the explicit hook shape (`tool_name`,\n   106\t    `tool_input`, `tool_response`) and ken's already-normalized shape\n   107\t    (`tool`, `input`, `output`).\n   108\t    \"\"\"\n   109\t    body: dict[str, Any] = {\n   110\t        \"session_id\": session_id,\n     1\t\"\"\"stdio MCP server — entrypoint for ``ken mcp``.\n     2\t\n     3\tBuilt on the official ``mcp`` Python SDK v2. The old ``FastMCP`` class\n     4\twas renamed to ``MCPServer``; the decorator API (``@mcp.tool()``) is the\n     5\tsame shape it always was, so every tool below is a plain function with\n     6\ttype annotations and a docstring — same surface ken has exposed since\n     7\t0.x. The CLI passthrough (``ken tools ...``) reads from a parallel\n     8\tregistry populated alongside the SDK registration, so it does not need\n     9\tto spin up the stdio server to list tools.\n    10\t\"\"\"\n    11\t\n    12\tfrom __future__ import annotations\n    13\t\n    14\timport inspect\n    15\timport logging\n    16\timport sqlite3\n    17\timport sys\n    18\timport types\n    19\timport typing\n    20\tfrom dataclasses import dataclass\n    21\tfrom pathlib import Path\n    22\tfrom typing import Any, Callable, Literal\n    23\t\n    24\ttry:\n    25\t    from mcp.server import MCPServer\n    26\texcept ImportError as _exc:\n    27\t    from importlib.metadata import PackageNotFoundError, version as _pkg_version\n    28\t\n    29\t    try:\n    30\t        _installed = _pkg_version(\"mcp\")\n    31\t    except PackageNotFoundError:\n    32\t        _installed = \"not installed\"\n    33\t\n    34\t    sys.stderr.write(\n    35\t        \"ken mcp: this build of ken needs the `mcp` Python SDK >= 2.0, but the\\n\"\n    36\t        f\"environment only has `{_installed}` installed (reason: {_exc}).\\n\"\n    37\t        \"The MCP server cannot start with that version — `mcp.server.MCPServer`\\n\"\n    38\t        \"only exists in mcp 2.x; mcp 1.x still ships the older `FastMCP` API.\\n\"\n    39\t        \"\\n\"\n    40\t        \"This typically happens when an older ken-rank (0.10.0 or earlier,\\n\"\n    41\t        \"with the wrong `mcp>=1.0` pin in 0.10.0) was installed before the\\n\"\n    42\t        \"fix landed. Fix it with:\\n\"\n    43\t        \"\\n\"\n    44\t        \"    uv tool install --reinstall ken-rank\\n\"\n    45\t        \"    # or, for pipx:\\n\"\n    46\t        \"    pipx reinstall ken-rank\\n\"\n    47\t        \"    # or, for plain pip:\\n\"\n    48\t        \"    pip install --upgrade --force-reinstall ken-rank\\n\"\n    49\t        \"\\n\"\n    50\t        \"Then restart the assistant that hosts the MCP server (Claude Code,\\n\"\n    51\t        \"Codex, OpenCode, …) so it respawns the `ken mcp` process.\\n\"\n    52\t    )\n    53\t    sys.stderr.flush()\n    54\t    raise SystemExit(1) from _exc\n    55\t\n    56\tfrom ken import _paths\n    57\tfrom ken.clones import clones\n    58\tfrom ken.cochange import cochange\n    59\tfrom ken.codeflow import callgraph, type_hierarchy, wiring\n    60\tfrom ken.db import connect\n    61\tfrom ken.graphtools import architecture, blast_radius\n    62\tfrom ken.grep import grep\n    63\tfrom ken.intent import intent_history\n    64\tfrom ken.memory import forget, list_findings, recall, remember\n    65\tfrom ken.profile import profile\n    66\tfrom ken.search import (\n    67\t    changed_context,\n    68\t    file_neighbors,\n    69\t    file_outline,\n    70\t    file_snippets,\n    71\t    file_symbols,\n    72\t    find_tests,\n    73\t    module_graph,\n    74\t    project_overview,\n    75\t    search_files,\n    76\t    search_symbols,\n    77\t    symbol_detail,\n    78\t)\n    79\t\n    80\tlogger = logging.getLogger(\"ken.mcp\")\n    81\t\n    82\t# Each `ken mcp` is a *single project* server — coding agents launch\n    83\t# one instance per workspace. The project root is resolved once at\n    84\t# startup; if it's not a ken project we fail fast so the user sees\n    85\t# a clear error in their MCP logs.\n    86\t_PROJECT_ROOT: Path | None = None\n    87\t\n    88\tmcp = MCPServer(\"ken\")\n    89\t\n    90\t\n    91\tdef run(start: Path) -> int:\n    92\t    \"\"\"Resolve the project root, then hand control to the MCP stdio loop.\"\"\"\n    93\t    global _PROJECT_ROOT\n    94\t    root = _paths.find_project_root(start.resolve()) or start.resolve()\n    95\t    if not _paths.meta_path(root).is_file():\n    96\t        print(f\"ken mcp: no .ken project at {root}\", file=sys.stderr)\n    97\t        return 1\n    98\t    _PROJECT_ROOT = root\n    99\t    logging.basicConfig(\n   100\t        stream=sys.stderr,\n   101\t        level=logging.INFO,\n   102\t        format=\"%(asctime)s %(levelname)s %(name)s %(message)s\",\n   103\t    )\n   104\t    logger.info(\"ken mcp ready project_root=%s\", root)\n   105\t    mcp.run(transport=\"stdio\")\n   106\t    return 0\n   107\t\n   108\t\n   109\t# ---- CLI tool registry --------------------------------------------------\n   110\t#\n   111\t# ``ken tools ...`` (the shell-side passthrough) reads tool names,\n   112\t# descriptions, and parameter schemas from this registry so it does not\n   113\t# need to spin up the MCP stdio loop just to print ``--help`` text. We\n   114\t# mirror each ``@mcp.tool()`` registration into ``_REGISTRY`` via the\n   115\t# ``_register`` helper below.\n   116\t\n   117\t\n   118\t@dataclass\n   119\tclass ToolDef:\n   120\t    \"\"\"Lightweight record of a registered MCP tool.\n   121\t\n   122\t    Mirrors the public surface of the old ``fastmcp.Tool`` object that\n   123\t    ``ken tools ...`` was reading via ``mcp._tool_manager.list_tools()``:\n   124\t    ``name``, ``description``, ``parameters`` (JSON schema), ``fn``, and\n   125\t    ``is_async``.\n   126\t    \"\"\"\n   127\t\n   128\t    name: str\n   129\t    description: str\n   130\t    fn: Callable[..., Any]\n   131\t    is_async: bool\n   132\t    parameters: dict[str, Any]\n   133\t    input_schema: dict[str, Any]\n   134\t\n   135\t\n   136\t_REGISTRY: dict[str, ToolDef] = {}\n   137\t\n   138\t\n   139\tdef _register(fn: Callable[..., Any]) -> Callable[..., Any]:\n   140\t    \"\"\"Build a ``ToolDef`` from a function and stash it in ``_REGISTRY``.\n   141\t\n   142\t    The function name becomes the tool name (callers use the\n   143\t    ``ken_foo`` convention themselves). The JSON schema is derived from\n   144\t    the function's signature — annotations become ``properties``,\n   145\t    parameters with defaults become optional, the rest required. This is\n   146\t    the same shape the SDK derives internally, so any agent that reads\n   147\t    those schemas sees the same surface either way.\n   148\t    \"\"\"\n   149\t    sig = inspect.signature(fn)\n   150\t    # Resolve string annotations (``from __future__ import annotations``\n   151\t    # makes every annotation a forward-reference string at runtime; we\n   152\t    # need the real type object to map it to a JSON schema).\n   153\t    # ``inspect.get_annotations(..., eval_str=True)`` evaluates those\n   154\t    # strings against the function's own ``__globals__``, which is what\n   155\t    # the SDK does internally to build its own tool schema.\n   156\t    try:\n   157\t        hints = inspect.get_annotations(fn, eval_str=True)\n   158\t    except Exception:\n   159\t        # Fallback for unresolvable forward refs: leave the annotation as-is.\n   160\t        hints = {}\n   161\t    properties: dict[str, Any] = {}\n   162\t    required: list[str] = []\n   163\t    for name, param in sig.parameters.items():\n   164\t        if name == \"self\":\n   165\t            continue\n   166\t        annotation = hints.get(name, param.annotation)\n   167\t        prop, has_default = _annotation_to_schema(param, annotation)\n   168\t        if prop is None:\n   169\t            continue\n   170\t        if not has_default:\n   171\t            required.append(name)\n   172\t        properties[name] = prop\n   173\t\n   174\t    schema: dict[str, Any] = {\n   175\t        \"type\": \"object\",\n   176\t        \"properties\": properties,\n   177\t    }\n   178\t    if required:\n   179\t        schema[\"required\"] = required\n   180\t\n   181\t    _REGISTRY[fn.__name__] = ToolDef(\n   182\t        name=fn.__name__,\n   183\t        description=(fn.__doc__ or \"\").strip(),\n   184\t        fn=fn,\n   185\t        is_async=inspect.iscoroutinefunction(fn),\n   186\t        parameters=schema,\n   187\t        input_schema=schema,\n   188\t    )\n   189\t    return fn\n   190\t\n     1\t\"\"\"Project health report for ken's index, memory, and daemon state.\"\"\"\n     2\t\n     3\tfrom __future__ import annotations\n     4\t\n     5\timport json\n     6\timport sys\n     7\tfrom dataclasses import dataclass\n     8\tfrom pathlib import Path\n     9\t\n    10\tfrom ken import _paths\n    11\tfrom ken.db import connect\n    12\t\n    13\t\n    14\t@dataclass(frozen=True)\n    15\tclass StatusCounts:\n    16\t    files: int\n    17\t    files_embedded: int\n    18\t    symbols: int\n    19\t    symbols_embedded: int\n    20\t    sessions: int\n    21\t    active_sessions: int\n    22\t    contexts: int\n    23\t    prompt_contexts: int\n    24\t    prompt_contexts_embedded: int\n    25\t    interactions: int\n    26\t    session_scores: int\n    27\t    findings: int\n    28\t    findings_embedded: int\n    29\t    intent_sources: int\n    30\t    intent_sources_embedded: int\n    31\t\n    32\t\n    33\tdef show_status(start: Path, *, as_json: bool = False) -> int:\n    34\t    report = status_report(start)\n    35\t    if not report[\"ok\"]:\n    36\t        if as_json:\n    37\t            print(json.dumps(report, indent=2))\n    38\t        else:\n    39\t            print(report[\"error\"], file=sys.stderr)\n    40\t            print(\"hint: `ken install .` from a project root\", file=sys.stderr)\n    41\t        return 1\n    42\t    if as_json:\n    43\t        print(json.dumps(report, indent=2))\n    44\t        return 0\n    45\t    _print_report(report)\n    46\t    return 0\n    47\t\n    48\t\n    49\tdef status_report(start: Path) -> dict:\n    50\t    \"\"\"Return a JSON-serialisable status report for humans and agents.\"\"\"\n    51\t    root = _paths.find_project_root(start.resolve())\n    52\t    if root is None:\n    53\t        return {\n    54\t            \"ok\": False,\n    55\t            \"error\": f\"no ken project found at or above {start.resolve()}\",\n    56\t        }\n    57\t\n    58\t    meta = json.loads(_paths.meta_path(root).read_text(encoding=\"utf-8\"))\n    59\t    db_p = _paths.db_path(root)\n    60\t    base = {\n    61\t        \"ok\": True,\n    62\t        \"project_root\": str(root),\n    63\t        \"project_id\": meta[\"project_id\"],\n    64\t        \"db\": {\n    65\t            \"path\": str(db_p),\n    66\t            \"size\": _human_size(db_p),\n    67\t            \"exists\": db_p.is_file(),\n    68\t        },\n    69\t    }\n    70\t\n    71\t    if not db_p.is_file():\n    72\t        return {**base, \"installed\": False}\n    73\t\n    74\t    counts = _read_counts(db_p)\n    75\t    index_health = _index_health(root, db_p)\n    76\t    return {\n    77\t        **base,\n    78\t        \"installed\": True,\n    79\t        \"counts\": counts.__dict__,\n    80\t        \"index_health\": index_health,\n    81\t        \"rank_signals\": _rank_signals(counts),\n    82\t        \"embedding_coverage\": _embedding_coverage(counts),\n    83\t        \"recommendations\": _recommendations(counts, index_health),\n    84\t        \"daemon\": _daemon_health(root),\n    85\t    }\n    86\t\n    87\t\n    88\tdef _print_report(report: dict) -> None:\n    89\t    print(f\"project_root  : {report['project_root']}\")\n    90\t    print(f\"project_id    : {report['project_id']}\")\n    91\t    print(f\"db            : {report['db']['path']}  ({report['db']['size']})\")\n    92\t    if not report.get(\"installed\"):\n    93\t        print(\"(no DB yet — run `ken install .`)\")\n    94\t        return\n    95\t    counts = report[\"counts\"]\n    96\t    print(f\"files indexed : {counts['files']} ({counts['files_embedded']} embedded)\")\n    97\t    print(f\"symbols       : {counts['symbols']} ({counts['symbols_embedded']} embedded)\")\n    98\t    print(\n    99\t        f\"sessions      : {counts['sessions']} total, {counts['active_sessions']} active, \"\n   100\t        f\"{counts['session_scores']} scored\"\n   101\t    )\n   102\t    print(\n   103\t        f\"contexts      : {counts['contexts']} \"\n   104\t        f\"({counts['prompt_contexts']} prompts, {counts['prompt_contexts_embedded']} embedded)\"\n   105\t    )\n   106\t    print(f\"interactions  : {counts['interactions']}\")\n   107\t    print(f\"findings      : {counts['findings']} ({counts['findings_embedded']} embedded)\")\n   108\t    print(\n   109\t        f\"doc intents   : {counts['intent_sources']} \"\n   110\t        f\"({counts['intent_sources_embedded']} embedded)\"\n","exit_code":0,"status":"completed"}}
