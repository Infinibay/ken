\": \"test_reinstall_cli_reinstalls_tool_and_project\",\n      \"line\": 10\n    },\n    {\n      \"kind\": \"function\",\n      \"name\": \"test_reinstall_cli_can_skip_project_install\",\n      \"line\": 40\n    },\n    {\n      \"kind\": \"function\",\n      \"name\": \"test_reinstall_cli_reports_missing_uv\",\n      \"line\": 59\n    }\n  ]\n}"}],"structured_content":null},"error":null,"status":"completed"}}
