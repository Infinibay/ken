vascript.py\nA  src/ken/parsers/kotlin.py\nA  src/ken/parsers/php.py\nA  src/ken/parsers/powershell.py\nA  src/ken/parsers/python.py\nA  src/ken/parsers/ruby.py\nA  src/ken/parsers/rust.py\nA  src/ken/parsers/sql.py\nA  src/ken/parsers/types.py\nA  src/ken/parsers/typescript.py\nA  src/ken/profile.py\nA  src/ken/ranker/__init__.py\nA  src/ken/ranker/boosts.py\nA  src/ken/ranker/channels.py\nA  src/ken/ranker/explain.py\nA  src/ken/ranker/fusion.py\nA  src/ken/ranker/merge.py\nA  src/ken/ranker/output.py\nA  src/ken/ranker/ppr.py\nA  src/ken/ranker/snapshot.py\nA  src/ken/reembed.py\nA  src/ken/schema.sql\nA  src/ken/search.py\nA  src/ken/serve.py\nA  src/ken/session_brief.py\nA  src/ken/status.py\nA  src/ken/structure.py\nA  src/ken/vectors.py\nA  tests/conftest.py\nA  tests/parsers/__init__.py\nA  tests/parsers/conftest.py\nA  tests/parsers/test_bash.py\nA  tests/parsers/test_c.py\nA  tests/parsers/test_cpp.py\nA  tests/parsers/test_csharp.py\nA  tests/parsers/test_css.py\nA  tests/parsers/test_dart.py\nA  tests/parsers/test_go.py\nA  tests/parsers/test_graphql.py\nA  tests/parsers/test_html.py\nA  tests/parsers/test_java.py\nA  tests/parsers/test_javascript.py\nA  tests/parsers/test_kotlin.py\nA  tests/parsers/test_php.py\nA  tests/parsers/test_powershell.py\nA  tests/parsers/test_python.py\nA  tests/parsers/test_ruby.py\nA  tests/parsers/test_rust.py\nA  tests/parsers/test_sql.py\nA  tests/parsers/test_typescript.py\nA  tests/ranker/conftest.py\nA  tests/ranker/test_adaptive.py\nA  tests/ranker/test_boosts.py\nA  tests/ranker/test_compatibility.py\nA  tests/ranker/test_explain.py\nA  tests/ranker/test_explicit_mentions.py\nA  tests/ranker/test_fuzzy.py\nA  tests/ranker/test_fuzzy_headroom.py\nA  tests/ranker/test_lift.py\nA  tests/ranker/test_merge.py\nA  tests/ranker/test_output.py\nA  tests/ranker/test_pattern_classification.py\nA  tests/ranker/test_ppr.py\nA  tests/ranker/test_predictive.py\nA  tests/ranker/test_rank.py\nA  tests/ranker/test_reactive.py\nA  tests/ranker/test_snapshot.py\nA  tests/test_cli_bench.py\nA  tests/test_cli_rank.py\nA  tests/test_cli_reinstall.py\nA  tests/test_codeflow_tools.py\nA  tests/test_codex_hooks_template.py\nA  tests/test_daemon_helpers.py\nA  tests/test_daemon_http_resilience.py\nA  tests/test_daemon_rank_mcp.py\nA  tests/test_daemon_state.py\nA  tests/test_db.py\nA  tests/test_doc_intent_integration.py\nA  tests/test_embedder_device.py\nA  tests/test_embedder_model.py\nA  tests/test_embedding_spaces.py\nA  tests/test_findings_graph.py\nA  tests/test_gitignore_filter.py\nA  tests/test_hook.py\nA  tests/test_hooks_template.py\nA  tests/test_index_queue.py\nA  tests/test_indexer.py\nA  tests/test_install_codex.py\nA  tests/test_install_opencode.py\nA  tests/test_mcp_schema.py\nA  tests/test_mcp_startup.py\nA  tests/test_nametokens.py\nA  tests/test_paths.py\nA  tests/test_reembed.py\nA  tests/test_search_cli.py\nA  tests/test_session_brief.py\nA  tests/test_static_head.py\nA  tests/test_status.py\nA  tests/test_stochastic_tools.py\nA  tests/test_tools_cli.py\nA  tests/test_vectors.py\nA  tests/test_vectors_daemon.py\nA  tests/test_watcher.py\nA  uv.lock\n\"\"\"Project-root discovery + canonical paths inside `.ken/`.\n\nA \"ken project\" is any directory that contains a `.ken/meta.json`. We\nfollow git's pattern: walk up from the caller's cwd until we find one,\notherwise return None.\n\nThe hook commands (`ken hook session-start`, etc.) call\n`find_project_root()` first thing so they know which DB to write to.\nThe CLI's `install` / `serve` / `status` accept an explicit path\nargument that takes precedence.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\nKEN_DIR_NAME = \".ken\"\nMETA_FILENAME = \"meta.json\"\nDB_FILENAME = \"ken.db\"\nPID_FILENAME = \"daemon.pid\"\nSOCKET_FILENAME = \"daemon.sock\"\nPORT_FILENAME = \"daemon.port\"\nLOG_FILENAME = \"daemon.log\"\n\n\ndef ken_dir(project_root: Path) -> Path:\n    return project_root / KEN_DIR_NAME\n\n\ndef meta_path(project_root: Path) -> Path:\n    return ken_dir(project_root) / META_FILENAME\n\n\ndef db_path(project_root: Path) -> Path:\n    return ken_dir(project_root) / DB_FILENAME\n\n\ndef pid_path(project_root: Path) -> Path:\n    return ken_dir(project_root) / PID_FILENAME\n\n\ndef port_path(project_root: Path) -> Path:\n    return ken_dir(project_root) / PORT_FILENAME\n\n\ndef log_path(project_root: Path) -> Path:\n    return ken_dir(project_root) / LOG_FILENAME\n\n\ndef resolve_project_path(project_root: Path, path: str | Path) -> Path:\n    \"\"\"Resolve *path* and require it to remain inside *project_root*.\n\n    Relative paths are interpreted from the project root. Absolute paths are\n    accepted when they point inside it. Resolving both sides before the\n    containment check also rejects ``..`` traversal and escapes through\n    existing symbolic links.\n    \"\"\"\n    root = project_root.expanduser().resolve()\n    supplied = Path(path).expanduser()\n    resolved = (supplied if supplied.is_absolute() else root / supplied).resolve()\n    try:\n        resolved.relative_to(root)\n    except ValueError as err:\n        raise ValueError(f\"path escapes project root: {path}\") from err\n    return resolved\n\n\ndef find_project_root(start: Path | None = None) -> Path | None:\n    \"\"\"Walk up from *start* (default cwd) looking for `.ken/meta.json`.\n\n    Returns the directory that contains `.ken/`, not the `.ken/` itself.\n    `KEN_PROJECT_ROOT` env var overrides discovery — useful for tests\n    and for hooks invoked with a wonky cwd.\n    \"\"\"\n    forced = os.environ.get(\"KEN_PROJECT_ROOT\")\n    if forced:\n        p = Path(forced).expanduser().resolve()\n        return p if meta_path(p).is_file() else None\n\n    cur = (start or Path.cwd()).resolve()\n    for parent in [cur, *cur.parents]:\n        if meta_path(parent).is_file():\n            return parent\n    return None\n\"\"\"Project root discovery + path helpers.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\nimport pytest\n\nfrom ken import _paths\n\n\ndef test_find_project_root_walks_up(tmp_path):\n    root = tmp_path / \"proj\"\n    (root / \".ken\").mkdir(parents=True)\n    (root / \".ken\" / \"meta.json\").write_text(\"{}\")\n    nested = root / \"a\" / \"b\" / \"c\"\n    nested.mkdir(parents=True)\n    found = _paths.find_project_root(start=nested)\n    assert found is not None\n    assert found.resolve() == root.resolve()\n\n\ndef test_find_project_root_returns_none_when_missing(tmp_path):\n    \"\"\"Plain temp dir with no .ken/ above it → None.\"\"\"\n    # Save & restore env to avoid bleeding into other tests.\n    saved = os.environ.pop(\"KEN_PROJECT_ROOT\", None)\n    try:\n        # Use a path that's guaranteed to not have .ken in any ancestor.\n        result = _paths.find_project_root(start=tmp_path)\n        # Walking up may eventually hit a real .ken/ on the dev machine —\n        # we only guarantee that without one it'd be None. Accept either.\n        if result is not None:\n            # If it found something, at least confirm it's a valid project root.\n            assert _paths.meta_path(result).is_file()\n    finally:\n        if saved is not None:\n            os.environ[\"KEN_PROJECT_ROOT\"] = saved\n\n\ndef test_find_project_root_respects_env_var(tmp_path, monkeypatch):\n    root = tmp_path / \"envproj\"\n    (root / \".ken\").mkdir(parents=True)\n    (root / \".ken\" / \"meta.json\").write_text(\"{}\")\n    monkeypatch.setenv(\"KEN_PROJECT_ROOT\", str(root))\n    # Even if start= points elsewhere, env var wins.\n    other = tmp_path / \"other\"\n    other.mkdir()\n    found = _paths.find_project_root(start=other)\n    assert found is not None\n    assert found.resolve() == root.resolve()\n\n\ndef test_env_var_with_invalid_path_returns_none(tmp_path, monkeypatch):\n    \"\"\"Env var pointing somewhere with no meta.json → None (not a fallback).\"\"\"\n    nowhere = tmp_path / \"nowhere\"\n    nowhere.mkdir()\n    monkeypatch.setenv(\"KEN_PROJECT_ROOT\", str(nowhere))\n    assert _paths.find_project_root() is None\n\n\ndef test_path_helpers_compose(tmp_path):\n    root = tmp_path\n    assert _paths.ken_dir(root) == root / \".ken\"\n    assert _paths.meta_path(root) == root / \".ken\" / \"meta.json\"\n    assert _paths.db_path(root) == root / \".ken\" / \"ken.db\"\n    assert _paths.port_path(root) == root / \".ken\" / \"daemon.port\"\n    assert _paths.pid_path(root) == root / \".ken\" / \"daemon.pid\"\n    assert _paths.log_path(root) == root / \".ken\" / \"daemon.log\"\n\n\n@pytest.mark.parametrize(\"absolute\", [False, True])\ndef test_resolve_project_path_accepts_internal_path(tmp_path, absolute):\n    root = tmp_path / \"project\"\n    source = root / \"src\" / \"module.py\"\n    source.parent.mkdir(parents=True)\n    source.write_text(\"\", encoding=\"utf-8\")\n\n    supplied = source if absolute else Path(\"src/module.py\")\n\n    assert _paths.resolve_project_path(root, supplied) == source.resolve()\n\n\ndef test_resolve_project_path_rejects_parent_traversal(tmp_path):\n    root = tmp_path / \"project\"\n    root.mkdir()\n\n    with pytest.raises(ValueError, match=r\"^path escapes project root: \"):\n        _paths.resolve_project_path(root, \"../outside.py\")\n\n\ndef test_resolve_project_path_rejects_absolute_external_path(tmp_path):\n    root = tmp_path / \"project\"\n    root.mkdir()\n    outside = tmp_path / \"outside.py\"\n\n    with pytest.raises(ValueError, match=r\"^path escapes project root: \"):\n        _paths.resolve_project_path(root, outside)\n\n\ndef test_resolve_project_path_rejects_symlink_escape(tmp_path):\n    root = tmp_path / \"project\"\n    root.mkdir()\n    outside = tmp_path / \"outside\"\n    outside.mkdir()\n    (root / \"linked\").symlink_to(outside, target_is_directory=True)\n\n    with pytest.raises(ValueError, match=r\"^path escapes project root: \"):\n        _paths.resolve_project_path(root, \"linked/secret.py\")\n[project]\nname = \"ken-rank\"\n# Single-sourced from src/ken/__init__.py — see [tool.hatch.version]. Keeping a\n# literal here as well is what shipped 0.5.0 and 0.7.0 with `ken --version`\n# reporting the *previous* release: two places to bump, one of them easy to miss.\ndynamic = [\"version\"]\ndescription = \"Per-project context-rank index for Claude Code, served from a local daemon.\"\nreadme = \"README.md\"\nrequires-python = \">=3.11\"\nlicense = { text = \"MIT\" }\nauthors = [{ name = \"Andres\" }]\ndependencies = [\n    \"tree-sitter>=0.25.2\",\n    \"tree-sitter-python>=0.23\",\n    \"tree-sitter-rust>=0.23\",\n    \"tree-sitter-javascript>=0.23\",\n    \"tree-sitter-typescript>=0.23\",\n    \"tree-sitter-go>=0.23\",\n    \"tree-sitter-java>=0.23\",\n    # Dart has no standalone tree-sitter wheel on PyPI; the language-pack\n    # bundles the grammar (and pins tree-sitter>=0.25.2, hence the bump above).\n    \"tree-sitter-language-pack>=1.8\",\n    \"pathspec>=0.12\",\n    \"watchfiles>=0.22\",\n    # fastembed brings ONNX Runtime + a managed all-MiniLM-L6-v2 download\n    # (~25 MB cached in ~/.cache/fastembed on first use). 384-dim, fast on\n    # CPU; same model infinidev runs in production.\n    \"fastembed>=0.5\",\n    \"numpy>=1.26\",\n    # MCP SDK — exposes ken's tools to Claude Code over stdio.\n    # Pinned to the 2.x line: 2.0 renamed ``FastMCP`` to ``MCPServer``\n    # and moved it to ``mcp.server``; 0.10.0 of ken-rank shipped with the\n    # older ``mcp>=1.0`` pin by accident, so older installs may have\n    # resolved mcp 1.x — and then the MCP server silently failed at\n    # import. ``<3`` keeps 3.x out until we verify it (the 3.x line is\n    # not yet on PyPI as of writing).\n    \"mcp>=2.0,<3\",\n]\n\n[project.optional-dependencies]\n# GPU embedding for the default (fastembed) backend. `pip install\n# ken-rank[gpu]` swaps in fastembed's GPU build (it pulls onnxruntime-gpu).\n# The embedder then auto-detects a CUDA/ROCm provider and uses it, falling\n# back to CPU when none is usable — so this extra is purely opt-in\n# acceleration and never a hard requirement. The pulled onnxruntime-gpu\n# targets a specific CUDA major; if it does not match the host's CUDA\n# runtime, ken logs a warning and stays on CPU rather than failing. Pin\n# onnxruntime-gpu yourself if you need a specific CUDA line.\n#\n# Not installable on macOS: onnxruntime-gpu publishes Linux and Windows wheels\n# only, so without the marker `pip install 'ken-rank[gpu]'` fails outright on a\n# Mac. There is nothing to offer instead — ONNX Runtime has no MPS provider, so\n# the fastembed backend stays on the CPU there (where its small models are\n# already fast). Apple Silicon GPU acceleration lives in the `torch` extra.\ngpu = [\"fastembed-gpu>=0.5; sys_platform != 'darwin'\"]\n\n# The torch backend: `pip install ken-rank[torch]` adds sentence-transformers\n# (which pulls torch) so ken can run stronger models fastembed does not ship —\n# e.g. Qwen/Qwen3-Embedding-0.6B (top of ken's retrieval benchmark) or\n# BAAI/bge-m3. Heavier install; entirely opt-in. Switch a project onto one\n# with `ken reembed --model <name>` after installing this extra. Also\n# GPU-aware: CUDA, or Apple Silicon's MPS, whichever torch sees.\n#\n# The two version floors are not cosmetic. sentence-transformers only requires\n# transformers>=4.34, but the Qwen3 architecture landed in 4.51 — below it the\n# model dies with `KeyError: 'qwen3'`, naming neither the cause nor the fix. And\n# torch below 2.9 could return silently wrong embeddings on MPS (pytorch#163597,\n# fixed in 2.9.0), so Apple Silicon gets a floor that costs Linux users nothing;\n# it is scoped to arm64 because PyPI has no torch 2.9 for Intel Macs, where MPS\n# does not exist anyway.\ntorch = [\n    \"sentence-transformers>=3.0\",\n    \"transformers>=4.51\",\n    \"torch>=2.9; sys_platform == 'darwin' and platform_machine == 'arm64'\",\n]\n\n[project.scripts]\nken = \"ken.cli:main\"\n\n[dependency-groups]\ndev = [\n    \"mypy>=1.15\",\n    \"pytest>=8.0\",\n]\n\n[build-system]\nrequires = [\"hatchling\"]\nbuild-backend = \"hatchling.build\"\n\n# The one place the version lives. hatchling reads __version__ out of this file\n# at build time, so the package metadata and what `ken --version` prints cannot\n# disagree — they are the same string.\n[tool.hatch.version]\npath = \"src/ken/__init__.py\"\n\n[tool.hatch.build.targets.wheel]\npackages = [\"src/ken\"]\n\n[tool.hatch.build.targets.sdist]\ninclude = [\"src/ken\", \"README.md\", \"LICENSE\", \"pyproject.toml\"]\n\n[tool.pytest.ini_options]\ntestpaths = [\"tests\"]\naddopts = \"-q\"\n\n[tool.mypy]\npython_version = \"3.12\"\nfiles = [\"src/ken\"]\nshow_error_codes = true\nwarn_unused_configs = true\n\n# Incremental typing gate: these existing modules have known annotation debt.\n# They remain part of mypy's import graph, while every other module — and every\n# new module — must stay clean. Remove entries as their annotations are fixed.\n[[tool.mypy.overrides]]\nmodule = [\n    \"ken.cli\",\n    \"ken.embedder.onnx_fastembed\",\n    \"ken.embedder.st_backend\",\n    \"ken.embedder.static_head\",\n    \"ken.findings_graph\",\n    \"ken.graphtools\",\n    \"ken.indexer\",\n    \"ken.mcp.server\",\n    \"ken.parsers.cpp\",\n    \"ken.parsers.dart\",\n    \"ken.parsers.php\",\n    \"ken.parsers.sql\",\n    \"ken.ranker.output\",\n    \"ken.reembed\",\n    \"ken.status\",\n    \"ken.structure\",\n    \"ken.vectors\",\n]\nignore_errors = true\nsrc/ken/_paths.py:SOCKET_FILENAME = \"daemon.sock\"\n","exit_code":1,"status":"failed"}}
