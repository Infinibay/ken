+@pytest.mark.parametrize("absolute", [False, True])
+def test_socket_path_composes_without_creating_files(tmp_path, monkeypatch, absolute):
+    monkeypatch.chdir(tmp_path)
+    root = tmp_path / "project" if absolute else Path("project")
+
+    result = _paths.socket_path(root)
+
+    assert isinstance(result, Path)
+    assert result == root / ".ken" / "daemon.sock"
+    assert result.is_absolute() == absolute
+    assert not root.exists()
+    assert not result.parent.exists()
+    assert not result.exists()
+
